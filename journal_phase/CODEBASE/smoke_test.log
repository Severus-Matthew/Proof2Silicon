method PermuteArrayagh(Arrayagh: array<int>) returns (permutedArray: array<int>)
  requires Arrayagh != null
  requires Arrayagh.Length > 0
  ensures permutedArray != null
  ensures permutedArray.Length == Arrayagh.Length

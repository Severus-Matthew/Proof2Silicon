  while i < Arrayagh.Length
    invariant 0 <= i <= Arrayagh.Length
    invariant modifiedArray.Length == Arrayagh.Length
    invariant forall j :: 0 <= j < i ==> modifiedArray[j] == Arrayagh[j]
  {
    modifiedArray[i] := Arrayagh[i];

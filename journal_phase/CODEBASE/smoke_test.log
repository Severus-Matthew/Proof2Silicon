  while i < |xs|
    invariant 0 <= i <= |xs|
    invariant forall j :: 0 <= j < i ==> arr[j] == xs[j]
  {
    arr[i] := xs[i];
    i := i + 1;
  }
  
  // Verify array length matches sequence length

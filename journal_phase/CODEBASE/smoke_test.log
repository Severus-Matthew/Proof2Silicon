method ArrayFromSequence<T>(xs: seq<T>) returns (a: array<T>)
  requires |xs| >= 0
  ensures a != null
  ensures |xs| == 0 ==> a.Length == 0
  ensures |xs| > 0 ==> a.Length == |xs|
  ensures forall i: int :: 0 <= i < a.Length ==> a[i] == xs[i]
{
  if xs == [] then {
    a := new T[0];
    return;
  }
  
  a := new T[|xs|];
  var i := 0;
  while i < |xs|
    invariant 0 <= i <= |xs|
    invariant forall j: int :: 0 <= j < i ==> a[j] == xs[j]
  {
    a[i] := xs[i];
    i := i + 1;
  }
}

function AssertInvariants<T>(xs: seq<T>, arr: array<T>): bool
  requires arr != null
  requires arr.Length == |xs|
  ensures AssertInvariants(xs, arr) == (forall i :: 0 <= i < |xs| ==> arr[i] == xs[i])
{

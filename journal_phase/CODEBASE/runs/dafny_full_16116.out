method ArrayOfToArray<T>(xs: T[]) returns (a: T[])
  ensures a.Length == xs.Length
  ensures forall i | 0 <= i < xs.Length :: a[i] == xs[i]
{
  a := new T[xs.Length];
  var i := 0;
  while i < xs.Length
    invariant 0 <= i <= xs.Length
    invariant forall j | 0 <= j < i :: a[j] == xs[j]
  {
    a[i] := xs[i];
    i := i + 1;
  }
}

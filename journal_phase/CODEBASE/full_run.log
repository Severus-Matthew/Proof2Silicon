Looking at the errors, the main issues are:

1. **Index out of range**: The code assumes array values are in range 0..99999, but this isn't guaranteed by the specification. We need a different approach.
2. **Loop invariant issues**: The invariants need to be properly maintained.

The key insight is that we can't assume values are in a specific range. Instead, we should use a different approach that doesn't rely on boolean arrays indexed by values.

Here's the corrected code:

```dafny
method RemoveElements(a: array<int>, b: array<int>) returns (r: array<int>)
    // The result length is between 0 and a.Length
    ensures 0 <= r.Length <= a.Length
    // All elements in r are unique
    ensures forall i, j :: 0 <= i < j < r.Length ==> r[i] != r[j]
    // Every element in a appears in r
    ensures forall x :: x in a[..] ==> x in r[..]
    // Every element in r appears in a
    ensures forall x :: x in r[..] ==> x in a[..]
    // No element of r appears in b
    ensures forall x :: x in r[..] ==> x !in b[..]
{
    // Handle empty input
    if a.Length == 0 {
        r := new int[0];
        return;
    }

    var count := 0;
    var temp := new int[a.Length];
    
    // First pass: collect elements from a that are not in b
    for i := 0 to a.Length
        invariant 0 <= i <= a.Length
        invariant 0 <= count <= i
        invariant forall k :: 0 <= k < count ==> temp[k] in a[..] && temp[k] !in b[..]
        invariant forall k, l :: 0 <= k < l < count ==> temp[k] != temp[l]
    {
        // Check if a[i] is not in b
        var inB := false;
        var j := 0;
        while j < b.Length && !inB
            invariant 0 <= j <= b.Length
            invariant inB ==> exists k :: 0 <= k < j && b[k] == a[i]
        {
            if b[j] == a[i] {
                inB := true;
            }
            j := j + 1;
        }
        
        if !inB {
            // Check if a[i] is already in temp
            var alreadyPresent := false;
            var k := 0;
            while k < count && !alreadyPresent
                invariant 0 <= k <= count
                invariant alreadyPresent ==> exists m :: 0 <= m < k && temp[m] == a[i]
            {
                if temp[k] == a[i] {
                    alreadyPresent := true;
                }
                k := k + 1;
            }
            
            if !alreadyPresent {
                temp[count] := a[i];
                count := count + 1;
            }
        }
    }
    
    r := new int[count];
    // Copy elements from temp to r
    for i := 0 to count
        invariant 0 <= i <= count
        invariant forall k :: 0 <= k < i ==> r[k] == temp[k]
    {
        r[i] := temp[i];
    }
    
    return;
}
```

The key changes:
1. Removed the assumption that values are in range 0..99999
2. Used a temporary array `temp` to store unique elements
3. Properly check for duplicates by scanning the temporary array
4. Fixed loop invariants to be maintainable
5. Used while loops with proper invariants instead of for loops for inner searches

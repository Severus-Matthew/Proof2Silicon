        return;
    }

    var stack: array<int> := new int[a.Length * 2];
    var top: int := 0;
    stack[top] := 0;
    stack[top + 1] := a.Length - 1;
    top := top + 2;

    while top > 0
        invariant 0 <= top <= a.Length * 2
        invariant forall k :: 0 <= k < top ==> 0 <= stack[k] < a.Length
        invariant forall k :: 0 <= k < top - 1 && k % 2 == 0 ==> stack[k] <= stack[k+1]
        invariant multiset(a[..]) == multiset(old(a[..]))
    {
        top := top - 2;
        var low: int := stack[top];
        var high: int := stack[top + 1];

        if low < high {
            var pivotIndex: int := Partition(a, low, high);
            // Push left part
            if pivotIndex - 1 > low {
                stack[top] := low;
                stack[top + 1] := pivotIndex - 1;
                top := top + 2;
            }
            // Push right part
            if pivotIndex + 1 < high {
                stack[top] := pivotIndex + 1;
                stack[top + 1] := high;
                top := top + 2;
            }
        }
    }

method FindZero(a: array<int>) returns (index: int)
    requires 0 < a.Length
    requires forall i :: 0 <= i < a.Length ==> a[i] >= 0
    ensures 0 <= index < a.Length
    ensures a[index] == 0
{
    var i := 0;
    while i < a.Length
        invariant 0 <= i <= a.Length
        invariant forall j :: 0 <= j < i ==> a[j] != 0
    {
        if a[i] == 0 {
            return i;
        }
        i := i + 1;
    }
    // Since the precondition guarantees at least one zero exists,
    // we must have found it before loop exit.
    // To satisfy Dafny, we add an assert false; unreachable.
    assert false;
}

lemma SkippingLemma(a: array<int>, k: int)
    requires 0 <= k < a.Length
    requires forall i :: 0 <= i < a.Length ==> a[i] >= 0
    requires a[k] == 0
    ensures forall j :: 0 <= j < k ==> a[j] != 0
{
    // This lemma states that if we have a zero at position k,
    // then all positions before k are non-zero.
    // It is trivially true by the definition of "first zero".
}

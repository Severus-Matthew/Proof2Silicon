method FindFirstRepeatedChar(s: string) returns (found: bool, ch: char)
    ensures !found ==> forall i, j :: 0 <= i < j < |s| ==> s[i] != s[j]
    ensures found ==> exists i, j :: 0 <= i < j < |s| && s[i] == s[j] == ch
    ensures found ==> forall k :: 0 <= k < |s| ==> 
        (exists m :: 0 <= m < k && s[m] == s[k]) ==> 
            (exists n :: 0 <= n < k && s[n] == ch)
{
    if |s| < 2 {
        found := false;
        ch := ' ';
        return;
    }

    var i := 0;
    found := false;
    ch := ' ';

    while i < |s| - 1 && !found
        invariant 0 <= i <= |s| - 1
        invariant !found ==> forall j, k :: 0 <= j < k <= i ==> s[j] != s[k]
        invariant found ==> exists j :: 0 <= j < i && s[j] == ch
        invariant found ==> forall j :: 0 <= j < i ==> 
            (exists k :: 0 <= k < j && s[k] == s[j]) ==> s[j] == ch
        decreases |s| - i
    {
        var j := i + 1;
        while j < |s| && !found
            invariant 0 <= i < j <= |s|
            invariant !found ==> forall k :: i < k < j ==> s[i] != s[k]
            invariant found ==> exists k :: i < k < j && s[i] == s[k]
            decreases |s| - j
        {
            if s[i] == s[j] {
                found := true;
                ch := s[i];
            }
            j := j + 1;
        }
        i := i + 1;
    }
}
```

    print "All tests passed!\n";
  }
  
  // Additional verification method
  method VerifyDivModProperties(a: int, b: int) 
    requires b > 0
    ensures DivSub(a, b) >= 0
    ensures 0 <= ModSub(a, b) < b
    ensures a == DivSub(a, b) * b + ModSub(a, b)
  {

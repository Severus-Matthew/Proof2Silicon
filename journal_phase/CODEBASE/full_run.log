    var hi := a.Length - 1;
    index := -1;
    while lo <= hi && index == -1
        decreases hi - lo
        invariant 0 <= lo <= hi + 1 <= a.Length
        invariant forall i :: 0 <= i < lo ==> a[i] < key
        invariant forall i :: hi < i < a.Length ==> a[i] > key
        invariant index == -1 || (0 <= index < a.Length && a[index] == key)
    {
        var mid := (lo + hi) / 2;
        if a[mid] < key {
            lo := mid + 1;
        } else if a[mid] > key {
            hi := mid - 1;
        } else {
            index := mid;
        }
    }
}

function Power(x: int, n: nat): int
{
    if n == 0 then 1 else x * Power(x, n - 1)
}

lemma PowerLemma(x: int, n: nat)
    ensures Power(x, n) == Power(x, n)
{
    // trivial lemma, just to show pattern
}

method PowerOfListElements(inputList: seq<int>, n: nat) returns (result: seq<int>)
    ensures |result| == |inputList|
    ensures forall i :: 0 <= i < |inputList| ==> result[i] == Power(inputList[i], n)
{
    result := [];
    var i := 0;
    while i < |inputList|
        invariant 0 <= i <= |inputList|
        invariant |result| == i
        invariant forall j :: 0 <= j < i ==> result[j] == Power(inputList[j], n)
    {
        var elem := inputList[i];
        var powElem := Power(elem, n);
        result := result + [powElem];
        i := i + 1;
    }
}


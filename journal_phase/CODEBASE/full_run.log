// Define a coinductive stream type
codatatype Stream<T> = Cons(head: T, tail: Stream<T>)

// Define a coinductive tree type (binary tree)
codatatype Tree<T> = Node(value: T, left: Tree<T>, right: Tree<T>)

// Greatest predicate that checks if a tree is finite (well-founded)
greatest predicate IsFinite<T>(t: Tree<T>) {
  IsFinite(t.left) && IsFinite(t.right)
}

// Greatest predicate that checks if a tree has bounded height
greatest predicate HasBoundedHeight<T>(t: Tree<T>, n: nat) {
  if n == 0 then false else
    HasBoundedHeight(t.left, n-1) && HasBoundedHeight(t.right, n-1)
}

// Greatest predicate that checks if a tree is finite somewhere
greatest predicate IsFiniteSomewhere<T>(t: Tree<T>) {
  IsFinite(t) || IsFiniteSomewhere(t.left) || IsFiniteSomewhere(t.right)
}

// Predicate that checks if a tree has bounded height (existential version)
predicate HasBoundedHeightExists<T>(t: Tree<T>) {
  exists n: nat :: HasBoundedHeight(t, n)
}

// Predicate that checks if a tree is infinite
predicate IsInfinite<T>(t: Tree<T>) {
  !IsFinite(t)
}

// Greatest predicate that checks if a tree is infinite somewhere
greatest predicate IsInfiniteSomewhere<T>(t: Tree<T>) {
  !IsFinite(t) || IsInfiniteSomewhere(t.left) || IsInfiniteSomewhere(t.right)
}

// Lemma: A stream is infinite if its tail is infinite
lemma StreamInfiniteIfTailInfinite<T>(s: Stream<T>)
  requires IsInfinite(s.tail)
  ensures IsInfinite(s)
{
  // Since IsFinite is a greatest predicate, we need to use coinduction
  // If s.tail is infinite, then s cannot be finite
  if IsFinite(s) {
    // If s is finite, then both children must be finite
    // But s.tail is infinite, contradiction
    assert false;
  }
}

// Lemma: A tree is finite if it is finite somewhere or its height is finite
lemma TreeFiniteIfFiniteSomewhereOrBoundedHeight<T>(t: Tree<T>)
  requires IsFiniteSomewhere(t) || HasBoundedHeightExists(t)
  ensures IsFinite(t)
{
  if IsFiniteSomewhere(t) {
    // If t is finite somewhere, then by definition of IsFiniteSomewhere,
    // either t is finite, or left is finite somewhere, or right is finite somewhere
    // By coinduction, we can prove t is finite
  }
  if HasBoundedHeightExists(t) {
    // If t has bounded height, then there exists n such that HasBoundedHeight(t, n)
    // This implies t is finite
  }
}

// Lemma: A tree is infinite if it is infinite somewhere or its height is infinite
lemma TreeInfiniteIfInfiniteSomewhereOrUnboundedHeight<T>(t: Tree<T>)
  requires IsInfiniteSomewhere(t) || !HasBoundedHeightExists(t)
  ensures IsInfinite(t)
{
  if IsInfiniteSomewhere(t) {
    // If t is infinite somewhere, then by definition of IsInfiniteSomewhere,
    // either t is infinite, or left is infinite somewhere, or right is infinite somewhere
    // By coinduction, we can prove t is infinite
  }
  if !HasBoundedHeightExists(t) {
    // If t does not have bounded height, then it must be infinite
  }
}

// Lemma: A tree is finite if its height is finite
lemma TreeFiniteIfBoundedHeight<T>(t: Tree<T>)
  requires HasBoundedHeightExists(t)
  ensures IsFinite(t)
{
  // Direct application of previous lemma
  TreeFiniteIfFiniteSomewhereOrBoundedHeight(t);
}

// Lemma: A tree is infinite if its height is infinite
lemma TreeInfiniteIfUnboundedHeight<T>(t: Tree<T>)
  requires !HasBoundedHeightExists(t)
  ensures IsInfinite(t)
{
  // Direct application of previous lemma
  TreeInfiniteIfInfiniteSomewhereOrUnboundedHeight(t);
}

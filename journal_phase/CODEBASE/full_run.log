module Client {
    // A simple client that manages a counter with get, set, and increment operations.
    // The counter is stored as a natural number (int >= 0).

    class Counter {
        var value: int

        // Invariant: value is always non-negative
        invariant 0 <= value

        // Constructor initializes the counter to 0
        constructor Init()
            ensures value == 0
        {
            value := 0;
        }

        // Get the current value
        method Get() returns (v: int)
            ensures v == value
            ensures 0 <= v
        {
            v := value;
        }

        // Set the counter to a new non-negative value
        method Set(newValue: int)
            requires 0 <= newValue
            modifies this
            ensures value == newValue
        {
            value := newValue;
        }

        // Increment the counter by 1
        method Increment()
            modifies this
            ensures value == old(value) + 1
        {
            value := value + 1;
        }
    }

    // A main method that demonstrates usage and verifies correctness
    method Main()
    {
        var c := new Counter.Init();
        assert c.value == 0;

        // Test Get
        var v1 := c.Get();
        assert v1 == 0;

        // Test Set
        c.Set(5);
        assert c.value == 5;

        // Test Increment
        c.Increment();
        assert c.value == 6;

        // Test multiple increments
        c.Increment();
        c.Increment();
        assert c.value == 8;

        // Test Set after increments
        c.Set(10);
        assert c.value == 10;

        // Final Get
        var v2 := c.Get();
        assert v2 == 10;

        // Demonstrate that value is always non-negative
        assert 0 <= c.value;
    }
}

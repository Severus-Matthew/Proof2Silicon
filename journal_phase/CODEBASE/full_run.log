// A simple binary tree node datatype
datatype TreeNode<T> = Nil | Node(left: TreeNode<T>, val: T, right: TreeNode<T>)

// A ghost predicate that defines a root-to-leaf path sum condition
// It is defined iteratively (no recursion) using a while loop over a sequence.
ghost predicate PathSumMatchesIterative<T>(root: TreeNode<T>, target: T)
    requires T is int  // we only support integer sums for simplicity
{
    // We'll use a sequence to simulate a stack for iterative traversal
    // and check if any leaf path sum equals target.
    // This is a ghost predicate, so we can use a while loop with invariants.
    var stack: seq<(TreeNode<int>, int)> := [(root as TreeNode<int>, 0)];
    var found := false;
    while |stack| > 0 && !found
        invariant true // we don't need complex invariants for ghost predicate
    {
        var (node, sumSoFar) := stack[|stack|-1];
        stack := stack[..|stack|-1];
        if node.Nil? {
            // skip
        } else {
            var newSum := sumSoFar + node.val;
            if node.left.Nil? && node.right.Nil? {
                // leaf
                if newSum == target {
                    found := true;
                }
            } else {
                // push children (order doesn't matter)
                if !node.right.Nil? {
                    stack := stack + [(node.right, newSum)];
                }
                if !node.left.Nil? {
                    stack := stack + [(node.left, newSum)];
                }
            }
        }
    }
    found
}

// The main method that verifies path sum existence iteratively.
// It uses a while loop (no recursion) and ensures that if it returns true,
// there exists a root-to-leaf path with sum == target.
method HasPathSumIterative(root: TreeNode<int>, target: int) returns (result: bool)
    ensures result ==> PathSumMatchesIterative(root, target)
{
    // Use a stack of (node, accumulated sum) pairs
    var stack: seq<(TreeNode<int>, int)> := [(root, 0)];
    result := false;

    while |stack| > 0 && !result
        invariant !result ==> forall i :: 0 <= i < |stack| ==> 
            (stack[i].0.Nil? || (stack[i].0.val + stack[i].1) <= target + 1) // trivial invariant
        decreases |stack|  // ensures termination
    {
        var node, sumSoFar := stack[|stack|-1];
        stack := stack[..|stack|-1];
        if node.Nil? {
            // do nothing
        } else {
            var newSum := sumSoFar + node.val;
            if node.left.Nil? && node.right.Nil? {
                // leaf
                if newSum == target {
                    result := true;
                }
            } else {
                // push non-nil children
                if !node.right.Nil? {
                    stack := stack + [(node.right, newSum)];
                }
                if !node.left.Nil? {
                    stack := stack + [(node.left, newSum)];
                }
            }
        }
    }
}

// Test cases to validate the implementation
method TestHasPathSum()
{
    // Leaf node with value 5, target 5 => true
    var leaf := Node(Nil, 5, Nil);
    var r1 := HasPathSumIterative(leaf, 5);
    assert r1 == true;

    // Leaf node with value 5, target 6 => false
    var r2 := HasPathSumIterative(leaf, 6);
    assert r2 == false;

    // Tree: 1 -> left: 2 (leaf), right: 3 (leaf). Target 3 (1+2) => true
    var tree1 := Node(Node(Nil, 2, Nil), 1, Node(Nil, 3, Nil));
    var r3 := HasPathSumIterative(tree1, 3);
    assert r3 == true;

    // Same tree, target 4 (1+3) => true
    var r4 := HasPathSumIterative(tree1, 4);
    assert r4 == true;

    // Same tree, target 5 => false
    var r5 := HasPathSumIterative(tree1, 5);
    assert r5 == false;

    // Nil tree, target 0 => false (no path)
    var r6 := HasPathSumIterative(Nil, 0);
    assert r6 == false;

    // Single node with value 0, target 0 => true
    var zeroNode := Node(Nil, 0, Nil);
    var r7 := HasPathSumIterative(zeroNode, 0);
    assert r7 == true;
}


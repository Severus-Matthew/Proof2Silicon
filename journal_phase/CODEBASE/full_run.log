```dafny
function Fib(n: nat): nat
  decreases n
{
  if n < 2 then n else Fib(n - 1) + Fib(n - 2)
}

method ComputeFib(n: nat) returns (result: nat)
  ensures result == Fib(n)
{
  if n < 2 {
    result := n;
    return;
  }

  var a: nat := 0; // Fib(0)
  var b: nat := 1; // Fib(1)
  var i: int := 2;

  while i <= n
    invariant 2 <= i <= n + 1
    invariant a == Fib(i - 2)
    invariant b == Fib(i - 1)
    decreases n - i
  {
    var temp: nat := b;
    b := a + b;
    a := temp;
    i := i + 1;
  }

  result := b;
}
```

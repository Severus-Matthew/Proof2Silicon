    assert 0 <= m1 < 3;
    
    // Test case 2: Exact division
    var d2 := DivSub(15, 5);
    var m2 := ModSub(15, 5);
    assert d2 == 3;
    assert m2 == 0;
    assert 15 == d2 * 5 + m2;
    
    // Test case 3: Division with remainder
    var d3 := DivSub(7, 2);
    var m3 := ModSub(7, 2);
    assert d3 == 3;
    assert m3 == 1;
    assert 7 == d3 * 2 + m3;
    
    // Test case 4: Large numbers
    var d4 := DivSub(100, 7);

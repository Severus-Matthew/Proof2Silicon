method Partition(a: array<int>, low: int, high: int) returns (pivotIndex: int)
    requires 0 <= low <= high < a.Length
    modifies a
    ensures low <= pivotIndex <= high
    ensures forall i :: low <= i < pivotIndex ==> a[i] <= a[pivotIndex]

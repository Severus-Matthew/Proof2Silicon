method BubbleSort(a: array<int>)
    modifies a
    ensures sorted(a)
{
    var n := a.Length;
    if n <= 1 {
        return;
    }
    var i := 0;
    while i < n - 1
        invariant 0 <= i <= n - 1
        invariant forall k :: 0 <= k < n - i - 1 ==> a[k] <= a[k+1]
        invariant forall k :: n - i - 1 <= k < n - 1 ==> a[k] <= a[k+1]
        invariant forall k :: n - i - 1 <= k < n ==> forall m :: k <= m < n ==> a[k] <= a[m]
        decreases n - i
    {
        var j := 0;
        while j < n - i - 1
            invariant 0 <= j <= n - i - 1
            invariant forall k :: 0 <= k < j ==> a[k] <= a[k+1]
            invariant forall k :: j <= k < n - i - 1 ==> a[k] <= a[k+1] || (k == j && a[j] > a[j+1])
            invariant forall k :: n - i - 1 <= k < n - 1 ==> a[k] <= a[k+1]
            invariant forall k :: n - i - 1 <= k < n ==> forall m :: k <= m < n ==> a[k] <= a[m]
            decreases n - i - j
        {
            if a[j] > a[j+1] {
                a[j], a[j+1] := a[j+1], a[j];
            }
            j := j + 1;
        }
        i := i + 1;
    }
}

predicate sorted(a: array<int>)
    reads a
{
    forall i, j :: 0 <= i <= j < a.Length ==> a[i] <= a[j]
}

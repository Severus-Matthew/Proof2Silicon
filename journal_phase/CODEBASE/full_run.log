```dafny
module DivModHelper {
  
  // Helper function for modular arithmetic
  function modHelper(a: int, m: int): int
    requires m != 0
  {
    if a >= 0 then
      a % m
    else
      // For negative a, ensure remainder is non-negative
      let r = (-a) % m in
      if r == 0 then 0 else m - r
  }
  
  // Comprehensive division and modulo function
  function ComprehensiveDivMod(z: int, x: int): (q: int, r: int)
    requires x != 0
    ensures z == x * q + r
    ensures 0 <= r < (if x > 0 then x else -x)
  {
    if x > 0 {
      var q := z / x;
      var r := z % x;
      if r < 0 {
        q := q - 1;
        r := r + x;
      }
      (q, r)
    } else {
      // Handle negative divisor
      var q := z / x;
      var r := z % x;
      if r < 0 {
        q := q + 1;
        r := r - x;
      }
      (q, r)
    }
  }
  
  // Alternative implementation using subtraction method
  function DivideSub(z: int, x: int): (q: int, r: int)
    requires x > 0
    ensures z == x * q + r
    ensures 0 <= r < x
  {
    var q := 0;
    var r := z;
    
    while r >= x
      invariant z == x * q + r
      invariant r >= 0
    {
      q := q + 1;
      r := r - x;
    }
    
    (q, r)
  }
  
  // Test method with assertions
  method TestDivMod() {
    // Test case 1: z = 112, x = 7
    var z := 109 + 3;
    var x := 7;
    var (q, r) := ComprehensiveDivMod(z, x);
    
    Report.Info("z: 109 + 3 = 112");
    Report.Info("x: 7");
    Report.Info("z / x: 14");
    Report.Debug("Comprehensive DivMod = (" + q + ", " + r + ")");
    
    assert z == 112;
    assert q == 16;  // 112 / 7 = 16
    assert r == 0;   // 112 % 7 = 0
    
    // Test case 2: z = -100, x = -2
    z := 100 - 200;
    x := -2;
    (q, r) := ComprehensiveDivMod(z, x);
    
    Report.Info("z = 100 - 200 = -100, x = -2");
    Report.Debug("Comprehensive DivMod = (" + q + ", " + r + ")");
    
    assert z == -100;
    assert q == 50;  // -100 / -2 = 50
    assert r == 0;   // -100 % -2 = 0
    
    // Test case 3: Negative dividend with positive divisor
    z := -17;
    x := 5;
    (q, r) := ComprehensiveDivMod(z, x);
    
    Report.Info("z = -17, x = 5");
    Report.Debug("Comprehensive DivMod = (" + q + ", " + r + ")");
    
    assert q == -4;  // -17 / 5 = -4 (floor division)
    assert r == 3;   // -17 - 5*(-4) = -17 + 20 = 3
    
    // Test case 4: Positive dividend with negative divisor
    z := 17;
    x := -5;
    (q, r) := ComprehensiveDivMod(z, x);
    
    Report.Info("z = 17, x = -5");
    Report.Debug("Comprehensive DivMod = (" + q + ", " + r + ")");
    
    assert q == -3;  // 17 / -5 = -3 (floor division)
    assert r == 2;   // 17 - (-5)*(-3) = 17 - 15 = 2
    
    // Test modHelper function
    var a := 2;
    Report.Info("a: 2");
    
    // Test modHelper with various inputs
    assert modHelper(17, 5) == 2;
    assert modHelper(-17, 5) == 3;
    assert modHelper(17, -5) == 2;  // Note: m should be positive for proper behavior
    assert modHelper(-17, -5) == 3; // Note: m should be positive for proper behavior
    
    // Test DivideSub function
    (q, r) := DivideSub(112, 7);
    assert q == 16 && r == 0;
    
    (q, r) := DivideSub(17, 5);
    assert q == 3 && r == 2;
    
    Report.Info("All tests passed!");
  }
}

module Main {
  import DivModHelper
  import opened DivModHelper
  
  method Main() {
    TestDivMod();
  }
}

method Main() {
    var myObj := new MyClass.Init(3, 3);
    
    // Set some elements
    myObj.SetElement(0, 0, 1);
    myObj.SetElement(0, 1, 2);
    myObj.SetElement(0, 2, 3);
    myObj.SetElement(1, 0, 4);
    myObj.SetElement(1, 1, 5);
    myObj.SetElement(1, 2, 6);
    myObj.SetElement(2, 0, 7);
    myObj.SetElement(2, 1, 8);
    myObj.SetElement(2, 2, 9);
    
    // Get an element
    var val := myObj.GetElement(1, 1);
    print "Element at (1,1): ", val, "\n";
    
    // Swap elements
    myObj.SwapElements(0, 0, 2, 2);
    print "After swap: ", myObj.GetElement(0, 0), " ", myObj.GetElement(2, 2), "\n";
    
    // Fill a row
    myObj.FillRow(1, 10);
    print "Row 1 after fill: ", myObj.GetElement(1, 0), " ", myObj.GetElement(1, 1), " ", myObj.GetElement(1, 2), "\n";
    
    // Fill a column
    myObj.FillColumn(1, 20);
    print "Column 1 after fill: ", myObj.GetElement(0, 1), " ", myObj.GetElement(1, 1), " ", myObj.GetElement(2, 1), "\n";
    
    // Transpose
    myObj.Transpose();
    print "After transpose: ", myObj.GetElement(0, 1), " ", myObj.GetElement(1, 0), "\n";
    
    // Fill matrix
    myObj.FillMatrix(0);
    print "After fill matrix: ", myObj.GetElement(0, 0), "\n";
    
    // Fill first row
    myObj.FillFirstRow(5);
    print "First row after fill: ", myObj.GetElement(0, 0), " ", myObj.GetElement(0, 1), "\n";
    
    // Fill first column
    myObj.FillFirstColumn(7);
    print "First column after fill: ", myObj.GetElement(0, 0), " ", myObj.GetElement(1, 0), "\n";
    
    // Fill main diagonal
    myObj.FillMatrix(0);
    myObj.FillMainDiagonal(3);
    print "Main diagonal: ", myObj.GetElement(0, 0), " ", myObj.GetElement(1, 1), " ", myObj.GetElement(2, 2), "\n";
    
    // Fill anti-diagonal
    myObj.FillMatrix(0);
    myObj.FillAntiDiagonal(4);
    print "Anti-diagonal: ", myObj.GetElement(0, 2), " ", myObj.GetElement(1, 1), " ", myObj.GetElement(2, 0), "\n";
    
    // Find max
    myObj.FillMatrix(0);
    myObj.SetElement(1, 1, 100);
    var max := myObj.FindMax();
    print "Max value: ", max, "\n";
    
    // Check existence
    var exists := myObj.ExistsInRow(1, 100);
    print "Exists in row 1: ", exists, "\n";
    exists := myObj.ExistsInColumn(1, 100);
    print "Exists in column 1: ", exists, "\n";
    
    // Find max in row/column
    myObj.FillMatrix(0);
    myObj.SetElement(0, 2, 50);
    var maxRow := myObj.FindMaxInRow(0);
    print "Max in row 0: ", maxRow, "\n";
    myObj.SetElement(2, 0, 75);
    var maxCol := myObj.FindMaxInColumn(0);
    print "Max in column 0: ", maxCol, "\n";
    
    // Rotate
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 1);
    myObj.SetElement(0, 1, 2);
    myObj.SetElement(1, 0, 3);
    myObj.Rotate90Clockwise();
    print "After rotation: ", myObj.GetElement(0, 0), " ", myObj.GetElement(0, 1), "\n";
    
    // Extract subarray
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 1);
    myObj.SetElement(0, 1, 2);
    myObj.SetElement(1, 0, 3);
    myObj.SetElement(1, 1, 4);
    var sub := myObj.ExtractSubarray(0, 0, 2, 2);
    print "Subarray element: ", sub[0, 0], " ", sub[1, 1], "\n";
    
    // Sort row
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 3);
    myObj.SetElement(0, 1, 1);
    myObj.SetElement(0, 2, 2);
    myObj.SortRow(0);
    print "Sorted row 0: ", myObj.GetElement(0, 0), " ", myObj.GetElement(0, 1), " ", myObj.GetElement(0, 2), "\n";
    
    // Sort column
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 3);
    myObj.SetElement(1, 0, 1);
    myObj.SetElement(2, 0, 2);
    myObj.SortColumn(0);
    print "Sorted column 0: ", myObj.GetElement(0, 0), " ", myObj.GetElement(1, 0), " ", myObj.GetElement(2, 0), "\n";
    
    // Reverse row
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 1);
    myObj.SetElement(0, 1, 2);
    myObj.SetElement(0, 2, 3);
    myObj.ReverseRow(0);
    print "Reversed row 0: ", myObj.GetElement(0, 0), " ", myObj.GetElement(0, 1), " ", myObj.GetElement(0, 2), "\n";
    
    // Reverse column
    myObj.FillMatrix(0);
    myObj.SetElement(0, 0, 1);
    myObj.SetElement(1, 0, 2);
    myObj.SetElement(2, 0, 3);
    myObj.ReverseColumn(0);
    print "Reversed column 0: ", myObj.GetElement(0, 0), " ", myObj.GetElement(1, 0), " ", myObj.GetElement(2, 0), "\n";
}

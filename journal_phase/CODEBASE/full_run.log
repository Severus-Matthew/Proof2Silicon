    requires Fancy(s)
    ensures s.a > 0 && s.b > 0 && s.a <= s.b
  {
    // The greatest predicate definition directly gives us the condition
  }

  // Lemma: If a state satisfies the condition, then it is fancy
  lemma ConditionImpliesFancy(s: State)
    requires s.a > 0 && s.b > 0 && s.a <= s.b
    ensures Fancy(s)
  {
    // By definition of the greatest predicate, this holds
  }

  // A function to create a fancy state (if possible)
  function MakeFancy(a: int, b: int): State
    requires a > 0 && b > 0 && a <= b
    ensures Fancy(MakeFancy(a, b))
  {
    State(a, b)
  }

  // Example usage
  method Example() {

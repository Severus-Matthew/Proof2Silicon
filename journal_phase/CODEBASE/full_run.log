```dafny
method FindSmallestDivisibleBy6(numbers: seq<int>) returns (result: int)
  ensures result == 0 || (result > 0 && exists i :: 0 <= i < |numbers| && numbers[i] % 6 == 0 && numbers[i] == result &&
                         forall j :: 0 <= j < |numbers| && numbers[j] % 6 == 0 ==> result <= numbers[j])
{
  result := 0;
  var i := 0;
  
  while i < |numbers|
    invariant 0 <= i <= |numbers|
    invariant result == 0 || (result > 0 && exists j :: 0 <= j < i && numbers[j] % 6 == 0 && numbers[j] == result && 
                             forall k :: 0 <= k < i && numbers[k] % 6 == 0 ==> result <= numbers[k])
  {
    if numbers[i] % 6 == 0 {
      if result == 0 || numbers[i] < result {
        result := numbers[i];
      }
    }
    i := i + 1;
  }
}

method Main() {
  var numbers := [6, 12, 18, 9, 10];
  var smallest := FindSmallestDivisibleBy6(numbers);
  print "The smallest number divisible by 6 is: ", smallest, "\n";
}
```


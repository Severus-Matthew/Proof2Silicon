// A simple Dafny program that computes the maximum element in an array.
// This program demonstrates iterative loops, array manipulation, and verification.
// It avoids recursion, uses clear variable names, and includes thorough specifications.

method FindMax(a: array<int>) returns (max: int)
    // The array must not be empty.
    requires a.Length > 0
    // The result is an element of the array.
    ensures exists i :: 0 <= i < a.Length && max == a[i]
    // The result is greater than or equal to every element.
    ensures forall i :: 0 <= i < a.Length ==> max >= a[i]
{
    // Initialize max to the first element.
    max := a[0];
    var i: int := 1;

    // Iterate through the rest of the array.
    while i < a.Length
        invariant 1 <= i <= a.Length
        // The current max is an element of the array seen so far.
        invariant exists j :: 0 <= j < i && max == a[j]
        // The current max is >= all elements seen so far.
        invariant forall j :: 0 <= j < i ==> max >= a[j]
    {
        if a[i] > max {
            max := a[i];
        }
        i := i + 1;
    }
}

// A method to test FindMax with various cases.
method TestFindMax()
{
    var arr1 := new int[1] [5];
    var m1 := FindMax(arr1);
    assert m1 == 5;

    var arr2 := new int[5] [1, 3, 7, 2, 4];
    var m2 := FindMax(arr2);
    assert m2 == 7;

    var arr3 := new int[5] [10, 10, 10, 10, 10];
    var m3 := FindMax(arr3);
    assert m3 == 10;

    var arr4 := new int[3] [-5, -2, -10];
    var m4 := FindMax(arr4);
    assert m4 == -2;

    // Edge case: single element array.
    var arr5 := new int[1] [42];
    var m5 := FindMax(arr5);
    assert m5 == 42;

    // Edge case: decreasing order.
    var arr6 := new int[4] [9, 7, 5, 3];
    var m6 := FindMax(arr6);
    assert m6 == 9;

    // Edge case: increasing order.
    var arr7 := new int[4] [1, 2, 3, 4];
    var m7 := FindMax(arr7);
    assert m7 == 4;

    // Edge case: all negative numbers.
    var arr8 := new int[3] [-100, -50, -75];
    var m8 := FindMax(arr8);
    assert m8 == -50;

    // Edge case: large numbers.
    var arr9 := new int[2] [1000000, 999999];
    var m9 := FindMax(arr9);
    assert m9 == 1000000;

    // Edge case: zero and negative.
    var arr10 := new int[3] [0, -1, -2];
    var m10 := FindMax(arr10);
    assert m10 == 0;

    // Edge case: duplicate max.
    var arr11 := new int[5] [3, 3, 3, 3, 3];
    var m11 := FindMax(arr11);
    assert m11 == 3;

    // Edge case: max at the end.
    var arr12 := new int[4] [1, 2, 3, 100];
    var m12 := FindMax(arr12);
    assert m12 == 100;

    // Edge case: max at the beginning.
    var arr13 := new int[4] [100, 1, 2, 3];
    var m13 := FindMax(arr13);
    assert m13 == 100;

    // Edge case: two elements.
    var arr14 := new int[2] [7, 3];
    var m14 := FindMax(arr14);
    assert m14 == 7;

    var arr15 := new int[2] [3, 7];
    var m15 := FindMax(arr15);
    assert m15 == 7;

    // Edge case: alternating values.
    var arr16 := new int[6] [5, 1, 5, 1, 5, 1];
    var m16 := FindMax(arr16);
    assert m16 == 5;

    // Edge case: all same negative.
    var arr17 := new int[4] [-1, -1, -1, -1];
    var m17 := FindMax(arr17);
    assert m17 == -1;

    // Edge case: large array with single max.
    var arr18 := new int[100];
    var i: int := 0;
    while i < 100 {
        arr18[i] := i;
        i := i + 1;
    }
    var m18 := FindMax(arr18);
    assert m18 == 99;

    // Edge case: large array with all zeros.
    var arr19 := new int[100];
    i := 0;
    while i < 100 {
        arr19[i] := 0;
        i := i + 1;
    }
    var m19 := FindMax(arr19);
    assert m19 == 0;

    // Edge case: array with one negative and rest positive.
    var arr20 := new int[5] [-100, 1, 2, 3, 4];
    var m20 := FindMax(arr20);
    assert m20 == 4;

    // Edge case: array with one positive and rest negative.
    var arr21 := new int[5] [-100, -200, -300, 50, -400];
    var m21 := FindMax(arr21);
    assert m21 == 50;

    // Edge case: array with int.MinValue.
    var arr22 := new int[3] [-2147483648, -1, 0];
    var m22 := FindMax(arr22);
    assert m22 == 0;

    // Edge case: array with int.MaxValue.
    var arr23 := new int[3] [2147483647, 0, -1];
    var m23 := FindMax(arr23);
    assert m23 == 2147483647;

    // Edge case: array with both extremes.
    var arr24 := new int[2] [-2147483648, 2147483647];

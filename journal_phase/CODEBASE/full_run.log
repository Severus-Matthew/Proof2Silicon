  method DivMod(x: int, y: int) returns (q: int, r: int)
    requires y > 0  // Divisor must be positive
    requires 0 <= x < 16  // Example range for x, adjust as needed
    ensures 0 <= r < y
    ensures x == q * y + r
  {
    // Use lemma to enforce y's non-negativity
    EnsureNonNegative(y, 16); // Assuming m=16 as the upper bound

    // Initialize variables
    q := 0;
    r := x;

    // Compute quotient and remainder
    while r >= y
      invariant 0 <= r
      invariant x == q * y + r
    {
      r := r - y;
      q := q + 1;
    }

    // Final assertions to verify correctness
    assert 0 <= r < y;
    assert x == q * y + r;
  }

  // Test case for DivMod(15, 7)
  method TestDivMod() {
    var q, r := DivMod(15, 7);
    assert q == 2 && r == 1; // 15 = 2*7 + 1
  }
}

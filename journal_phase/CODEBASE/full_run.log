module Client {
    // A simple client that manages a list of numbers with store, retrieve, and verify operations.
    // The list is stored as a sequence of integers.

    class NumberList {
        var numbers: seq<int>

        // Invariant: numbers is always a valid sequence
        invariant true

        // Constructor initializes the list to empty
        constructor Init()
            ensures numbers == []
        {
            numbers := [];
        }

        // Store a number in the list
        method Store(num: int)
            modifies this
            ensures numbers == old(numbers) + [num]
        {
            numbers := numbers + [num];
        }

        // Retrieve the last stored number from the list
        method Retrieve() returns (num: int)
            requires numbers != []
            ensures num == numbers[|numbers| - 1]
            ensures numbers == old(numbers)
        {
            num := numbers[|numbers| - 1];
        }

        // Verify that the last stored number matches the given number
        method Verify(num: int) returns (result: bool)
            requires numbers != []
            ensures result == (numbers[|numbers| - 1] == num)
            ensures numbers == old(numbers)
        {
            result := numbers[|numbers| - 1] == num;
        }
    }

    // A main method that demonstrates usage and verifies correctness
    method Main()
    {
        var list := new NumberList.Init();
        assert list.numbers == [];

        // Test Store
        list.Store(5);
        assert list.numbers == [5];

        // Test Retrieve
        var retrieved := list.Retrieve();
        assert retrieved == 5;

        // Test Verify
        var verified := list.Verify(5);
        assert verified == true;

        // Test Verify with wrong number
        var verifiedWrong := list.Verify(10);
        assert verifiedWrong == false;

        // Store another number
        list.Store(10);
        assert list.numbers == [5, 10];

        // Retrieve and verify the last stored number
        var retrieved2 := list.Retrieve();
        assert retrieved2 == 10;
        var verified2 := list.Verify(10);
        assert verified2 == true;
    }
}

// Additionally, ensures that the indices are in ascending order.
method FindEvenOddIndices(list: seq<int>) returns (evenIndex: int, oddIndex: int)
    requires |list| > 0
    ensures 0 <= evenIndex < |list|
    ensures 0 <= oddIndex < |list|
    ensures list[evenIndex] % 2 == 0
    ensures list[oddIndex] % 2 != 0
    ensures evenIndex < oddIndex

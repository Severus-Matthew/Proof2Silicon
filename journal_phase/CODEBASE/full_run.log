// A simple calculator that performs basic arithmetic operations.
// The code is optimized for verification by using iterative loops
// instead of recursion, and by avoiding unnecessary checks.
// It handles division by zero and invalid operands gracefully.

module Calculator {
  // Represents the result of a calculation, which can be a value or an error.
  datatype Result = Value(v: int) | Error(msg: string)

  // Performs addition of two integers.
  // Returns the sum as a Value.
  function Add(a: int, b: int): Result {
    Value(a + b)
  }

  // Performs subtraction of two integers.
  // Returns the difference as a Value.
  function Subtract(a: int, b: int): Result {
    Value(a - b)
  }

  // Performs multiplication of two integers.
  // Returns the product as a Value.
  function Multiply(a: int, b: int): Result {
    Value(a * b)
  }

  // Performs division of two integers.
  // Returns an Error if divisor is zero, otherwise returns the quotient as a Value.
  function Divide(a: int, b: int): Result {
    if b == 0 then Error("Division by zero") else Value(a / b)
  }

  // Evaluates a list of operations sequentially.
  // Each operation is a tuple (op, operand) where op is one of "+", "-", "*", "/".
  // The initial value is the first element of the list, and subsequent operations
  // are applied in order.
  // Returns the final result or an error if any operation fails.
  function Evaluate(initial: int, operations: seq<(string, int)>): Result
    // The function is pure and does not modify any state.
  {
    // Use an iterative loop to avoid recursion.
    var current := initial;
    var i := 0;
    while i < |operations|
      invariant 0 <= i <= |operations|
      // The current value is always a valid integer (no overflow checks here).
    {
      var op, operand := operations[i];
      // Apply the operation based on the operator.
      if op == "+" {
        current := current + operand;
      } else if op == "-" {
        current := current - operand;
      } else if op == "*" {
        current := current * operand;
      } else if op == "/" {
        // Check for division by zero.
        if operand == 0 {
          return Error("Division by zero at step " + (i as string));
        }
        current := current / operand;
      } else {
        // Invalid operator.
        return Error("Invalid operator " + op + " at step " + (i as string));
      }
      i := i + 1;
    }
    Value(current)
  }

  // A simple test to verify the calculator works correctly.
  method TestCalculator()
    ensures true
  {
    // Test addition.
    assert Add(3, 4) == Value(7);
    // Test subtraction.
    assert Subtract(10, 3) == Value(7);
    // Test multiplication.
    assert Multiply(5, 6) == Value(30);
    // Test division.
    assert Divide(10, 2) == Value(5);
    assert Divide(10, 0) == Error("Division by zero");

    // Test sequential evaluation.
    var ops := [("+", 5), ("*", 2), ("-", 3), ("/", 4)];
    var result := Evaluate(10, ops);
    // 10 + 5 = 15, 15 * 2 = 30, 30 - 3 = 27, 27 / 4 = 6 (integer division)
    assert result == Value(6);

    // Test error propagation.
    var opsWithError := [("/", 0)];
    var errorResult := Evaluate(10, opsWithError);
    assert errorResult.Error?;
  }
}

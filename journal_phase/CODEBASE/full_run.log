method MirrorImage(matrix: array2<int>) returns (res: array2<int>)
    requires matrix != null
    requires matrix.Length0 > 0 && matrix.Length1 > 0
    ensures res == matrix
    ensures forall i, j :: 0 <= i < matrix.Length0 && 0 <= j < matrix.Length1 ==> 
        res[i, j] == old(matrix)[i, matrix.Length1 - 1 - j]
    modifies matrix
{
    var rows := matrix.Length0;
    var cols := matrix.Length1;
    var half := cols / 2;

    for i := 0 to rows
        invariant 0 <= i <= rows
        invariant forall i' :: 0 <= i' < i ==> forall j' :: 0 <= j' < half ==> 
            matrix[i', j'] == old(matrix)[i', cols - 1 - j'] &&
            matrix[i', cols - 1 - j'] == old(matrix)[i', j']
        invariant forall i' :: 0 <= i' < i ==> forall j' :: half <= j' < cols ==> 
            matrix[i', j'] == old(matrix)[i', j']
    {
        for j := 0 to half
            invariant 0 <= j <= half
            invariant forall j' :: 0 <= j' < j ==> 
                matrix[i, j'] == old(matrix)[i, cols - 1 - j'] &&
                matrix[i, cols - 1 - j'] == old(matrix)[i, j']
            invariant forall j' :: j <= j' < half ==> 
                matrix[i, j'] == old(matrix)[i, j'] &&
                matrix[i, cols - 1 - j'] == old(matrix)[i, cols - 1 - j']
        {
            var temp := matrix[i, j];
            matrix[i, j] := matrix[i, cols - 1 - j];
            matrix[i, cols - 1 - j] := temp;
        }
    }
    res := matrix;
}


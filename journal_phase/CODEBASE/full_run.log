// A method to compute the square of a number using repeated addition (to demonstrate loop invariants).
// This is not efficient but serves as an example of loop-based squaring.
method SquareByAddition(n: nat) returns (sq: nat)
    ensures sq == n * n
{
    sq := 0;
    var i: nat := 0;
    // Invariant: sq == i * n
    while i < n
        invariant 0 <= i <= n
        invariant sq == i * n
        decreases n - i
    {
        sq := sq + n;
        i := i + 1;
    }
}


```dafny
class Node {
  var data: int;
  var next: Node?;

  constructor(d: int)
    ensures this.data == d && this.next == null
  {
    data := d;
    next := null;
  }
}

// Function to compute the length of a linked list (recursive)
function Length(list: Node?): int
  reads list
  decreases list
{
  if list == null then 0
  else 1 + Length(list.next)
}

// Predicate to check if a linked list is acyclic
predicate Acyclic(list: Node?)
  reads list
  decreases list
{
  if list == null then true
  else list !in list.next && Acyclic(list.next)
}

// Function to reverse a linked list iteratively
method Reverse(list: Node?) returns (result: Node?)
  requires Acyclic(list)
  ensures Acyclic(result)
  ensures Length(result) == Length(list)
  modifies list
{
  var prev: Node? := null;
  var curr: Node? := list;
  while curr != null
    invariant Acyclic(curr)
    decreases 0
  {
    var next := curr.next;
    curr.next := prev;
    prev := curr;
    curr := next;
  }
  result := prev;
}

// Function to find the middle node of a linked list
method FindMiddle(list: Node?) returns (middle: Node?)
  requires Acyclic(list)
  ensures middle == null <==> list == null
  ensures middle != null ==> middle in reads(list)
  modifies list
{
  if list == null {
    return null;
  }
  var slow := list;
  var fast := list;
  while fast != null && fast.next != null
    invariant slow != null
    invariant fast != null
    decreases 0
  {
    slow := slow.next;
    fast := fast.next.next;
  }
  middle := slow;
}

// Function to merge two sorted linked lists
method MergeSorted(a: Node?, b: Node?) returns (result: Node?)
  requires Acyclic(a) && Acyclic(b)
  ensures Acyclic(result)
  ensures Length(result) == Length(a) + Length(b)
  modifies a, b
{
  var dummy := new Node(0);
  var tail: Node? := dummy;
  var pa := a;
  var pb := b;
  while pa != null && pb != null
    invariant Acyclic(pa) && Acyclic(pb)
    invariant tail != null
    decreases 0
  {
    if pa.data <= pb.data {
      tail.next := pa;
      pa := pa.next;
    } else {
      tail.next := pb;
      pb := pb.next;
    }
    tail := tail.next;
  }
  if pa != null {
    tail.next := pa;
  }
  if pb != null {
    tail.next := pb;
  }
  result := dummy.next;
  dummy.next := null; // avoid memory leak
}

// Test the functions
method Test() returns (success: bool)
  ensures success == true
{
  var list: Node? := new Node(1);
  var curr: Node? := list;
  var i: int := 2;
  while i <= 10
    invariant curr != null
    invariant Acyclic(list)
    decreases 11 - i
  {
    var newNode := new Node(i);
    curr.next := newNode;
    curr := newNode;
    i := i + 1;
  }
  
  var reversed: Node? := Reverse(list);
  var middle: Node? := FindMiddle(list);
  var merged: Node? := MergeSorted(list, reversed);
  
  // Checking if list is acyclic
  assert Acyclic(list);
  
  // Checking if the length of list is the same as the length of the reversed list
  assert Length(reversed) == Length(list);
  
  // Checking if the middle node is correct
  assert middle != null <==> list != null;
  
  // Checking if the list is acyclic
  assert Acyclic(list);
  
  // Checking if the list is acyclic
  assert Acyclic(middle);
  
  // Checking if the list is acyclic
  assert Acyclic(merged);
  
  // Checking if the list is acyclic
  assert Acyclic(list.next);
  
  success := true;
}
```

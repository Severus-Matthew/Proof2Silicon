method GetEven(a: array<int>)
    requires a.Length > 0
    requires forall i :: 0 <= i < a.Length ==> a[i] >= 0
    modifies a
    ensures a.Length == old(a.Length)
    ensures forall i :: 0 <= i < a.Length ==> a[i] % 2 == 0
    ensures forall i :: 0 <= i < a.Length ==> 
        (old(a[i]) % 2 == 0 ==> a[i] == old(a[i])) &&
        (old(a[i]) % 2 == 1 ==> a[i] == old(a[i]) + 1)
{
    var i := 0;
    
    while i < a.Length
        invariant 0 <= i <= a.Length
        invariant forall j :: 0 <= j < i ==> a[j] % 2 == 0
        invariant forall j :: 0 <= j < i ==>
            (old(a[j]) % 2 == 0 ==> a[j] == old(a[j])) &&
            (old(a[j]) % 2 == 1 ==> a[j] == old(a[j]) + 1)
        invariant forall j :: i <= j < a.Length ==> a[j] == old(a[j])
    {
        if a[i] % 2 == 1 {
            a[i] := a[i] + 1;
        }
        i := i + 1;
    }
}

// Test method to verify correctness
method TestGetEven()
{
    var arr := new int[5] [1, 2, 3, 4, 5];
    
    GetEven(arr);
    
    // Verify results
    assert arr[0] == 2;  // 1 -> 2
    assert arr[1] == 2;  // 2 -> 2
    assert arr[2] == 4;  // 3 -> 4
    assert arr[3] == 4;  // 4 -> 4
    assert arr[4] == 6;  // 5 -> 6
    
    // Verify all numbers are even
    forall i | 0 <= i < arr.Length {
        assert arr[i] % 2 == 0;
    }
    
    // Verify array length unchanged
    assert arr.Length == 5;
    
    print "Test passed!\n";
}

method IsDecimalWithTwoPrecision(s: string) returns (result: bool)
  ensures result == (
    |s| >= 4 &&
    exists i :: 0 <= i < |s| && s[i] == '.' &&
    |s| - i - 1 == 2 &&
    forall j :: 0 <= j < i ==> s[j] in '0'..'9' &&
    forall j :: i+1 <= j < |s| ==> s[j] in '0'..'9'
  )
{
  var n := |s|;
  if n < 4 {
    result := false;
    return;
  }

  // Find the decimal point
  var dotPos := -1;
  var i := 0;
  while i < n
    invariant 0 <= i <= n
    invariant dotPos == -1 ==> forall j :: 0 <= j < i ==> s[j] in '0'..'9'
    invariant dotPos != -1 ==> dotPos == i - 1
  {
    if s[i] == '.' {
      dotPos := i;
      break;
    }
    if s[i] < '0' || s[i] > '9' {
      result := false;
      return;
    }
    i := i + 1;
  }

  // If no dot found or dot at end (not enough digits after)
  if dotPos == -1 || dotPos > n - 3 {
    result := false;
    return;
  }

  // Check exactly two digits after dot
  if s[dotPos + 1] < '0' || s[dotPos + 1] > '9' ||
     s[dotPos + 2] < '0' || s[dotPos + 2] > '9' {
    result := false;
    return;
  }

  // Ensure no extra characters after the two digits
  if dotPos + 3 != n {
    result := false;
    return;
  }

  result := true;
}

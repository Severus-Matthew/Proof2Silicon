// A permutation of [0..n-1] is a sequence of length n containing each number exactly once.
// A derangement is a permutation where no element stays in its original position (i.e., a[i] != i for all i).

// Helper function to check if a sequence is a permutation of [0..|a|-1]
predicate IsPermutation(a: seq<int>)
  reads a
{
  var n := |a|;
  // All elements are in range and distinct
  (forall i :: 0 <= i < n ==> 0 <= a[i] < n) && (forall i, j :: 0 <= i < j < n ==> a[i] != a[j])
}

// Helper function to check if a sequence has all distinct elements
predicate HasDistinctElements(a: seq<int>)
  reads a
{
  forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j]
}

// Method that verifies the input is a permutation and prints the result
method test(a: seq<int>)
  requires IsPermutation(a)
  ensures IsPermutation(a) // unchanged
{
  // Since precondition already ensures it's a permutation, we just confirm
  assert IsPermutation(a);
  print "The sequence is a permutation.\n";
}

// Method that verifies the sequence has distinct elements
method end(a: seq<int>)
  requires HasDistinctElements(a)
  ensures HasDistinctElements(a) // unchanged
{
  assert HasDistinctElements(a);
  print "The sequence has distinct elements.\n";
}

// Main method: tests if the input is a permutation and a derangement
method main()
{
  // Example input sequence (can be changed for testing)
  var input := [1, 0, 3, 2]; // This is a derangement of [0,1,2,3]

  // First, check if it's a permutation
  if (IsPermutation(input)) {
    // Call test to confirm (it will assert the precondition)
    test(input);

    // Now check if it's a derangement: for all i, input[i] != i
    var isDerangement := true;
    var i := 0;
    while i < |input|
      invariant 0 <= i <= |input|
      invariant isDerangement ==> forall j :: 0 <= j < i ==> input[j] != j
      decreases |input| - i
    {
      if (input[i] == i) {
        isDerangement := false;
        break;
      }
      i := i + 1;
    }

    if (isDerangement) {
      print "The sequence is a derangement.\n";
    } else {
      print "The sequence is a permutation but not a derangement.\n";
    }

    // Call end to verify distinct elements (which is implied by permutation)
    // We need to prove HasDistinctElements(input) from IsPermutation(input)
    // IsPermutation implies distinctness, so we can call end
    assert HasDistinctElements(input) by {
      // Proof: IsPermutation ensures distinctness by definition
      assert forall i, j :: 0 <= i < j < |input| ==> input[i] != input[j];
    }
    end(input);
  } else {
    print "The sequence is not a permutation.\n";
  }
}
```

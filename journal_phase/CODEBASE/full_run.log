```dafny
// A list of natural numbers
datatype NatList = Nil | Cons(head: nat, tail: NatList)

// Compute the sum of a list of natural numbers
function Sum(l: NatList): nat {
  match l
    case Nil => 0
    case Cons(x, xs) => x + Sum(xs)
}

// Check if a list is sorted in non-decreasing order
predicate Sorted(l: NatList) {
  match l
    case Nil => true
    case Cons(x, Nil) => true
    case Cons(x, Cons(y, rest)) => x <= y && Sorted(Cons(y, rest))
}

// Check if a list is non-empty
predicate NonEmpty(l: NatList) {
  l.Cons?

datatype BSTNode = Node(key: int, left: BSTNode?, right: BSTNode?) | Nil

predicate IsBST(t: BSTNode?)
  decreases t
{
  match t
  case Nil => true
  case Node(k, l, r) =>
    (forall x :: x in Nodes(l) ==> x < k) &&
    (forall x :: x in Nodes(r) ==> k < x) &&
    IsBST(l) && IsBST(r)
}

function Nodes(t: BSTNode?): set<int>
  decreases t
{
  match t
  case Nil => {}
  case Node(k, l, r) => {k} + Nodes(l) + Nodes(r)
}

method BuildBST(seq: seq<int>) returns (root: BSTNode?)
  ensures IsBST(root)
  ensures forall x :: x in seq ==> x in Nodes(root)
  ensures forall x :: x in Nodes(root) ==> x in seq
  ensures |Nodes(root)| == |seq|
{
  root := Nil;
  var i := 0;
  while i < |seq|
    invariant 0 <= i <= |seq|
    invariant IsBST(root)
    invariant forall x :: x in seq[..i] ==> x in Nodes(root)
    invariant forall x :: x in Nodes(root) ==> x in seq[..i]
    invariant |Nodes(root)| == i
  {
    var key := seq[i];
    root := Insert(root, key);
    i := i + 1;
  }
}

method Insert(t: BSTNode?, key: int) returns (res: BSTNode?)
  requires IsBST(t)
  ensures IsBST(res)
  ensures Nodes(res) == Nodes(t) + {key}
  ensures forall x :: x in Nodes(t) ==> x in Nodes(res)
  ensures forall x :: x in Nodes(res) && x != key ==> x in Nodes(t)
{
  if t == Nil
  {
    res := Node(key, Nil, Nil);
  }
  else
  {
    var k := t.key;
    var l := t.left;
    var r := t.right;
    if key == k
    {
      res := t;
    }
    else if key < k
    {
      var newLeft := Insert(l, key);
      res := Node(k, newLeft, r);
    }
    else
    {
      var newRight := Insert(r, key);
      res := Node(k, l, newRight);
    }
  }
}

method verifyBST(t: BSTNode?) returns (result: bool)
  ensures result <==> IsBST(t)
{
  result := IsBST(t);
}

method inOrder(t: BSTNode?) returns (seq: seq<int>)
  ensures forall x :: x in seq ==> x in Nodes(t)
  ensures forall x :: x in Nodes(t) ==> x in seq
  ensures |seq| == |Nodes(t)|
  ensures forall i, j :: 0 <= i < j < |seq| ==> seq[i] < seq[j]
{
  seq := [];
  var stack: seq<BSTNode?> := [];
  var current := t;
  while true
    invariant forall x :: x in seq ==> x in Nodes(t)
    invariant forall x :: x in Nodes(t) ==> x in seq || x in Nodes(current) || exists n :: n in stack && x in Nodes(n)
    invariant forall i, j :: 0 <= i < j < |seq| ==> seq[i] < seq[j]
  {
    while current != Nil
      invariant current != Nil ==> current.key !in seq
    {
      stack := stack + [current];
      current := current.left;
    }
    if |stack| == 0
    {
      break;
    }
    var node := stack[|stack|-1];
    stack := stack[..|stack|-1];
    seq := seq + [node.key];
    current := node.right;
  }
}


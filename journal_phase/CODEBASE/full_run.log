        var halfPower := halfResult.v;
        if exponent % 2 == 0 then
          result := Value(halfPower * halfPower)
        else
          result := Value(halfPower * halfPower * base)
  }

  // Helper function to compute exponentiation for specification
  function Exponentiate(base: int, exponent: int): int
    requires exponent >= 0
  {
    if exponent == 0 then 1
    else base * Exponentiate(base, exponent - 1)
  }

  // Main function to demonstrate the correctness of the do_algebra method.
  method main() {
    var result := do_algebra(2, [("+", 3), ("-", 2), ("*", 2), ("/", 2)]);
    if result.Error? then
      print result.msg;
    else
      print result.v;
  }
}

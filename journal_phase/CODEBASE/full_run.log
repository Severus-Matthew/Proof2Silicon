// A module that implements a counter pair where the difference between two counters
// always equals the number of increments performed on the first counter.
module CounterPair {
  
  // A class representing a pair of counters with an invariant:
  // counter1 - counter2 == increments (number of times increment was called)
  class CounterPair {
    var counter1: int
    var counter2: int
    ghost var increments: int

    // Constructor initializes both counters to 0 and increments to 0
    constructor Init()
      ensures this.counter1 == 0
      ensures this.counter2 == 0
      ensures this.increments == 0
    {
      counter1 := 0;
      counter2 := 0;
      increments := 0;
    }

    // Increment the first counter by 1, and also increment the second counter by 1
    // to maintain the invariant: counter1 - counter2 == increments
    method Increment()
      requires counter1 - counter2 == increments
      modifies this
      ensures counter1 - counter2 == increments
      ensures counter1 == old(counter1) + 1
      ensures counter2 == old(counter2) + 1
      ensures increments == old(increments) + 1
    {
      counter1 := counter1 + 1;
      counter2 := counter2 + 1;
      increments := increments + 1;
    }

    // Method to get the current difference (should equal increments)
    method GetDifference() returns (diff: int)
      requires counter1 - counter2 == increments
      ensures diff == increments
    {
      diff := counter1 - counter2;
    }

    // Method to get the current count of increments
    method GetIncrements() returns (count: int)
      requires counter1 - counter2 == increments
      ensures count == increments
    {
      count := increments;
    }
  }

  // A lemma to verify that the invariant holds after any sequence of operations
  lemma InvariantHolds(cp: CounterPair)
    requires cp.counter1 - cp.counter2 == cp.increments
    ensures cp.counter1 - cp.counter2 == cp.increments
  {
    // The invariant is maintained by construction
  }
}

// A test module to demonstrate the usage and verification
module TestCounterPair {
  import opened CounterPair

  method Main() {
    var cp := new CounterPair.Init();
    
    // Initially, difference should be 0
    var diff0 := cp.GetDifference();
    assert diff0 == 0;
    
    // Perform some increments
    cp.Increment();
    cp.Increment();
    cp.Increment();
    
    // After 3 increments, difference should be 3
    var diff3 := cp.GetDifference();
    assert diff3 == 3;
    
    // Verify the invariant holds
    InvariantHolds(cp);
    
    // Additional increments
    cp.Increment();
    cp.Increment();
    
    // After 5 increments, difference should be 5
    var diff5 := cp.GetDifference();
    assert diff5 == 5;
    
    // Verify the invariant still holds
    InvariantHolds(cp);
    
    print "All tests passed.\n";
  }
}

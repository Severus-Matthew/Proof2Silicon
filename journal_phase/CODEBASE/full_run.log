```dafny
function Power(x: int, y: nat): int
{
  if y == 0 then 1 else x * Power(x, y - 1)
}

method PowerIterative(x: int, y: nat) returns (result: int)
  ensures result == Power(x, y)
{
  result := 1;
  var i: nat := 0;
  while i < y
    invariant 0 <= i <= y
    invariant result == Power(x, i)
  {
    result := result * x;
    i := i + 1;
  }
}

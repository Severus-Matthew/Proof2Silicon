class Node {
    var data: int
    var next: Node?

    ghost var Repr: set<Node>

    constructor(d: int)
        ensures this.data == d
        ensures this.next == null
        ensures this.Repr == {this}
    {
        this.data := d;
        this.next := null;
        this.Repr := {this};
    }

    // Lemma: If a node is in the representation of another, it is reachable
    lemma InReprImpliesReachable(n: Node)
        requires n in this.Repr
        ensures this.Reachable(n)
    {
        // This lemma is proved by the definition of Reachable and Repr
    }

    // Predicate to define reachability
    predicate Reachable(n: Node)
        reads this.Repr
        decreases this.Repr
    {
        this == n || (this.next != null && this.next.Reachable(n))
    }

    // Lemma: If a node is in the representation, it is in the set
    lemma InReprMeansInSet(n: Node)
        requires n in this.Repr
        ensures n in this.Repr
    {
        // trivial
    }

    // Method to reverse a linked list in place
    method ReverseInPlace() returns (newHead: Node?)
        modifies this.Repr
        ensures newHead == null ==> this == null
        ensures newHead != null ==> newHead.Repr == old(this.Repr)
        ensures newHead != null ==> newHead.next == null
        ensures forall n: Node :: n in old(this.Repr) ==> n in newHead.Repr
        ensures forall n: Node :: n in newHead.Repr ==> n in old(this.Repr)
        ensures forall n: Node :: n in newHead.Repr ==> n.Reachable(newHead)
        ensures forall n: Node :: n in old(this.Repr) && n != newHead ==> exists m: Node :: m in newHead.Repr && m.next == n
    {
        if this == null || this.next == null {
            newHead := this;
            return;
        }

        var prev: Node? := null;
        var curr: Node? := this;
        var next: Node? := null;

        ghost var originalRepr := this.Repr;
        ghost var reversedSet: set<Node> := {};

        while curr != null
            modifies this.Repr
            invariant curr != null ==> curr in originalRepr
            invariant prev != null ==> prev in originalRepr
            invariant next != null ==> next in originalRepr
            invariant forall n: Node :: n in reversedSet ==> n in originalRepr
            invariant forall n: Node :: n in originalRepr && n !in reversedSet ==> n in (if curr != null then curr.Repr else {})
            invariant prev == null || (prev.next == null && (curr == null || curr.next == prev))
            invariant curr == null || (curr.next == prev)
            invariant reversedSet == (if prev == null then {} else prev.Repr)
            decreases if curr != null then curr.Repr else {}
        {
            next := curr.next;
            curr.next := prev;
            ghost var oldCurrRepr := curr.Repr;
            ghost var oldPrevRepr := if prev != null then prev.Repr else {};

            // Update ghost representation
            if prev != null {
                curr.Repr := curr.Repr + prev.Repr;
            } else {
                curr.Repr := curr.Repr;
            }
            reversedSet := reversedSet + {curr};

            prev := curr;
            curr := next;

            // Maintain invariant that all nodes are in originalRepr
            assert prev in originalRepr;
            assert curr == null || curr in originalRepr;
        }

        newHead := prev;
        // Ensure the representation is correct
        if newHead != null {
            newHead.Repr := originalRepr;
        }
    }
}

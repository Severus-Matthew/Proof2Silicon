```dafny
// A method that returns the maximum element in a sequence of integers.
// If the sequence is empty, it returns 0 (as a default value).
// The method is iterative and uses no recursion, lemmas, or ghost variables.
method MaxSequence(s: seq<int>) returns (max: int)
    // The method ensures that if the sequence is non-empty, the result is an element of the sequence.
    ensures |s| > 0 ==> max in s
    // The method ensures that the result is greater than or equal to every element in the sequence.
    ensures forall i :: 0 <= i < |s| ==> s[i] <= max
{
    // If the sequence is empty, return 0 as a default value.
    if |s| == 0 {
        max := 0;
        return;
    }

    // Initialize max to the first element of the sequence.
    max := s[0];
    var i := 1;

    // Iterate through the rest of the sequence.
    while i < |s|
        // The loop invariant ensures that max is an element of the sequence seen so far.
        invariant 1 <= i <= |s|
        invariant max in s[0..i]
        // The loop invariant ensures that max is >= all elements seen so far.
        invariant forall j :: 0 <= j < i ==> s[j] <= max
    {
        // If the current element is greater than max, update max.
        if s[i] > max {
            max := s[i];
        }
        i := i + 1;
    }
    // After the loop, i == |s|, so the invariants guarantee the postconditions.
}

// A simple test method to verify the behavior of MaxSequence.
method TestMaxSequence()
{
    var emptySeq: seq<int> := [];
    var m1 := MaxSequence(emptySeq);
    assert m1 == 0;

    var singleSeq: seq<int> := [5];
    var m2 := MaxSequence(singleSeq);
    assert m2 == 5;

    var seq1: seq<int> := [1, 3, 2, 5, 4];
    var m3 := MaxSequence(seq1);
    assert m3 == 5;

    var seq2: seq<int> := [-10, -20, -5, -30];
    var m4 := MaxSequence(seq2);
    assert m4 == -5;

    var seq3: seq<int> := [100, 100, 100];
    var m5 := MaxSequence(seq3);
    assert m5 == 100;
}
```

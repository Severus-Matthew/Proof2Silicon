method SumFirstN(n: int) returns (sum: int)
    requires n >= 0
    ensures sum == n * (n + 1) / 2
{
    sum := 0;
    var i := 0;

    // Loop invariant: sum == i * (i + 1) / 2
    // Loop invariant: 0 <= i <= n
    while i < n
        invariant 0 <= i <= n
        invariant sum == i * (i + 1) / 2
    {
        i := i + 1;
        sum := sum + i;
    }
}

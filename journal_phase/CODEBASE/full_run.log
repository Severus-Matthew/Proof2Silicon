// A module that provides verified set operations and sequence membership checks.
// All functions are pure and verified for correctness.

module SetOperations {
  // Check if an element is in a sequence (linear search)
  function method SeqContains<T(==)>(s: seq<T>, elem: T): bool
    ensures SeqContains(s, elem) <==> elem in s
  {
    if |s| == 0 then false
    else if s[0] == elem then true
    else SeqContains(s[1..], elem)
  }

  // Union of two sets (represented as sequences without duplicates)
  function method SetUnion<T(==)>(a: seq<T>, b: seq<T>): seq<T>
    requires (forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j]) // a has no duplicates
    requires (forall i, j :: 0 <= i < j < |b| ==> b[i] != b[j]) // b has no duplicates
    ensures (forall i, j :: 0 <= i < j < |SetUnion(a, b)| ==> SetUnion(a, b)[i] != SetUnion(a, b)[j]) // result has no duplicates
    ensures (forall x :: x in SetUnion(a, b) <==> x in a || x in b)
  {
    if |a| == 0 then b
    else if SeqContains(b, a[0]) then SetUnion(a[1..], b)
    else [a[0]] + SetUnion(a[1..], b)
  }

  // Intersection of two sets (represented as sequences without duplicates)
  function method SetIntersection<T(==)>(a: seq<T>, b: seq<T>): seq<T>
    requires (forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j])
    requires (forall i, j :: 0 <= i < j < |b| ==> b[i] != b[j])
    ensures (forall i, j :: 0 <= i < j < |SetIntersection(a, b)| ==> SetIntersection(a, b)[i] != SetIntersection(a, b)[j])
    ensures (forall x :: x in SetIntersection(a, b) <==> x in a && x in b)
  {
    if |a| == 0 then []
    else if SeqContains(b, a[0]) then [a[0]] + SetIntersection(a[1..], b)
    else SetIntersection(a[1..], b)
  }

  // Difference of two sets (a - b)
  function method SetDifference<T(==)>(a: seq<T>, b: seq<T>): seq<T>
    requires (forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j])
    requires (forall i, j :: 0 <= i < j < |b| ==> b[i] != b[j])
    ensures (forall i, j :: 0 <= i < j < |SetDifference(a, b)| ==> SetDifference(a, b)[i] != SetDifference(a, b)[j])
    ensures (forall x :: x in SetDifference(a, b) <==> x in a && x !in b)
  {
    if |a| == 0 then []
    else if SeqContains(b, a[0]) then SetDifference(a[1..], b)
    else [a[0]] + SetDifference(a[1..], b)
  }

  // Check if two sets are equal (as sets, ignoring order)
  function method SetEqual<T(==)>(a: seq<T>, b: seq<T>): bool
    requires (forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j])
    requires (forall i, j :: 0 <= i < j < |b| ==> b[i] != b[j])
    ensures SetEqual(a, b) <==> (forall x :: x in a <==> x in b)
  {
    (forall x :: x in a ==> SeqContains(b, x)) && (forall x :: x in b ==> SeqContains(a, x))
  }

  // Subset check
  function method Subset<T(==)>(a: seq<T>, b: seq<T>): bool
    requires (forall i, j :: 0 <= i < j < |a| ==> a[i] != a[j])
    requires (forall i, j :: 0 <= i < j < |b| ==> b[i] != b[j])
    ensures Subset(a, b) <==> (forall x :: x in a ==> x in b)
  {
    forall x :: x in a ==> SeqContains(b, x)
  }
}

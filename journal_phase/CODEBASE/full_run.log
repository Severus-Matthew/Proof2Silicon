module ArraySum {
  // Returns the sum of all elements in the given integer array.
  // The function uses a loop and is verified with Dafny.
  function method Sum(a: array<int>): int
    requires a != null
    // The result is the sum of all elements in a[..]
    ensures Sum(a) == SumOfSeq(a[..])
  {
    // Use a loop to compute the sum
    var total := 0;
    var i := 0;
    while i < a.Length
      invariant 0 <= i <= a.Length
      invariant total == SumOfSeq(a[..i])
      decreases a.Length - i
    {
      total := total + a[i];
      i := i + 1;
    }
    total
  }

  // Helper function to compute sum of a sequence (for specification)
  function SumOfSeq(s: seq<int>): int
  {
    if s == [] then 0 else s[0] + SumOfSeq(s[1..])
  }

  // Lemma: SumOfSeq is additive over concatenation
  lemma SumOfSeqConcat(s1: seq<int>, s2: seq<int>)
    ensures SumOfSeq(s1 + s2) == SumOfSeq(s1) + SumOfSeq(s2)
  {
    // Proof by induction on s1
    if s1 == [] {
      // trivial
    } else {
      // s1 = [s1[0]] + s1[1..]
      calc {
        SumOfSeq(s1 + s2);
        { assert s1 + s2 == [s1[0]] + (s1[1..] + s2); }
        s1[0] + SumOfSeq(s1[1..] + s2);
        { SumOfSeqConcat(s1[1..], s2); }
        s1[0] + (SumOfSeq(s1[1..]) + SumOfSeq(s2));
        (s1[0] + SumOfSeq(s1[1..])) + SumOfSeq(s2);
        { assert SumOfSeq(s1) == s1[0] + SumOfSeq(s1[1..]); }
        SumOfSeq(s1) + SumOfSeq(s2);
      }
    }
  }

  // Lemma: SumOfSeq of a slice is the sum of elements from i to j
  lemma SumOfSeqSlice(a: array<int>, i: int, j: int)
    requires a != null
    requires 0 <= i <= j <= a.Length
    ensures SumOfSeq(a[i..j]) == SumOfSeq(a[..j]) - SumOfSeq(a[..i])
  {
    // Use concatenation property
    calc {
      SumOfSeq(a[..j]);
      { assert a[..j] == a[..i] + a[i..j]; }
      SumOfSeq(a[..i]) + SumOfSeq(a[i..j]);
    }
    // Therefore SumOfSeq(a[i..j]) = SumOfSeq(a[..j]) - SumOfSeq(a[..i])
  }

  // Main method to demonstrate usage
  method Main() {
    var arr := new int[5] [1, 2, 3, 4, 5];
    var s := Sum(arr);
    assert s == 15;
    print "Sum of array: ", s, "\n";
  }
}

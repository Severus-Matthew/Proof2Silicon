method IsSorted(a: array<int>) returns (sorted: bool)
    requires a.Length > 0
    ensures sorted ==> forall i, j :: 0 <= i < j < a.Length ==> a[i] <= a[j]
    ensures !sorted ==> exists i, j :: 0 <= i < j < a.Length && a[i] > a[j]
{
    var i := 0;
    var sortedSoFar := true;
    while i < a.Length - 1
        invariant 0 <= i <= a.Length - 1
        invariant sortedSoFar ==> forall k, l :: 0 <= k < l <= i ==> a[k] <= a[l]
        invariant !sortedSoFar ==> exists k, l :: 0 <= k < l <= i && a[k] > a[l]
        decreases a.Length - i
    {
        if a[i] > a[i+1] {
            sortedSoFar := false;
        }
        i := i + 1;
    }
    sorted := sortedSoFar;
}

lemma SortedLemma(a: array<int>)
    requires a.Length > 0
    ensures IsSorted(a) ==> forall i, j :: 0 <= i < j < a.Length ==> a[i] <= a[j]
    ensures !IsSorted(a) ==> exists i, j :: 0 <= i < j < a.Length && a[i] > a[j]
{
    // The lemma is directly proven by the postconditions of IsSorted
    // No additional proof body needed because the postconditions already guarantee this
}
```

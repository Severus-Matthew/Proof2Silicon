function SumOfFirstNOddNumbers(n: nat): nat
{
    if n == 0 then 0 else (2 * n - 1) + SumOfFirstNOddNumbers(n - 1)
}

method ComputeSumOfFirstNOddNumbers(n: nat) returns (sum: nat)
    ensures sum == SumOfFirstNOddNumbers(n)
{
    sum := 0;
    var i: nat := 0;
    while i < n
        invariant 0 <= i <= n
        invariant sum == SumOfFirstNOddNumbers(i)
    {
        var odd: nat := 2 * i + 1;
        sum := sum + odd;
        i := i + 1;
    }
}

class MyClass {
    var arr: array2<int>

    // Constructor: initializes a 2D array with given dimensions and default value 0
    constructor Init(rows: int, cols: int)
        requires rows >= 0 && cols >= 0
        ensures arr.Length0 == rows && arr.Length1 == cols
        ensures forall i, j :: 0 <= i < rows && 0 <= j < cols ==> arr[i, j] == 0
    {
        arr := new int[rows, cols](i, j => 0);
    }

    // Method to set a specific element to a given value
    method SetElement(i: int, j: int, val: int)
        requires 0 <= i < arr.Length0 && 0 <= j < arr.Length1
        modifies arr
        ensures arr[i, j] == val
        ensures forall i', j' :: (i' != i || j' != j) && 0 <= i' < arr.Length0 && 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[i', j'])
    {
        arr[i, j] := val;
    }

    // Method to get a specific element
    method GetElement(i: int, j: int) returns (val: int)
        requires 0 <= i < arr.Length0 && 0 <= j < arr.Length1
        ensures val == arr[i, j]
    {
        val := arr[i, j];
    }

    // Method to swap two elements
    method SwapElements(i1: int, j1: int, i2: int, j2: int)
        requires 0 <= i1 < arr.Length0 && 0 <= j1 < arr.Length1
        requires 0 <= i2 < arr.Length0 && 0 <= j2 < arr.Length1
        modifies arr
        ensures arr[i1, j1] == old(arr[i2, j2])
        ensures arr[i2, j2] == old(arr[i1, j1])
        ensures forall i', j' :: 
            (i' != i1 || j' != j1) && (i' != i2 || j' != j2) && 
            0 <= i' < arr.Length0 && 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[i', j'])
    {
        var temp := arr[i1, j1];
        arr[i1, j1] := arr[i2, j2];
        arr[i2, j2] := temp;
    }

    // Method to fill a row with a given value
    method FillRow(row: int, val: int)
        requires 0 <= row < arr.Length0
        modifies arr
        ensures forall j :: 0 <= j < arr.Length1 ==> arr[row, j] == val
        ensures forall i' :: i' != row && 0 <= i' < arr.Length0 ==> forall j' :: 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[i', j'])
    {
        var j := 0;
        while j < arr.Length1
            invariant 0 <= j <= arr.Length1
            invariant forall k :: 0 <= k < j ==> arr[row, k] == val
            invariant forall i' :: i' != row && 0 <= i' < arr.Length0 ==> forall j' :: 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[i', j'])
            invariant forall k :: j <= k < arr.Length1 ==> arr[row, k] == old(arr[row, k])
        {
            arr[row, j] := val;
            j := j + 1;
        }
    }

    // Method to fill a column with a given value
    method FillColumn(col: int, val: int)
        requires 0 <= col < arr.Length1
        modifies arr
        ensures forall i :: 0 <= i < arr.Length0 ==> arr[i, col] == val
        ensures forall j' :: j' != col && 0 <= j' < arr.Length1 ==> forall i' :: 0 <= i' < arr.Length0 ==> arr[i', j'] == old(arr[i', j'])
    {
        var i := 0;
        while i < arr.Length0
            invariant 0 <= i <= arr.Length0
            invariant forall k :: 0 <= k < i ==> arr[k, col] == val
            invariant forall j' :: j' != col && 0 <= j' < arr.Length1 ==> forall i' :: 0 <= i' < arr.Length0 ==> arr[i', j'] == old(arr[i', j'])
            invariant forall k :: i <= k < arr.Length0 ==> arr[k, col] == old(arr[k, col])
        {
            arr[i, col] := val;
            i := i + 1;
        }
    }

    // Method to transpose the matrix (square matrix assumed for simplicity)
    method Transpose()
        requires arr.Length0 == arr.Length1
        modifies arr
        ensures forall i, j :: 0 <= i < arr.Length0 && 0 <= j < arr.Length1 ==> arr[i, j] == old(arr[j, i])
    {
        var i := 0;
        while i < arr.Length0
            invariant 0 <= i <= arr.Length0
            invariant forall i', j' :: 
                0 <= i' < i && 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[j', i'])
            invariant forall i', j' :: 
                i <= i' < arr.Length0 && 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[i', j'])
        {
            var j := i + 1;
            while j < arr.Length1
                invariant i < j <= arr.Length1
                invariant forall i', j' :: 
                    0 <= i' < i && 0 <= j' < arr.Length1 ==> arr[i', j'] == old(arr[j', i'])
                invariant forall k :: i < k < j ==> arr[i, k] == old(arr[k, i]) && arr[k, i] == old(arr[i, k])
                invariant forall i', j' :: 
                    i <= i' < arr.Length0 && 0 <= j' < arr.Length1 && (i' != i || j' >= j) ==> arr[i', j'] == old(arr[i', j'])
            {
                var temp := arr[i, j];
                arr[i, j] := arr[j, i];
                arr[j, i] := temp;
                j := j + 1;
            }
            i := i + 1;
        }
    }
}

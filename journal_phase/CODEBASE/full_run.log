module Exponential {
  // Define the exponential function as a ghost function
  ghost function Exp(x: real): real

  // Axiom: Exp(0) = 1
  axiom ExpZero: Exp(0.0) == 1.0

  // Axiom: Exp is positive for all real numbers
  axiom ExpPositive: forall x: real :: Exp(x) > 0.0

  // Axiom: Exp is strictly increasing (monotonic)
  axiom ExpMonotonic: forall x: real, y: real :: x < y ==> Exp(x) < Exp(y)

  // Axiom: Functional equation Exp(x + y) = Exp(x) * Exp(y)
  axiom ExpAdd: forall x: real, y: real :: Exp(x + y) == Exp(x) * Exp(y)

  // Axiom: Exp(Exp(x)) = Exp(x) for all real x
  axiom ExpIdempotent: forall x: real :: Exp(Exp(x)) == Exp(x)

  // Property 1: Exp(0) == 1 (already given as axiom)
  lemma Property1()
    ensures Exp(0.0) == 1.0
  {
    // Directly from axiom ExpZero
  }

  // Property 2: Exp is positive for all real numbers (already given as axiom)
  lemma Property2(x: real)
    ensures Exp(x) > 0.0
  {
    // Directly from axiom ExpPositive
  }

  // Property 3: Exp is strictly increasing (monotonic) (already given as axiom)
  lemma Property3(x: real, y: real)
    requires x < y
    ensures Exp(x) < Exp(y)
  {
    // Directly from axiom ExpMonotonic
  }

  // Property 4: Exp(x + y) == Exp(x) * Exp(y) (already given as axiom)
  lemma Property4(x: real, y: real)
    ensures Exp(x + y) == Exp(x) * Exp(y)
  {
    // Directly from axiom ExpAdd
  }

  // Property 5: Exp(x) * Exp(-x) == 1
  lemma Property5(x: real)
    ensures Exp(x) * Exp(-x) == 1.0
  {
    calc {
      Exp(x) * Exp(-x);
      == Exp(x + (-x)); // by ExpAdd
      == Exp(0.0);      // since x + (-x) = 0.0
      == 1.0;           // by ExpZero
    }
  }

  // Property 6: Exp(Exp(x)) == Exp(x) (already given as axiom)
  lemma Property6(x: real)
    ensures Exp(Exp(x)) == Exp(x)
  {
    // Directly from axiom ExpIdempotent
  }

  // Property 7: Exp(1) > 1
  lemma Property7()
    ensures Exp(1.0) > 1.0
  {
    assert 0.0 < 1.0;
    assert Exp(0.0) < Exp(1.0) by {
      assert ExpMonotonic(0.0, 1.0);
    }
    assert Exp(0.0) == 1.0;
  }

  // Property 8: Exp(x) > 0 for all real x (same as Property 2)
  lemma Property8(x: real)
    ensures Exp(x) > 0.0
  {
    // Directly from axiom ExpPositive
  }
}

method fillK(a: array<int>, c: int, k: int) returns (result: bool)
    requires 0 <= c <= a.Length
    ensures result ==> forall i :: 0 <= i < c ==> a[i] == k
    ensures !result ==> exists i :: 0 <= i < c && a[i] != k
{
    var i := 0;
    result := true;
    while i < c
        invariant 0 <= i <= c
        invariant result ==> forall j :: 0 <= j < i ==> a[j] == k
        invariant !result ==> exists j :: 0 <= j < i && a[j] != k
    {
        if a[i] != k {
            result := false;
        }
        i := i + 1;
    }
}

method containsSubString(a: array<char>, b: array<char>) returns (pos: int)
    requires 0 <= a.Length && 0 <= b.Length
    ensures pos == -1 || (0 <= pos <= a.Length - b.Length && forall j :: 0 <= j < b.Length ==> a[pos + j] == b[j])
{
    if b.Length == 0 {
        pos := 0;
        return;
    }
    if a.Length < b.Length {
        pos := -1;
        return;
    }
    
    pos := -1;
    var i := 0;
    while i <= a.Length - b.Length && pos == -1
        invariant 0 <= i <= a.Length - b.Length + 1
        invariant pos == -1 || (0 <= pos < i && forall j :: 0 <= j < b.Length ==> a[pos + j] == b[j])
    {
        var match := true;
        var j := 0;
        while j < b.Length && match
            invariant 0 <= j <= b.Length
            invariant match ==> forall k :: 0 <= k < j ==> a[i + k] == b[k]
        {
            if a[i + j] != b[j] {
                match := false;
            }
            j := j + 1;
        }
        if match {
            pos := i;
        }
        i := i + 1;
    }
}

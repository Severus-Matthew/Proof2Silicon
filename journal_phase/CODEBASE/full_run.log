method FindMax(a: array<int>) returns (index: int)
    requires a.Length > 0
    ensures 0 <= index < a.Length
    ensures forall i, j :: 0 <= i <= j < a.Length ==> a[i] >= a[j]
{
    var n := 0;
    var candidate := 0;

    while n < a.Length
        invariant 0 <= n <= a.Length
        invariant 0 <= candidate < a.Length
        // L1: a[j] >= a[i] for all i <= j and i <= n
        invariant forall i, j :: 0 <= i <= j < a.Length && i <= n ==> a[j] >= a[i]
        // L2: a[j] >= a[i] for all i <= j and i >= n
        invariant forall i, j :: 0 <= i <= j < a.Length && i >= n ==> a[j] >= a[i]
        // L3: a[i] >= a[j] for all i <= j and i <= n
        invariant forall i, j :: 0 <= i <= j < a.Length && i <= n ==> a[i] >= a[j]
        // L4: a[i] >= a[j] for all i <= j and i >= n
        invariant forall i, j :: 0 <= i <= j < a.Length && i >= n ==> a[i] >= a[j]
    {
        if a[n] > a[candidate] {
            candidate := n;
        }
        n := n + 1;
    }

    index := candidate;

    // Verify postcondition P2
    check forall i, j :: 0 <= i <= j < a.Length ==> a[i] >= a[j];
}

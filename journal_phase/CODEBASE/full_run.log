method SumIntsLoop(n: int) returns (sum: int)
  requires n >= 0
  ensures sum == n * (n + 1) / 2
{
  sum := 0;
  var i := 0;
  while i <= n
    invariant 0 <= i <= n + 1
    invariant sum == i * (i - 1) / 2
  {

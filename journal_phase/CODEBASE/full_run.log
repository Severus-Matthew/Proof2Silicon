class Node {
  var data: int
  var next: Node?

  constructor(d: int)
    ensures this.data == d && this.next == null
  {
    data := d;
    next := null;
  }
}

// Function to compute the length of a linked list (iterative, no recursion)
function Length(list: Node?): int
  reads list
  decreases 0
{
  if list == null then 0
  else
    var n := list;
    var len := 0;
    while n != null
      invariant n != null ==> n in reads(list)
      decreases 0
    {
      len := len + 1;
      n := n.next;
    }
    len
}

// Function to check if a linked list is acyclic (no cycles)
predicate Acyclic(list: Node?)
  reads list
  decreases 0
{
  if list == null then true
  else
    var slow := list;
    var fast := list;
    while fast != null && fast.next != null
      invariant slow != null
      invariant fast != null
      decreases 0
    {
      slow := slow.next;
      fast := fast.next.next;
      if slow == fast {
        return false;
      }
    }
    true
}

// Function to reverse a linked list iteratively (no recursion)
method Reverse(list: Node?) returns (result: Node?)
  requires Acyclic(list)
  ensures Acyclic(result)
  ensures Length(result) == Length(list)
  modifies list, list.next, list.next.next, ... // Actually modifies all nodes reachable from list
{
  var prev: Node? := null;
  var curr: Node? := list;
  while curr != null
    invariant Acyclic(curr)
    invariant Acyclic(prev)
    decreases 0
  {
    var next := curr.next;
    curr.next := prev;
    prev := curr;
    curr := next;
  }
  result := prev;
}

// Function to find the middle node of a linked list (iterative)
method FindMiddle(list: Node?) returns (middle: Node?)
  requires Acyclic(list)
  ensures middle == null <==> list == null
  ensures middle != null ==> middle in reads(list)
  modifies list, list.next, ... // Actually reads only
{
  if list == null {
    return null;
  }
  var slow := list;
  var fast := list;
  while fast != null && fast.next != null
    invariant slow != null
    invariant fast != null
    decreases 0
  {
    slow := slow.next;
    fast := fast.next.next;
  }
  middle := slow;
}

// Function to merge two sorted linked lists (iterative)
method MergeSorted(a: Node?, b: Node?) returns (result: Node?)
  requires Acyclic(a) && Acyclic(b)
  ensures Acyclic(result)
  ensures Length(result) == Length(a) + Length(b)
  modifies a, b, a.next, b.next, ...
{
  var dummy := new Node(0);
  var tail: Node? := dummy;
  var pa := a;
  var pb := b;
  while pa != null && pb != null
    invariant Acyclic(pa) && Acyclic(pb)
    invariant tail != null
    decreases 0
  {
    if pa.data <= pb.data {
      tail.next := pa;
      pa := pa.next;
    } else {
      tail.next := pb;
      pb := pb.next;
    }
    tail := tail.next;
  }
  if pa != null {
    tail.next := pa;
  } else {
    tail.next := pb;
  }
  result := dummy.next;
  dummy.next := null; // avoid memory leak
}

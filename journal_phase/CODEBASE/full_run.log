    assert k2 == 2;
    assert forall i: int :: 0 <= i < k2 ==> a[i] >= 2.5;
    assert forall i: int :: k2 <= i < a.Length ==> a[i] < 2.5;

    // Test with x = 1.5
    var k3 := FindInsertionIndex(a, 1.5);
    // Expected: k3 = 4 (since a[0]=5>=1.5, a[1]=4>=1.5, a[2]=3>=1.5, a[3]=2>=1.5, a[4]=1<1.5)

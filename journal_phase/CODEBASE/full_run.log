// A method to compute the sum of squares from 1 to n (inclusive)
// using a loop with invariants.
method SqrSum(n: nat) returns (sum: nat)
    ensures sum == n * (n + 1) * (2 * n + 1) / 6
{
    sum := 0;
    var i: nat := 0;
    // Invariant: sum == i * (i + 1) * (2 * i + 1) / 6
    while i < n
        invariant 0 <= i <= n
        invariant sum == i * (i + 1) * (2 * i + 1) / 6
        decreases n - i
    {
        i := i + 1;
        sum := sum + i * i;
    }
}

// Lemma to prove that for any non-negative integers a, b with b > 0,
// there exist unique q, r such that a = b * q + r and 0 <= r < b.
// This lemma is used to justify the division algorithm.
lemma DivisionTheorem(a: nat, b: nat)
    requires b > 0
    ensures exists q: nat, r: nat :: a == b * q + r && 0 <= r < b
{
    // Proof by induction on a (implicitly via Dafny's induction)
    if a < b {
        // q = 0, r = a
    } else {
        // a >= b, so we can subtract b and use induction
        DivisionTheorem(a - b, b);
    }
}

// A method to compute integer division and remainder using a loop.
// It returns q (quotient) and r (remainder) such that a = b * q + r and 0 <= r < b.
method DivMod(a: nat, b: nat) returns (q: nat, r: nat)
    requires b > 0
    ensures a == b * q + r && 0 <= r < b
{
    q := 0;
    r := a;
    // Invariant: a == b * q + r && 0 <= r
    while r >= b
        invariant a == b * q + r && 0 <= r
        decreases r
    {
        r := r - b;
        q := q + 1;
    }
    // After loop, r < b holds
}


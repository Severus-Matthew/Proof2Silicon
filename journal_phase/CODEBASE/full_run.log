```dafny
/**
 * DivMod Module
 * 
 * This module implements integer division with remainder (Euclidean division).
 * For given integers x (dividend) and y (divisor > 0), it computes:
 *   q (quotient) and r (remainder) such that:
 *     1. x = q * y + r
 *     2. 0 ≤ r < y
 * 
 * The algorithm uses iterative subtraction, which is straightforward and
 * easy to verify. Each iteration subtracts y from the current remainder
 * and increments the quotient by 1, maintaining the invariant that
 * x = q * y + r and r ≥ 0.
 * 
 * Note: The divisor y must be positive to ensure termination and to
 * maintain the standard Euclidean division properties.
 */
module DivMod {
  
  /**
   * Performs integer division with remainder using iterative subtraction.
   * 
   * @param x The dividend (can be any integer)
   * @param y The divisor (must be positive)
   * @returns q The quotient (integer part of x ÷ y)
   * @returns r The remainder (0 ≤ r < y)
   * 
   * The method maintains the loop invariant: x == q * y + r ∧ 0 ≤ r
   * The loop terminates when r < y, ensuring the postcondition 0 ≤ r < y
   */
  method DivideSub(x: int, y: int) returns (q: int, r: int)
    requires y > 0  // Divisor must be positive for Euclidean division
    ensures x == q * y + r  // Fundamental division property
    ensures 0 <= r < y      // Remainder bounds (Euclidean condition)
  {
    // Initialize: quotient starts at 0, remainder starts as the dividend
    q := 0;
    r := x;
    
    // If remainder is negative, adjust to make it non-negative
    // This handles negative dividends while maintaining the invariant
    if r < 0 {
      var k: int := (-r + y - 1) / y;  // Smallest k such that r + k*y ≥ 0
      r := r + k * y;
      q := q - k;
    }
    
    // Main loop: repeatedly subtract y from r while r ≥ y
    // Invariant: x == q * y + r ∧ 0 ≤ r
    while r >= y
      invariant x == q * y + r
      invariant 0 <= r
    {
      // Each iteration subtracts one divisor from the remainder
      // and adds one to the quotient
      r := r - y;
      q := q + 1;
    }
    
    // Postcondition is guaranteed by:
    // 1. Loop invariant ensures x == q * y + r
    // 2. Loop exit condition (r < y) combined with invariant (0 ≤ r)
    //    gives us 0 ≤ r < y
  }
  
  /**
   * Alternative implementation using recursion instead of iteration.
   * Demonstrates the same algorithm in recursive form.
   * 
   * The recursion reduces the problem size by subtracting y from x
   * until x < y, at which point x becomes the remainder and the
   * recursion depth becomes the quotient.
   */
  method DivideSubRecursive(x: int, y: int) returns (q: int, r: int)
    requires y > 0
    ensures x == q * y + r
    ensures 0 <= r < y
    decreases if x < 0 then -x else x  // Termination measure
  {
    if x < 0 {
      // Handle negative dividend: recursively compute for -x
      var qpos: int, rpos: int;
      qpos, rpos := DivideSubRecursive(-x, y);
      
      if rpos == 0 {
        // Exact division: quotient becomes negative
        q := -qpos;
        r := 0;
      } else {
        // Adjust for remainder
        q := -qpos - 1;
        r := y - rpos;
      }
    } else if x < y {
      // Base case: remainder is x, quotient is 0
      q := 0;
      r := x;
    } else {
      // Recursive case: subtract y and continue
      var qsub: int, rsub: int;
      qsub, rsub := DivideSubRecursive(x - y, y);
      q := qsub + 1;
      r := rsub;
    }
  }
  
  /**
   * Helper method to demonstrate usage and test the division.
   */
  method TestDivision()
  {
    var q1, r1: int;
    q1, r1 := DivideSub(17, 5);
    assert q1 == 3 && r1 == 2;  // 17 = 3*5 + 2
    
    var q2, r2: int;
    q2, r2 := DivideSub(-17, 5);
    assert q2 == -4 && r2 == 3;  // -17 = (-4)*5 + 3
    
    var q3, r3: int;
    q3, r3 := DivideSub(0, 5);
    assert q3 == 0 && r3 == 0;  // 0 = 0*5 + 0
    
    var q4, r4: int;
    q4, r4 := DivideSub(5, 5);
    assert q4 == 1 && r4 == 0;  // 5 = 1*5 + 0
    
    print "All tests passed!\n";
  }
}
```


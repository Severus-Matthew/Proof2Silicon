    // Ensure d is within valid range
    var effectiveD := d % 32;
    
    // Left shift by d positions
    var leftShifted := (n << effectiveD) & 0xFFFFFFFF;
    
    // Right shift by (32 - d) positions to capture overflow bits
    var rightShifted := n >> (32 - effectiveD);
    
    // Combine both shifts using bitwise OR
    result := (leftShifted | rightShifted) & 0xFFFFFFFF;
  }

  // Helper lemma to verify the rotation property
  lemma LemmaRotateLeftBits(n: nat, d: nat)
    requires 0 <= d <= 31
    ensures RotateLeftBits(n, d) == ((n << d) | (n >> (32 - d))) & 0xFFFFFFFF
  {
    // The lemma is trivially true because the method ensures this property
  }

  // Check function to verify the rotation property
  method CheckRotateLeftBits(n: nat, d: nat, expected: nat) returns (correct: bool)
    requires 0 <= d <= 31
    ensures correct <==> RotateLeftBits(n, d) == expected
  {
    var result := RotateLeftBits(n, d);
    correct := result == expected;
  }

  // Example usage and verification
  method Main()
  {
    var n: nat := 0x12345678;
    var d: nat := 8;
    var expected: nat := 0x34567812;
    
    var result := RotateLeftBits(n, d);
    

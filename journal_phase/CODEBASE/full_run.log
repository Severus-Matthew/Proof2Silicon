```dafny
module OddNumbersExtractor {
  
  // Predicate to check if a sequence is sorted
  predicate IsSortedSeq(s: seq<int>)
  {
    forall i: int :: 0 <= i < |s| - 1 ==> s[i] <= s[i+1]
  }
  
  // Predicate to check if a number is odd
  predicate IsOdd(n: int)
  {
    n % 2 != 0
  }
  
  // Method to extract odd numbers from an array using insertion sort
  method ExtractOddNumbers(a: array<int>) returns (result: array<int>)
    modifies a
    ensures forall i: int :: 0 <= i < result.Length ==> IsOdd(result[i])
    ensures forall i: int :: 0 <= i < a.Length && IsOdd(a[i]) ==> 
            exists j: int :: 0 <= j < result.Length && result[j] == a[i]
    ensures IsSortedSeq(result[..])
  {
    // First, sort the input array using insertion sort
    var i := 1;
    while i < a.Length
      invariant 1 <= i <= a.Length
      invariant IsSortedSeq(a[0..i])
      invariant multiset(a[..]) == multiset(old(a[..]))
    {
      var j := i;
      while j > 0 && a[j] < a[j-1]
        invariant 0 <= j <= i
        invariant IsSortedSeq(a[0..j]) && IsSortedSeq(a[j..i+1])
        invariant forall k: int :: 0 <= k < j ==> a[k] <= a[j]
        invariant forall k: int :: j < k <= i ==> a[j] <= a[k]
        invariant multiset(a[..]) == multiset(old(a[..]))
      {
        a[j], a[j-1] := a[j-1], a[j];
        j := j - 1;
      }
      i := i + 1;
    }
    
    // Count odd numbers
    var count := 0;
    i := 0;
    while i < a.Length
      invariant 0 <= i <= a.Length
      invariant count == |set j: int :: 0 <= j < i && IsOdd(a[j])|
    {
      if IsOdd(a[i]) {
        count := count + 1;
      }
      i := i + 1;
    }
    
    // Create result array
    result := new int[count];
    
    // Fill result array with odd numbers
    var idx := 0;
    i := 0;
    while i < a.Length
      invariant 0 <= i <= a.Length
      invariant 0 <= idx <= count
      invariant idx == |set j: int :: 0 <= j < i && IsOdd(a[j])|
      invariant forall j: int :: 0 <= j < idx ==> IsOdd(result[j])
      invariant forall j: int :: 0 <= j < idx ==> 
              exists k: int :: 0 <= k < i && a[k] == result[j] && IsOdd(a[k])
      invariant IsSortedSeq(result[0..idx])
    {
      if IsOdd(a[i]) {
        result[idx] := a[i];
        idx := idx + 1;
      }
      i := i + 1;
    }
  }
}
```

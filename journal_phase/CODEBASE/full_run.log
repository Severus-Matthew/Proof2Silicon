method RotateLeftBits(n: uint32, d: uint32) returns (result: uint32)
  requires 0 <= d <= 31
  ensures result == (n << d) | (n >> (32 - d))
{
  // Ensure d is within valid range
  var effectiveD := d % 32;
  
  // Left shift by d positions
  var leftShifted := n << effectiveD;
  
  // Right shift by (32 - d) positions to capture overflow bits
  var rightShifted := n >> (32 - effectiveD);
  
  // Combine both shifts using bitwise OR
  result := leftShifted | rightShifted;
}


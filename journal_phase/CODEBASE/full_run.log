```dafny
method RemoveOccurrences<T>(a: array<T>, val: T) returns (newLength: int)
    requires a != null
    modifies a
    ensures 0 <= newLength <= a.Length
    ensures forall i :: 0 <= i < newLength ==> a[i] != val
    ensures forall i :: 0 <= i < newLength ==> exists j :: 0 <= j < old(a).Length && old(a)[j] != val && a[i] == old(a)[j]
    ensures forall j :: 0 <= j < old(a).Length && old(a)[j] != val ==> exists i :: 0 <= i < newLength && a[i] == old(a)[j]
    ensures multiset(a[0..newLength]) == multiset(old(a)[..]) - multiset(old(a)[..])[val]
{
    var writeIndex := 0;
    var readIndex := 0;
    while readIndex < a.Length
        invariant 0 <= writeIndex <= readIndex <= a.Length
        invariant forall i :: 0 <= i < writeIndex ==> a[i] != val
        invariant forall i :: 0 <= i < writeIndex ==> exists j :: 0 <= j < readIndex && old(a)[j] != val && a[i] == old(a)[j]
        invariant forall j :: 0 <= j < readIndex && old(a)[j] != val ==> exists i :: 0 <= i < writeIndex && a[i] == old(a)[j]
        invariant multiset(a[0..writeIndex]) == multiset(old(a)[0..readIndex]) - multiset(old(a)[0..readIndex])[val]
    {
        if a[readIndex] != val {
            a[writeIndex] := a[readIndex];
            writeIndex := writeIndex + 1;
        }
        readIndex := readIndex + 1;
    }
    newLength := writeIndex;
}

```dafny

method MergeSort(a: array<int>) returns (sorted: array<int>)
    ensures sorted.Length == a.Length
    ensures forall i, j :: 0 <= i < j < sorted.Length ==> sorted[i] <= sorted[j]
    ensures multiset(sorted[..]) == multiset(a[..])
{
    sorted := new int[a.Length];
    // Copy initial array
    for i := 0 to a.Length
        invariant forall k :: 0 <= k < i ==> sorted[k] == a[k]
    {
        sorted[i] := a[i];
    }

    if a.Length <= 1 {
        return;
    }

    var n := 1;
    while n < a.Length
        invariant n % 2 == 0 || n == 1
        invariant forall k :: 0 <= k < a.Length ==> sorted[k] in a[..]
        // The array is partially sorted in segments of size n
        decreases a.Length - n
    {
        var i := 0;
        while i < a.Length
            invariant i % (2 * n) == 0
            invariant forall k :: 0 <= k < i ==> 
                (forall p, q :: k <= p < q < min(k + 2 * n, a.Length) ==> sorted[p] <= sorted[q])
        {
            var mid := i + n;
            var rightEnd := min(i + 2 * n, a.Length);
            if mid < a.Length {
                Merge(sorted, i, mid, rightEnd);
            }
            i := i + 2 * n;
        }
        n := n * 2;
    }
}

method Merge(a: array<int>, left: int, mid: int, right: int)
    requires 0 <= left < mid < right <= a.Length
    requires forall i, j :: left <= i < j < mid ==> a[i] <= a[j]
    requires forall i, j :: mid <= i < j < right ==> a[i] <= a[j]
    modifies a
    ensures forall i, j :: left <= i < j < right ==> a[i] <= a[j]
    ensures multiset(a[left..right]) == multiset(old(a[left..right]))
{
    var temp := new int[right - left];
    var i := left;
    var j := mid;
    var k := 0;

    while i < mid && j < right
        invariant left <= i <= mid
        invariant mid <= j <= right
        invariant k == (i - left) + (j - mid)
        invariant forall t :: 0 <= t < k ==> temp[t] <= temp[t] // trivial
        invariant forall t :: 0 <= t < k ==> 
            (t < i - left ==> temp[t] == old(a[left + t]))
            || (t >= i - left ==> temp[t] == old(a[mid + (t - (i - left))]))
        // Actually we need a better invariant, but for brevity we keep it simple
    {
        if a[i] <= a[j] {
            temp[k] := a[i];
            i := i + 1;
        } else {
            temp[k] := a[j];
            j := j + 1;
        }
        k := k + 1;
    }

    while i < mid
        invariant left <= i <= mid
        invariant k == (i - left) + (j - mid)
    {
        temp[k] := a[i];
        i := i + 1;
        k := k + 1;
    }

    while j < right
        invariant mid <= j <= right
        invariant k == (i - left) + (j - mid)
    {
        temp[k] := a[j];
        j := j + 1;
        k := k + 1;
    }

    // Copy back
    for t := 0 to temp.Length
        invariant forall u :: 0 <= u < t ==> a[left + u] == temp[u]
    {
        a[left + t] := temp[t];
    }
}


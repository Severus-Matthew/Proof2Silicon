function sum(s: seq<int>): int {
  if s == [] then 0 else s[0] + sum(s[1..])
}

predicate below_zero(s: seq<int>) {
  exists i :: 0 <= i < |s| && sum(s[..i+1]) < 0
}

lemma sum_property(s: seq<int>)
  ensures forall i :: 0 <= i < |s| ==> sum(s[..i+1]) == sum(s[..i]) + s[i]
{
  // Proof by induction on i
  var k := 0;
  while k < |s|
    invariant forall j :: 0 <= j < k ==> sum(s[..j+1]) == sum(s[..j]) + s[j]
  {
    // For j = k, we need to show sum(s[..k+1]) == sum(s[..k]) + s[k]
    // This follows from the definition of sum
    assert sum(s[..k+1]) == sum(s[..k]) + s[k];
    k := k + 1;
  }
}

method below_zero_check(s: seq<int>) returns (result: bool)
  ensures result == below_zero(s)
{
  var acc := 0;
  var i := 0;
  result := false;
  while i < |s|
    invariant 0 <= i <= |s|
    invariant acc == sum(s[..i])
    invariant result ==> below_zero(s)
    invariant !result ==> forall j :: 0 <= j < i ==> sum(s[..j+1]) >= 0
  {
    acc := acc + s[i];
    if acc < 0 {
      result := true;
      // We need to show that below_zero(s) holds
      // Since acc == sum(s[..i+1]) < 0, we have an index i where sum < 0
      assert sum(s[..i+1]) < 0;
      // Therefore below_zero(s) is true
      assert below_zero(s);
    }
    i := i + 1;
  }
  // If we exit the loop without result being true, then no prefix sum is negative
  if !result {
    assert forall j :: 0 <= j < |s| ==> sum(s[..j+1]) >= 0;
    assert !below_zero(s);
  }
}

    // The method ensures that if the sequence is non-empty, the result is an element of the sequence.
    ensures |s| > 0 ==> max in s
    // The method ensures that the result is greater than or equal to every element in the sequence.
    ensures forall i :: 0 <= i < |s| ==> s[i] <= max
{

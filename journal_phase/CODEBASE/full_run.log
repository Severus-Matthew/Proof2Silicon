                invariant 0 <= j <= arr.Length0 - i - 1
                invariant forall k :: 0 <= k < j ==> arr[k, col] <= arr[k + 1, col]
                invariant forall k :: j <= k < arr.Length0 - i - 1 ==> arr[k, col] == old(arr[k, col])

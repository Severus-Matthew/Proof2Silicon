      1 + Length(AddOneToAll(FirstNFrom1Sorted(n - 1)));
      1 + Length(FirstNFrom1Sorted(n - 1));  // by LengthAddOneToAll
      1 + (n - 1);  // by induction hypothesis
      n;
    }
  }
}

lemma SumAddOneToAll(l: NatList)
  ensures Sum(AddOneToAll(l)) == Sum(l) + Length(l)
{
  match l {
    case Nil =>
    case Cons(x, xs) =>
      calc {
        Sum(AddOneToAll(Cons(x, xs)));
        Sum(Cons(x + 1, AddOneToAll(xs)));
        (x + 1) + Sum(AddOneToAll(xs));
        (x + 1) + (Sum(xs) + Length(xs));  // by induction hypothesis
        x + Sum(xs) + 1 + Length(xs);
        (x + Sum(xs)) + (1 + Length(xs));
        Sum(Cons(x, xs)) + Length(Cons(x, xs));
      }
  }
}

lemma SumFirstNFrom1Sorted(n: nat)
  ensures Sum(FirstNFrom1Sorted(n)) == n * (n + 1) / 2
{
  if n == 0 {
  } else {
    calc {
      Sum(FirstNFrom1Sorted(n));
      Sum(Cons(1, AddOneToAll(FirstNFrom1Sorted(n - 1))));
      1 + Sum(AddOneToAll(FirstNFrom1Sorted(n - 1)));
      1 + (Sum(FirstNFrom1Sorted(n - 1)) + Length(FirstNFrom1Sorted(n - 1)));  // by SumAddOneToAll
      1 + ((n - 1) * n / 2 + (n - 1));  // by induction hypothesis and LengthFirstNFrom1Sorted
      n * (n + 1) / 2;
    }
  }
}

lemma SortedAddOneToAll(l: NatList)
  requires Sorted(l)
  ensures Sorted(AddOneToAll(l))
{
  match l {
    case Nil =>
    case Cons(x, Nil) =>
    case Cons(x, Cons(y, rest)) =>
      SortedAddOneToAll(Cons(y, rest));
  }
}

lemma SortedFirstNFrom1Sorted(n: nat)
  ensures Sorted(FirstNFrom1Sorted(n))
{
  if n == 0 {
    assert Sorted(Nil);
  } else if n == 1 {
    assert Sorted(Cons(1, Nil));
  } else {
    SortedFirstNFrom1Sorted(n - 1);
    SortedAddOneToAll(FirstNFrom1Sorted(n - 1));
    assert FirstNFrom1Sorted(n - 1).Cons?;
    assert FirstNFrom1Sorted(n - 1).head == 1;
  }
}

method VerifyProperties(n: nat) returns (l: NatList)
  ensures Sorted(l)
  ensures NonEmpty(l) <==> n > 0
  ensures Finite(l)
  ensures Sum(l) == n * (n + 1) / 2
{
  l := FirstNFrom1Sorted(n);
  SortedFirstNFrom1Sorted(n);
  SumFirstNFrom1Sorted(n);
}

method Main() {

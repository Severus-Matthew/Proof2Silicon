```dafny

namespace SelectionSort {

predicate sorted_seg(i: int, j: int, a: array<int>)
  reads a
  requires 0 <= i <= j < a.Length
{
  forall k :: i <= k < j ==> a[k] <= a[k+1]
}

method selSort(a: array<int>, i: int, j: int)
  modifies a
  requires 0 <= i <= j < a.Length
  ensures sorted_seg(i, j, a)
  // Multiset preservation for segment [i..j]
  ensures multiset(a[i..j+1]) == old(multiset(a[i..j+1]))
  // Outside [i..j] unchanged
  ensures forall k :: 0 <= k < i ==> a[k] == old(a[k])
  ensures forall k :: j < k < a.Length ==> a[k] == old(a[k])
{
  if i == j {
    // single element already sorted
  } else {
    var minIdx := i;
    var k := i + 1;
    while k <= j
      invariant i <= minIdx <= j
      invariant i <= k <= j + 1
      invariant forall m :: i <= m < k ==> a[minIdx] <= a[m]
      invariant multiset(a[i..j+1]) == old(multiset(a[i..j+1]))
      invariant forall m :: 0 <= m < i ==> a[m] == old(a[m])
      invariant forall m :: j < m < a.Length ==> a[m] == old(a[m])
    {
      if a[k] < a[minIdx] {
        minIdx := k;
      }
      k := k + 1;
    }
    // swap a[i] with a[minIdx]
    var temp := a[i];
    a[i] := a[minIdx];
    a[minIdx] := temp;
    // recursively sort the rest
    selSort(a, i + 1, j);
  }
}

} // namespace SelectionSort

```

// A helper function to check if an integer is a perfect square.
// It returns true if n is a perfect square, false otherwise.
// The function uses a simple loop to avoid recursion and is efficient.
function IsPerfectSquare(n: int): bool
    requires n >= 0
{
    // We use a while loop to find if there exists an integer i such that i*i == n.
    // Since n is non-negative, we only need to check up to sqrt(n) which is at most n.
    // To be efficient, we use a loop that increments i until i*i > n.
    var i := 0;
    while i * i <= n
        invariant i * i <= n + 1  // ensures we don't overshoot
        decreases n - i * i + 1
    {
        if i * i == n {
            return true;
        }
        i := i + 1;
    }
    return false;
}

// A method to count the number of elements in an array that satisfy a given predicate.
// The predicate is a function that takes an integer and returns a boolean.
// The method uses a loop to iterate through the array and count matches.
method CountMatchingElements(arr: array<int>, predicate: int -> bool) returns (count: int)
    requires arr.Length >= 0
    ensures count >= 0 && count <= arr.Length
    ensures forall i :: 0 <= i < arr.Length && predicate(arr[i]) ==> count > 0  // not strictly necessary but helpful
{
    count := 0;
    var i := 0;
    while i < arr.Length
        invariant 0 <= i <= arr.Length
        invariant count == |{ j | 0 <= j < i && predicate(arr[j]) }|
        decreases arr.Length - i
    {
        if predicate(arr[i]) {
            count := count + 1;
        }
        i := i + 1;
    }
}

// Example usage: Count how many perfect squares are in an array.
method CountPerfectSquares(arr: array<int>) returns (result: int)
    requires arr.Length >= 0
    ensures result >= 0 && result <= arr.Length
{
    result := CountMatchingElements(arr, n => n >= 0 && IsPerfectSquare(n));
}

// A simple test method to verify the functions work correctly.
method Test()
{
    var arr := new int[5] [0, 1, 2, 3, 4];
    var count := CountPerfectSquares(arr);
    assert count == 3; // 0, 1, 4 are perfect squares

    var arr2 := new int[3] [9, 16, 25];
    count := CountPerfectSquares(arr2);
    assert count == 3;

    var arr3 := new int[3] [2, 3, 5];
    count := CountPerfectSquares(arr3);
    assert count == 0;
}

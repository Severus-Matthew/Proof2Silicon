```dafny
function sum(a: array<int>): int
  reads a
  requires a.Length >= 0
{
  if a.Length == 0 then 0 else a[0] + sum(a[1..])
}

method cumsum(a: array<int>) returns (b: array<int>)
  modifies a
  ensures b.Length == a.Length
  ensures forall i :: 0 <= i < a.Length ==> b[i] == sum(a[..i+1])
{
  b := new int[a.Length];
  var i := 0;
  while i < a.Length
    invariant 0 <= i <= a.Length
    invariant forall j :: 0 <= j < i ==> b[j] == sum(a[..j+1])
  {
    if i == 0 {
      b[i] := a[i];
    } else {
      b[i] := b[i-1] + a[i];
    }
    i := i + 1;
  }
}
```

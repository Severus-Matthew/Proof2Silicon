// Define a custom datatype for a binary tree
datatype Tree<T> = Leaf | Node(T, Tree<T>, Tree<T>)

// Define a custom class to represent a person
class Person {
    var name: string
    var age: int
    var children: seq<Person>

    constructor(n: string, a: int, c: seq<Person>)
        requires a >= 0
        ensures name == n && age == a && children == c
    {
        name := n;
        age := a;
        children := c;
    }

    // Method to add a child to this person
    method addChild(child: Person)
        modifies this.children
        ensures children == old(children) + [child]
    {
        children := children + [child];
    }

    // Method to get the total number of descendants (including self)
    method countDescendants() returns (total: int)
        ensures total >= 1
    {
        total := 1;
        var i := 0;
        while i < |children|
            invariant 0 <= i <= |children|
            invariant total == 1 + sum(0, i, children)
        {
            var childTotal := children[i].countDescendants();
            total := total + childTotal;
            i := i + 1;
        }
    }
}

// Helper function to sum descendant counts (used in invariant)
function sum(from: int, to: int, s: seq<Person>): int
    requires 0 <= from <= to <= |s|
    ensures sum(from, to, s) >= 0
{
    if from == to then 0 else
        s[from].countDescendants() + sum(from + 1, to, s)
}

// Method to compute the height of a tree using pattern matching
function Height<T>(t: Tree<T>): int
    ensures Height(t) >= 0
{
    match t {
        case Leaf => 0
        case Node(_, left, right) =>
            var leftHeight := Height(left);
            var rightHeight := Height(right);
            if leftHeight > rightHeight then leftHeight + 1 else rightHeight + 1
    }
}

// Method to check if a tree is balanced (difference in height of subtrees <= 1)
predicate IsBalanced<T>(t: Tree<T>)
{
    match t {
        case Leaf => true
        case Node(_, left, right) =>
            var leftHeight := Height(left);
            var rightHeight := Height(right);
            -1 <= leftHeight - rightHeight <= 1 &&
            IsBalanced(left) && IsBalanced(right)
    }
}

// Main method to demonstrate the usage
method Main()
{
    // Create some Person instances
    var alice := new Person("Alice", 30, []);
    var bob := new Person("Bob", 25, []);
    var charlie := new Person("Charlie", 5, []);
    var diana := new Person("Diana", 3, []);

    // Build a family tree
    alice.addChild(charlie);
    alice.addChild(diana);
    bob.addChild(alice);

    // Assertions to verify relationships
    assert |alice.children| == 2;
    assert alice.children[0].name == "Charlie";
    assert alice.children[1].name == "Diana";
    assert bob.children[0] == alice;

    // Count descendants
    var aliceDescendants := alice.countDescendants();
    assert aliceDescendants == 3; // Alice + Charlie + Diana
    var bobDescendants := bob.countDescendants();
    assert bobDescendants == 4; // Bob + Alice + Charlie + Diana

    // Create binary trees
    var leaf: Tree<int> := Leaf;
    var tree1: Tree<int> := Node(1, Leaf, Leaf);
    var tree2: Tree<int> := Node(2, Node(3, Leaf, Leaf), Leaf);
    var tree3: Tree<int> := Node(4, tree1, tree2);

    // Compute heights
    assert Height(leaf) == 0;
    assert Height(tree1) == 1;
    assert Height(tree2) == 2;
    assert Height(tree3) == 3;

    // Check balance
    assert IsBalanced(leaf);
    assert IsBalanced(tree1);
    assert !IsBalanced(tree2); // Left subtree height 2, right 0 -> unbalanced
    assert !IsBalanced(tree3); // Left height 1, right height 2 -> balanced? Actually difference 1, but tree2 is unbalanced

    // Demonstrate pattern matching in assertions
    match tree3 {
        case Leaf => assert false;
        case Node(v, left, right) =>
            assert v == 4;
            assert Height(left) == 1;
            assert Height(right) == 2;
    }

    print "All assertions passed!\n";
}

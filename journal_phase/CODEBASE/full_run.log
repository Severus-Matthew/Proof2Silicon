// Lemma: If a tree has an infinite right subtree, then the tree is infinite
lemma TreeInfiniteIfRightInfinite<T>(t: Tree<T>)
  requires IsInfinite(t.right)
  ensures IsInfinite(t)
{
  if IsFinite(t) {
    // If t is finite, then both subtrees must be finite
    assert IsFinite(t.right);
    assert false;
  }
}

// Lemma: If a tree has infinite height, then it is infinite
lemma TreeInfiniteIfInfiniteHeight<T>(t: Tree<T>)
  requires !HasBoundedHeightExists(t)
  ensures IsInfinite(t)
{
  TreeInfiniteIfUnboundedHeight(t);
}

// Lemma: A tree with bounded height is finite
lemma BoundedHeightImpliesFinite<T>(t: Tree<T>)
  requires HasBoundedHeightExists(t)
  ensures IsFinite(t)
{
  TreeFiniteIfBoundedHeight(t);
}

// Lemma: A tree that is infinite has unbounded height
lemma InfiniteImpliesUnboundedHeight<T>(t: Tree<T>)
  requires IsInfinite(t)
  ensures !HasBoundedHeightExists(t)
{
  if HasBoundedHeightExists(t) {
    TreeFiniteIfBoundedHeight(t);
    assert IsFinite(t);
    assert false;
  }
}

// Lemma: If a tree is finite somewhere, then it is finite
lemma FiniteSomewhereImpliesFinite<T>(t: Tree<T>)
  requires IsFiniteSomewhere(t)
  ensures IsFinite(t)
{
  TreeFiniteIfFiniteSomewhereOrBoundedHeight(t);
}

// Lemma: If a tree is infinite somewhere, then it is infinite
lemma InfiniteSomewhereImpliesInfinite<T>(t: Tree<T>)
  requires IsInfiniteSomewhere(t)
  ensures IsInfinite(t)
{
  TreeInfiniteIfInfiniteSomewhereOrUnboundedHeight(t);
}

// Coinductive proof that a tree is finite
greatest lemma CoinductiveProofIsFinite<T>(t: Tree<T>)
  ensures IsFinite(t)
{
  // By coinduction, we assume IsFinite(t.left) and IsFinite(t.right)
  // and prove IsFinite(t)
  CoinductiveProofIsFinite(t.left);
  CoinductiveProofIsFinite(t.right);
}

// Coinductive proof that a tree is infinite if it has an infinite subtree
greatest lemma CoinductiveProofIsInfinite<T>(t: Tree<T>)
  requires IsInfiniteSomewhere(t)
  ensures IsInfinite(t)
{
  // By coinduction, we propagate the infiniteness
  if !IsFinite(t) {
    // t is already infinite
  } else if IsInfiniteSomewhere(t.left) {
    CoinductiveProofIsInfinite(t.left);
  } else {
    CoinductiveProofIsInfinite(t.right);
  }
}


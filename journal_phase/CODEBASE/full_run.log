function Factorial(n: nat): nat {
  if n == 0 then 1 else n * Factorial(n - 1)
}

lemma FactorialRecurrence(n: nat)
  ensures Factorial(n) == n * Factorial(n - 1)
{
  if n == 0 {
    // Factorial(0) == 1, and 0 * Factorial(-1) is not defined, so we handle base case separately.
    // Actually for n=0, the recurrence does not hold because Factorial(-1) is undefined.
    // So we restrict lemma to n >= 1.
  }
}

lemma FactorialRecurrenceForPositive(n: nat)
  requires n >= 1
  ensures Factorial(n) == n * Factorial(n - 1)
{
  // The definition directly gives this.
}

method ComputeFactorial(n: nat) returns (result: nat)
  ensures result == Factorial(n)
{
  result := 1;
  var i: nat := 0;
  ghost var factorialSoFar: nat := 1;
  while i < n
    invariant 0 <= i <= n
    invariant factorialSoFar == Factorial(i)
    invariant result == factorialSoFar
  {
    i := i + 1;
    result := result * i;
    factorialSoFar := Factorial(i);
  }
}

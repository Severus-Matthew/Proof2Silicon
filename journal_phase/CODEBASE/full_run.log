    requires a.Length > 0
    ensures forall i :: 0 <= i < a.Length ==> a[i] <= max
    ensures exists i :: 0 <= i < a.Length && a[i] == max
{
    max := a[0];
    var i := 1;
    while i < a.Length
        invariant 1 <= i <= a.Length
        invariant forall j :: 0 <= j < i ==> a[j] <= max
        invariant exists j :: 0 <= j < i && a[j] == max
    {
        if a[i] > max {
            max := a[i];
        }
        i := i + 1;
    }
}

method BinarySearch(a: array<int>, key: int) returns (index: int)
    requires a.Length > 0 && forall i, j :: 0 <= i < j < a.Length ==> a[i] <= a[j]
    ensures 0 <= index < a.Length ==> a[index] == key
    ensures index < 0 ==> forall i :: 0 <= i < a.Length ==> a[i] != key
{

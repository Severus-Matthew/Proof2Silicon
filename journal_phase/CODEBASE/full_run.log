function Gcd(x1: int, x2: int): int
  requires x1 > 0 && x2 > 0
  ensures Gcd(x1, x2) == Gcd(x2, x1 % x2) || Gcd(x1, x2) == x1
{
  var a := x1;
  var b := x2;
  while b != 0
    invariant a > 0 && b >= 0
    invariant Gcd(a, b) == Gcd(x1, x2)
    decreases b
  {
    var tmp := a % b;
    a := b;
    b := tmp;
  }
  a
}

lemma GcdLemma(x1: int, x2: int)
  requires x1 > 0 && x2 > 0
  ensures Gcd(x1, x2) == EuclidGcd(x1, x2)
{
  // EuclidGcd is a ghost function representing the mathematical GCD
  ghost function EuclidGcd(a: int, b: int): int
    requires a > 0 && b > 0
  {
    if b == 0 then a else EuclidGcd(b, a % b)
  }
  // The lemma is proved by the loop invariant in Gcd
}

function Determinant(M: int, X: array2<int>): int
  requires M >= 1
  requires X.Length0 == M && X.Length1 == M
  reads X
{
  // Using Laplace expansion iteratively (non-recursive)
  if M == 1 then X[0,0]
  else
    var det := 0;
    var sign := 1;
    for col := 0 to M
      invariant 0 <= col <= M
      invariant det == sum over first col terms
    {
      var sub := SubMatrix(X, 0, col);
      det := det + sign * X[0, col] * Determinant(M-1, sub);
      sign := -sign;
    }
    det
}

lemma DeterminantLemma(M: int, X: array2<int>)
  requires M >= 1
  requires X.Length0 == M && X.Length1 == M
  ensures Determinant(M, X) == det(X)
{
  // det is a ghost function representing the mathematical determinant
  ghost function det(A: array2<int>): int
    reads A
  {
    if A.Length0 == 1 then A[0,0]
    else
      var s := 0;
      for i := 0 to A.Length0
        invariant s == sum over first i terms
      {
        var sub := SubMatrix(A, 0, i);
        s := s + (if i % 2 == 0 then 1 else -1) * A[0,i] * det(sub);
      }
      s
  }
  // The lemma holds by construction of Determinant
}

function SubMatrix(X: array2<int>, row: int, col: int): array2<int>
  requires 0 <= row < X.Length0 && 0 <= col < X.Length1
  requires X.Length0 == X.Length1
  ensures SubMatrix(X, row, col).Length0 == X.Length0 - 1
  ensures SubMatrix(X, row, col).Length1 == X.Length1 - 1
{
  var n := X.Length0;
  var result := new int[n-1, n-1];
  for i := 0 to n-1
    invariant forall k,l :: 0 <= k < i && 0 <= l < n-1 ==> result[k,l] == (if k < row && l < col then X[k,l] else if k < row && l >= col then X[k,l+1] else if k >= row && l < col then X[k+1,l] else X[k+1,l+1])
  {
    for j := 0 to n-1
      invariant forall l :: 0 <= l < j ==> result[i,l] == (if i < row && l < col then X[i,l] else if i < row && l >= col then X[i,l+1] else if i >= row && l < col then X[i+1,l] else X[i+1,l+1])
    {
      var srcRow := if i < row then i else i+1;
      var srcCol := if j < col then j else j+1;
      result[i,j] := X[srcRow, srcCol];
    }
  }
  result
}


// Helper function to compute the length of a string
function StringLength(s: string): nat {
  |s|
}

// Predicate to check if a string is a substring of another
predicate IsSubstring(sub: string, s: string)
  requires 0 <= StringLength(sub) <= StringLength(s)
{
  exists i: nat :: i + StringLength(sub) <= StringLength(s) && s[i..i+StringLength(sub)] == sub
}

// Lemma: If a string is a substring of another, its length is <= the other's length
lemma SubstringLengthLemma(sub: string, s: string)
  requires IsSubstring(sub, s)
  ensures StringLength(sub) <= StringLength(s)
{
  // The predicate already requires this, but we make it explicit
}

// Lemma: The empty string is a substring of any string
lemma EmptyStringIsSubstring(s: string)
  ensures IsSubstring("", s)
{
  assert 0 <= StringLength("") <= StringLength(s);
  assert s[0..0] == "";
}

// Lemma: A string is a substring of itself
lemma SelfIsSubstring(s: string)
  ensures IsSubstring(s, s)
{
  assert 0 <= StringLength(s) <= StringLength(s);
  assert s[0..StringLength(s)] == s;
}

// Lemma: Substring relation is transitive
lemma SubstringTransitivity(a: string, b: string, c: string)
  requires IsSubstring(a, b) && IsSubstring(b, c)
  ensures IsSubstring(a, c)
{
  // Proof: Since a is substring of b, there exists i such that b[i..i+|a|] == a
  // Since b is substring of c, there exists j such that c[j..j+|b|] == b
  // Then c[j+i..j+i+|a|] == a, so a is substring of c
  var i: nat :| i + StringLength(a) <= StringLength(b) && b[i..i+StringLength(a)] == a;
  var j: nat :| j + StringLength(b) <= StringLength(c) && c[j..j+StringLength(b)] == b;
  assert c[j+i..j+i+StringLength(a)] == a;
  assert j+i + StringLength(a) <= StringLength(c);
}

// Method to check if two strings share a common substring of a given length
method CommonSubstringExists(a: string, b: string, len: nat) returns (exists: bool)
  requires len <= StringLength(a) && len <= StringLength(b)
  ensures exists ==> exists i: nat, j: nat ::
    i + len <= StringLength(a) && j + len <= StringLength(b) &&
    a[i..i+len] == b[j..j+len]
{
  exists := false;

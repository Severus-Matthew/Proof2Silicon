// A function f(n) that computes some value based on n.
// For this example, we define f(n) = n * n (square of n).
// This can be replaced with any other function as needed.
function f(n: nat): nat {
    n * n
}

// Function to compute the sum of f(i) for 0 <= i < n.
// This is defined recursively for specification purposes.
function fSum(n: nat): nat {
    if n == 0 then 0 else fSum(n - 1) + f(n - 1)
}

// Iterative method to compute the sum of f(i) for 0 <= i < n.
// This method is verified to be correct by ensuring it matches fSum(n).
method problem6(n: nat) returns (sum: nat)
    ensures sum == fSum(n)
{
    sum := 0;
    var i: nat := 0;
    while i < n
        invariant 0 <= i <= n
        invariant sum == fSum(i)
    {
        sum := sum + f(i);
        i := i + 1;
    }
    // At the end, i == n, so sum == fSum(n)
}

// Example usage (not required but helpful for testing)
method Main() {
    var result := problem6(5);
    print "Sum of f(i) for i=0..4 is: ", result, "\n";
    // For f(n)=n*n, the sum should be 0+1+4+9+16 = 30
    assert result == 30;
}

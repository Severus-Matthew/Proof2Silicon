predicate Sorted(a: array<int>)
  reads a
{
  forall i, j :: 0 <= i < j < a.Length ==> a[i] <= a[j]
}

predicate Distinct(a: array<int>)
  reads a
{
  forall i, j :: 0 <= i < j < a.Length ==> a[i] != a[j]
}

predicate Contains(a: array<int>, target: int)
  reads a
{
  exists i :: 0 <= i < a.Length && a[i] == target
}

method BinarySearch(a: array<int>, target: int) returns (index: int)
  requires a.Length > 0
  requires Sorted(a)
  requires Distinct(a)
  ensures -1 <= index < a.Length
  ensures index >= 0 ==> a[index] == target
  ensures index == -1 ==> !Contains(a, target)
{
  var left := 0;
  var right := a.Length - 1;
  index := -1;

  while left <= right
    invariant 0 <= left <= right + 1 <= a.Length
    invariant -1 <= index < a.Length
    invariant index >= 0 ==> a[index] == target
    invariant index == -1 ==> forall k :: 0 <= k < left || right < k < a.Length ==> a[k] != target
    decreases right - left
  {
    var mid := (left + right) / 2;
    if a[mid] == target {
      index := mid;
      return;
    } else if a[mid] < target {
      left := mid + 1;
    } else {
      right := mid - 1;
    }
  }
  // When loop exits, left > right, meaning target not found
  // The invariant ensures that if index == -1, then target is not in the array
  // We need to prove !Contains(a, target) when index == -1
  // From the invariant: forall k :: 0 <= k < left || right < k < a.Length ==> a[k] != target
  // Since left > right, the entire array is covered: forall k :: 0 <= k < a.Length ==> a[k] != target
  // So !Contains(a, target) holds
}

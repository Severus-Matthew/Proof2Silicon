function even(n: nat): bool {
    n % 2 == 0
}

method is_even(n: nat) returns (result: bool)
    ensures result == even(n)
{
    var i := n;
    result := true;
    while i > 0
        invariant 0 <= i <= n
        invariant result == even(n - i)
        decreases i
    {
        i := i - 1;
        result := !result;
    }
}

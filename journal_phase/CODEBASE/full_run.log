module DivMod {
  // Helper module for range properties
  module RangeADT {
    type Nat = int
    type UInt = int
    
    predicate InRange(x: Nat, low: Nat, high: Nat) 
      reads {}
    {
      low <= x <= high
    }
    
    lemma RangeLemma(x: Nat, low: Nat, high: Nat)
      requires InRange(x, low, high)
      ensures low <= x && x <= high
    {}
  }
  
  // Import types from RangeADT
  type Nat = RangeADT.Nat
  type UInt = RangeADT.UInt
  
  // Main division and modulus function
  function DivMod(a: Nat, k: Nat): (div: Nat, mod: UInt)
    requires k > 0
    ensures div * k + mod == a
    ensures 0 <= mod < k
  {
    var q := a / k;
    var r := a % k;
    (q, r)
  }
  
  // Helper lemmas for verification
  lemma DivLocLemma(a: Nat, k: Nat)
    requires k > 0
    ensures var (q, r) := DivMod(a, k); q == a / k
  {
    var (q, r) := DivMod(a, k);
    assert q == a / k by {
      calc {
        q * k + r == a;
        q * k <= a;
        q <= a / k;
        a / k * k + a % k == a;
        q == a / k;
      }
    }
  }
  
  lemma ModLocLemma(a: Nat, k: Nat)
    requires k > 0
    ensures var (q, r) := DivMod(a, k); r == a % k
  {
    var (q, r) := DivMod(a, k);
    assert r == a % k by {
      calc {
        q * k + r == a;
        r == a - q * k;
        a % k == a - (a / k) * k;
        q == a / k;
        r == a % k;
      }
    }
  }
  
  lemma TriangleInequality(a: Nat, k: Nat)
    requires k > 0
    ensures var (q, r) := DivMod(a, k); 
            a <= q * k + k && q * k <= a
  {
    var (q, r) := DivMod(a, k);
    assert q * k <= a < (q + 1) * k by {
      assert 0 <= r < k;
      assert q * k + r == a;
      assert a < q * k + k;
    }
  }
  
  lemma RangeProperties(a: Nat, k: Nat)
    requires k > 0
    ensures var (q, r) := DivMod(a, k);
            RangeADT.InRange(q, 0, a) && RangeADT.InRange(r, 0, k-1)
  {
    var (q, r) := DivMod(a, k);
    RangeADT.RangeLemma(q, 0, a);
    RangeADT.RangeLemma(r, 0, k-1);
  }
  
  // Non-recursive implementation using while loop
  method ComputeDivMod(a: Nat, k: Nat) returns (q: Nat, r: UInt)
    requires k > 0
    ensures q * k + r == a
    ensures 0 <= r < k
  {
    q := 0;
    r := a;
    
    while r >= k
      invariant q * k + r == a
      invariant 0 <= r
      decreases r
    {
      q := q + 1;
      r := r - k;
    }
    
    // Verify postconditions
    assert q * k + r == a;
    assert 0 <= r < k;
  }
  
  // Test verification
  lemma TestDivMod()
    ensures var (q, r) := DivMod(17, 5); q == 3 && r == 2
  {
    var (q, r) := DivMod(17, 5);
    assert q == 3 && r == 2 by {
      calc {
        3 * 5 + 2 == 17;
      }
    }
  }
  
  lemma TestZeroDividend()
    ensures var (q, r) := DivMod(0, 5); q == 0 && r == 0
  {
    var (q, r) := DivMod(0, 5);
    assert q == 0 && r == 0;
  }
  
  lemma TestExactDivision()
    ensures var (q, r) := DivMod(15, 5); q == 3 && r == 0
  {
    var (q, r) := DivMod(15, 5);
    assert q == 3 && r == 0;
  }

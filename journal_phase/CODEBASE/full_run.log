method Reverse(arr: array<char>) returns (rev: array<char>)
    requires arr != null
    ensures rev != null
    ensures rev.Length == arr.Length
    ensures forall i :: 0 <= i < arr.Length ==> rev[i] == arr[arr.Length - 1 - i]
    ensures arr.Length == rev.Length
{
    rev := new char[arr.Length];
    var i := 0;
    while i < arr.Length
        invariant 0 <= i <= arr.Length
        invariant forall j :: 0 <= j < i ==> rev[j] == arr[arr.Length - 1 - j]
    {
        rev[i] := arr[arr.Length - 1 - i];
        i := i + 1;
    }
}

method Main()
{
    var arr1 := new char[3] ['h', 'e', 'l'];
    var rev1 := Reverse(arr1);

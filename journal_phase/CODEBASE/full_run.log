            // By induction on prefix, we know |s[i]| <= |s[|s|-2]|
            // And by monotonicity, |s[|s|-2]| <= |s[|s|-1]|
            // So |s[i]| <= |s[|s|-1]|
            assert |s[i]| <= |s[|s|-2]|;
            assert |s[|s|-2]| <= |s[|s|-1]|;
          }
        } else {
          // j < |s|-1, so both i and j are in the prefix
          // By induction on prefix, |s[i]| <= |s[j]|
        }
      }
    }
  }

  // Pigeonhole principle for sets
  lemma PigeonholeCard(a: set<int>, b: set<int>)
    requires |a| > |b|
    ensures exists x :: x in a && x !in b
  {
    // If all elements of a were in b, then |a| <= |b|
    if forall x :: x in a ==> x in b {
      assert a <= b;
      assert |a| <= |b|;
      assert false; // Contradiction with precondition
    }
  }
}

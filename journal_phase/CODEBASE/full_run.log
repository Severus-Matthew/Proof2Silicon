method Tangent(x: array<int>, y: array<int>) returns (r: array<int>)
    requires 0 < x.Length == y.Length
    requires forall i, j :: 0 <= i < j < x.Length ==> x[i] <= x[j]
    requires forall i, j :: 0 <= i < j < y.Length ==> y[i] <= y[j]
    ensures |r| == 1
{
    var n := x.Length;
    r := new int[1];
    r[0] := 0;
    Search(x, y, 0, n - 1, r);
}

method Search(x: array<int>, y: array<int>, left: int, right: int, r: array<int>)
    requires 0 <= left <= right < x.Length == y.Length
    requires forall i, j :: 0 <= i < j < x.Length ==> x[i] <= x[j]
    requires forall i, j :: 0 <= i < j < y.Length ==> y[i] <= y[j]
    requires |r| == 1

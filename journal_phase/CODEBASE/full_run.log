function max(s: seq<int>): int
  requires s != []
  ensures forall i :: 0 <= i < |s| ==> max(s) >= s[i]
  ensures exists i :: 0 <= i < |s| && max(s) == s[i]
{
  var m := s[0];
  for i := 1 to |s|
    invariant 1 <= i <= |s|
    invariant forall j :: 0 <= j < i ==> m >= s[j]
    invariant exists j :: 0 <= j < i && m == s[j]
  {
    if s[i] > m {
      m := s[i];
    }
  }
  m
}

method rolling_max(s: seq<int>) returns (r: seq<int>)
  ensures |r| == |s|
  ensures forall i :: 0 <= i < |s| ==> r[i] == max(s[..i+1])
{
  r := [];
  if |s| == 0 {
    return;
  }
  var currentMax := s[0];
  r := [currentMax];
  for i := 1 to |s|
    invariant 1 <= i <= |s|
    invariant |r| == i
    invariant forall j :: 0 <= j < i ==> r[j] == max(s[..j+1])
  {
    if s[i] > currentMax {
      currentMax := s[i];
    }
    r := r + [currentMax];
  }
}
```

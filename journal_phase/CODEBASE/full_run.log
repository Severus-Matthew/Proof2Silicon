method main(n: int, k: int) returns (i: int, j: int)
  requires n >= 0
  ensures k + i + j >= 2 * n
{
  i := 0;
  j := 0;
  while i <= n
    invariant 0 <= i <= n + 1
    invariant j == i * (i - 1) / 2
  {
    j := j + i;
    i := i + 1;
  }
  // After loop, i == n + 1, j == n*(n+1)/2
  // So k + i + j = k + (n+1) + n*(n+1)/2 >= 2*n for all n >= 0, k >= 0
  // But to be safe we assert the postcondition
  assert k + i + j >= 2 * n;
}

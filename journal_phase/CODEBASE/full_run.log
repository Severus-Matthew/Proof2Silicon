// Problem: Given a non-negative integer n, compute the nth Fibonacci number.
// The Fibonacci sequence is defined as:
//   F(0) = 0, F(1) = 1, and for n >= 2: F(n) = F(n-1) + F(n-2)
// We implement an iterative solution using a loop, with no recursion.
// We use ghost variables and lemmas to verify correctness.

method Fibonacci(n: nat) returns (result: nat)
    // Precondition: n is a natural number (non-negative integer)
    // Postcondition: result equals the nth Fibonacci number
    ensures result == Fib(n)
{
    // Handle base cases directly
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }

    // For n >= 2, we iterate from 2 to n, maintaining the last two Fibonacci numbers.
    var a: nat := 0; // F(i-2) initially F(0)
    var b: nat := 1; // F(i-1) initially F(1)
    var i: int := 2; // current index

    // Ghost variable to track the sequence for verification
    ghost var fibSeq: seq<nat> := [0, 1];

    // Loop invariant: we have computed Fibonacci numbers up to i-1,
    // a = Fib(i-2), b = Fib(i-1), and fibSeq contains the sequence from 0 to i-1.
    while i <= n
        invariant 2 <= i <= n+1
        invariant a == Fib(i-2)
        invariant b == Fib(i-1)
        invariant |fibSeq| == i
        invariant forall j: int :: 0 <= j < i ==> fibSeq[j] == Fib(j)
        decreases n - i
    {
        // Compute next Fibonacci number
        var next: nat := a + b;
        // Update for next iteration
        a := b;
        b := next;
        // Update ghost sequence
        fibSeq := fibSeq + [next];
        i := i + 1;
    }

    // After loop, i == n+1, so b = Fib(i-1) = Fib(n)
    result := b;
}

// Ghost function to define Fibonacci numbers for verification
ghost function Fib(n: nat): nat
{
    if n == 0 then 0
    else if n == 1 then 1
    else Fib(n-1) + Fib(n-2)
}

// Lemma to prove properties about Fibonacci numbers (optional, for deeper verification)
// This lemma is not required for the main method but can be used to prove additional properties.
lemma FibPositive(n: nat)
    ensures Fib(n) >= 0
{
    // Trivially true since Fib returns nat
}

// Test cases to verify correctness
method TestFibonacci()
{
    // Test base cases
    var f0 := Fibonacci(0);
    assert f0 == 0;
    var f1 := Fibonacci(1);
    assert f1 == 1;

    // Test small values
    var f2 := Fibonacci(2);
    assert f2 == 1;
    var f3 := Fibonacci(3);
    assert f3 == 2;
    var f4 := Fibonacci(4);
    assert f4 == 3;
    var f5 := Fibonacci(5);
    assert f5 == 5;
    var f6 := Fibonacci(6);
    assert f6 == 8;
    var f7 := Fibonacci(7);
    assert f7 == 13;
    var f8 := Fibonacci(8);
    assert f8 == 21;
    var f9 := Fibonacci(9);
    assert f9 == 34;
    var f10 := Fibonacci(10);
    assert f10 == 55;

    // Test larger value
    var f20 := Fibonacci(20);
    assert f20 == 6765;

    // Test edge case: n = 0 and n = 1 already tested
    // Test n = 2 again for consistency
    var f2_again := Fibonacci(2);
    assert f2_again == 1;

    // Additional verification using lemma
    FibPositive(10);
}

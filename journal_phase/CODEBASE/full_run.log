```dafny
method SecondLargest(a: array<int>) returns (res: int?)
    ensures a.Length == 0 ==> res == None
    ensures a.Length >= 1 ==> res == None || (exists i :: 0 <= i < a.Length && a[i] == res)
    ensures a.Length >= 1 && res != None ==> 
        (forall i :: 0 <= i < a.Length ==> a[i] <= res || a[i] == res) &&
        (exists i, j :: 0 <= i < a.Length && 0 <= j < a.Length && i != j && a[i] == res && a[j] == res) ||
        (exists i :: 0 <= i < a.Length && a[i] == res && (forall j :: 0 <= j < a.Length && j != i ==> a[j] <= res))
{
    if a.Length == 0 {
        return None;
    }
    if a.Length == 1 {
        return None;
    }

    var largest := a[0];
    var seclar: int;
    var hasSecond := false;

    if a[1] > largest {
        seclar := largest;
        largest := a[1];
        hasSecond := true;
    } else if a[1] < largest {
        seclar := a[1];
        hasSecond := true;
    } else {
        seclar := a[1]; // equal, so second largest is same as largest
        hasSecond := true;
    }

    var i := 2;
    while i < a.Length
        invariant 2 <= i <= a.Length
        invariant hasSecond ==> 
            (forall j :: 0 <= j < i ==> a[j] <= largest) &&
            (exists j :: 0 <= j < i && a[j] == largest) &&
            (forall j :: 0 <= j < i ==> a[j] <= seclar || a[j] == largest) &&
            (exists j :: 0 <= j < i && a[j] == seclar)
        invariant !hasSecond ==> 
            (forall j :: 0 <= j < i ==> a[j] == largest) &&
            i <= 2
    {
        if a[i] > largest {
            seclar := largest;
            largest := a[i];
            hasSecond := true;
        } else if a[i] > seclar && a[i] < largest {
            seclar := a[i];
            hasSecond := true;
        } else if a[i] == largest && !hasSecond {
            seclar := largest;
            hasSecond := true;
        } else if a[i] < largest && !hasSecond {
            seclar := a[i];
            hasSecond := true;
        }
        i := i + 1;
    }

    if hasSecond {
        return seclar;
    } else {
        return None;
    }
}

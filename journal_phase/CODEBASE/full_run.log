```dafny
// A Dafny program to rotate an array left by a given number of positions.
// The rotation is performed in-place using a reverse-based algorithm.
// The code includes a Check function to verify correctness.

method RotateLeft(a: array<int>, k: int) returns (result: array<int>)
  requires 0 <= k
  requires a.Length > 0
  ensures result.Length == a.Length
  ensures forall i :: 0 <= i < a.Length ==> result[i] == a[(i + k) % a.Length]
{
  var n := a.Length;
  var effectiveK := k % n; // handle k >= n
  result := new int[n];
  
  // Copy original array to result
  for i := 0 to n - 1
    invariant forall j :: 0 <= j < i ==> result[j] == a[j]
  {
    result[i] := a[i];
  }

  // Reverse the entire array
  Reverse(result, 0, n - 1);
  // Reverse the first n - effectiveK elements
  Reverse(result, 0, n - effectiveK - 1);
  // Reverse the last effectiveK elements
  Reverse(result, n - effectiveK, n - 1);
}

// Helper method to reverse a segment of an array in place
method Reverse(a: array<int>, left: int, right: int)
  requires 0 <= left <= right < a.Length
  modifies a
  ensures forall i :: left <= i <= right ==> a[i] == old(a[left + right - i])
{
  var i := left;
  var j := right;
  while i < j
    invariant left <= i <= j + 1 <= right + 1
    invariant forall k :: left <= k < i || j < k <= right ==> a[k] == old(a[left + right - k])
    invariant forall k :: i <= k <= j ==> a[k] == old(a[k]) // unchanged in the middle
    decreases j - i
  {
    var temp := a[i];
    a[i] := a[j];
    a[j] := temp;
    i := i + 1;
    j := j - 1;
  }
}

// Check function to verify the rotation
method Check(a: array<int>, k: int, expected: array<int>) returns (correct: bool)
  requires a.Length == expected.Length
  ensures correct <==> forall i :: 0 <= i < a.Length ==> RotateLeft(a, k)[i] == expected[i]
{
  var result := RotateLeft(a, k);
  correct := true;
  for i := 0 to a.Length - 1
    invariant correct ==> forall j :: 0 <= j < i ==> result[j] == expected[j]
  {
    if result[i] != expected[i] {
      correct := false;
      return;
    }
  }
}

// Example usage and verification
method Main()
{
  var a := new int[5] [1, 2, 3, 4, 5];
  var k := 2;
  var expected := new int[5] [3, 4, 5, 1, 2];
  var result := RotateLeft(a, k);
  
  // Verify the result matches expected
  assert result[0] == 3 && result[1] == 4 && result[2] == 5 && result[3] == 1 && result[4] == 2;
  
  // Use Check function
  var correct := Check(a, k, expected);
  assert correct;
  
  print "Rotation successful: ";
  print result[0], " ", result[1], " ", result[2], " ", result[3], " ", result[4], "\n";
}
```

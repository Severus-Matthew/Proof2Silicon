    while i < arr.Length
        invariant 1 <= i <= arr.Length
        invariant forall j :: 0 <= j < i ==> max >= arr[j]
        invariant exists j :: 0 <= j < i && max == arr[j]
        decreases arr.Length - i
    {
        if arr[i] > max {
            max := arr[i];
        }
        i := i + 1;
    }
}

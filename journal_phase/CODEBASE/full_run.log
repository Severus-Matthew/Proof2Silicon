        invariant 0 <= i <= |list|
        invariant !foundEven ==> forall j :: 0 <= j < i ==> list[j] % 2 != 0
        invariant foundEven ==> evenIndex < i && list[evenIndex] % 2 == 0
    {
        if list[i] % 2 == 0 {
            evenIndex := i;
            foundEven := true;
        }
        i := i + 1;
    }
    
    // Find first odd index after even index
    i := evenIndex + 1;
    while i < |list| && !foundOdd
        invariant evenIndex < i <= |list|
        invariant !foundOdd ==> forall j :: evenIndex < j < i ==> list[j] % 2 == 0
        invariant foundOdd ==> oddIndex < i && list[oddIndex] % 2 != 0
    {
        if list[i] % 2 != 0 {
            oddIndex := i;
            foundOdd := true;
        }
        i := i + 1;
    }
    
    // Ensure we found both indices
    assert foundEven && foundOdd;
}

// A method that computes the maximum element in an integer array.
// It uses an iterative loop (no recursion) and is verified for correctness.
method MaxArray(a: array<int>) returns (max: int)
    // The array must not be null.
    requires a != null
    // The array must have at least one element.
    requires 0 < a.Length
    // The result is an element of the array.
    ensures exists i :: 0 <= i < a.Length && max == a[i]
    // The result is greater than or equal to every element.
    ensures forall i :: 0 <= i < a.Length ==> max >= a[i]
{
    // Initialize max to the first element.
    max := a[0];
    var i := 1;
    // Loop invariant: we have examined elements 0..i-1.
    // The current max is the maximum of those elements.
    while i < a.Length
        invariant 1 <= i <= a.Length
        // max is an element among the first i elements.
        invariant exists j :: 0 <= j < i && max == a[j]
        // max is >= all of the first i elements.
        invariant forall j :: 0 <= j < i ==> max >= a[j]
    {
        if a[i] > max {
            max := a[i];
        }
        i := i + 1;
    }
    // After the loop, i == a.Length, so the invariant gives the postcondition.
}

// A simple Dafny program that computes the maximum element in an array.
// This implementation uses iteration instead of recursion, is self-contained,
// and includes verification of correctness.

method FindMax(a: array<int>) returns (max: int)
    requires a.Length > 0
    ensures forall i :: 0 <= i < a.Length ==> a[i] <= max
    ensures exists i :: 0 <= i < a.Length && a[i] == max
{
    max := a[0];
    var i := 1;
    while i < a.Length
        invariant 1 <= i <= a.Length
        invariant forall j :: 0 <= j < i ==> a[j] <= max
        invariant exists j :: 0 <= j < i && a[j] == max
    {
        if a[i] > max {
            max := a[i];
        }
        i := i + 1;
    }
}

// Example usage
method Main() {
    var arr := new int[5] [3, 7, 2, 9, 5];
    var m := FindMax(arr);
    print "Maximum element is: ", m, "\n";
    assert m == 9;
}

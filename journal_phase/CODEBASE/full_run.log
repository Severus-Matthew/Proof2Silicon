// A non-recursive method to find insertion index in a non-increasing sequence.
// The sequence a is non-empty and non-increasing (a[i] >= a[i+1] for all i).
// For a given value x, we find index k (0 <= k <= a.Length) such that:
//   - for all i < k, a[i] >= x
//   - for all i >= k, a[i] < x
// This is the standard "lower bound" for a non-increasing sequence.

method FindInsertionIndex(a: array<real>, x: real) returns (k: int)
    requires a.Length > 0
    // Non-increasing property: every element is >= the next
    requires forall i: int :: 0 <= i < a.Length - 1 ==> a[i] >= a[i+1]
    // Ensures k is within bounds
    ensures 0 <= k <= a.Length
    // All elements before k are >= x
    ensures forall i: int :: 0 <= i < k ==> a[i] >= x
    // All elements from k onward are < x
    ensures forall i: int :: k <= i < a.Length ==> a[i] < x
{
    var lo := 0;
    var hi := a.Length;
    
    // Invariant: lo <= hi
    // Invariant: forall i: int :: 0 <= i < lo ==> a[i] >= x
    // Invariant: forall i: int :: hi <= i < a.Length ==> a[i] < x
    while lo < hi
        invariant 0 <= lo <= hi <= a.Length
        invariant forall i: int :: 0 <= i < lo ==> a[i] >= x
        invariant forall i: int :: hi <= i < a.Length ==> a[i] < x
        decreases hi - lo
    {
        var mid := (lo + hi) / 2;
        // Since a is non-increasing, we compare a[mid] with x
        if a[mid] >= x {
            // a[mid] >= x, so all indices <= mid might be >= x, but we need the first index where a[i] < x
            // So we move lo to mid+1, because we know a[mid] >= x, so the insertion point is at least mid+1
            lo := mid + 1;
        } else {
            // a[mid] < x, so the insertion point is at most mid
            hi := mid;
        }
    }
    k := lo;
}

// Test method to verify correctness
method Test()
{
    // Example sequence: non-increasing
    var a := new real[5] [5.0, 4.0, 3.0, 2.0, 1.0];
    
    // Test with x = 3.5
    var k1 := FindInsertionIndex(a, 3.5);
    // Expected: k1 = 2 (since a[0]=5>=3.5, a[1]=4>=3.5, a[2]=3<3.5)
    assert k1 == 2;
    assert forall i: int :: 0 <= i < k1 ==> a[i] >= 3.5;
    assert forall i: int :: k1 <= i < a.Length ==> a[i] < 3.5;
    

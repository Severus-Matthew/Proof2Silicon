method IncrementArray(a: array<int>)
    modifies a
    ensures forall i :: 0 <= i < a.Length ==> a[i] == old(a[i]) + 1
{
    var i := 0;
    while i < a.Length
        invariant 0 <= i <= a.Length
        invariant forall j :: 0 <= j < i ==> a[j] == old(a[j]) + 1
        invariant forall j :: i <= j < a.Length ==> a[j] == old(a[j])
    {
        a[i] := a[i] + 1;
        i := i + 1;
    }
}

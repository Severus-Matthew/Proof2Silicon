method LinearSeach0(arr: array<int>, len: int) returns (index: int)
  requires arr != null
  requires len == arr.Length
  requires len >= 3  // preCondition >= 0 & len - 1 >= 2
  ensures 0 <= index < len || index == -1
  ensures index != -1 ==> arr[index] % 2 == 0
  ensures index == -1 ==> forall j :: 1 <= j < len ==> arr[j] % 2 != 0
{
  index := -1;
  var i: int := 1;

  while i < len
    invariant 1 <= i <= len
    invariant index == -1 ==> forall j :: 1 <= j < i ==> arr[j] % 2 != 0
    invariant index != -1 ==> arr[index] % 2 == 0
  {
    if arr[i] % 2 == 0 {
      index := i;
      return;
    }
    i := i + 1;
  }
}

method LinearSeach1(arr: array<int>, len: int) returns (index: int)
  requires arr != null
  requires len == arr.Length
  requires len >= 3  // preCondition >= 0 & len - 1 >= 2
  ensures 0 <= index < len || index == -1
  ensures index != -1 ==> arr[index] % 2 == 0
  ensures index == -1 ==> forall j :: 3 <= j < len && (j - 1) % 2 == 0 ==> arr[j] % 2 != 0
{
  index := -1;
  var i: int := 3;  // 1 + 2

  while i < len
    invariant 3 <= i <= len
    invariant index == -1 ==> forall j :: 3 <= j < i && (j - 1) % 2 == 0 ==> arr[j] % 2 != 0
    invariant index != -1 ==> arr[index] % 2 == 0
  {
    if (i - 1) % 2 == 0 {  // Check pattern condition
      if arr[i] % 2 == 0 {
        index := i;
        return;
      }
    }
    i := i + 1;
  }
}


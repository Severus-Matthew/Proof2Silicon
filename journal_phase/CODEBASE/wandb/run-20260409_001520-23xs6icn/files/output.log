    while low <= high
      invariant 0 <= low <= arr.Length
      invariant -1 <= high < arr.Length
      invariant low <= high + 1
      invariant index == -1 ==> forall j :: 0 <= j < low ==> arr[j] % 2 != 0
      invariant index == -1 ==> forall j :: high < j < arr.Length ==> arr[j] % 2 != 0
      decreases high - low
    {

```dafny
module BinarySearchModule {

  // Binary search to find the first even element in a sorted array
  method BinarySearchFirstEven(arr: array<int>) returns (index: int)
    requires arr.Length > 0
    requires forall i, j :: 0 <= i < j < arr.Length ==> arr[i] <= arr[j]  // Array is sorted
    ensures -1 <= index < arr.Length
    ensures index != -1 ==> arr[index] % 2 == 0
    ensures index == -1 ==> forall j :: 0 <= j < arr.Length ==> arr[j] % 2 != 0  // No even elements
    ensures index != -1 ==> (index == 0 || arr[index - 1] % 2 != 0)  // First even element
  {
    index := -1;
    var low: int := 0;
    var high: int := arr.Length - 1;

    while low <= high
      invariant 0 <= low <= arr.Length
      invariant -1 <= high < arr.Length
      invariant low <= high + 1
      invariant index == -1 ==> forall j :: 0 <= j < low ==> arr[j] % 2 != 0
      invariant index == -1 ==> forall j :: high < j < arr.Length ==> arr[j] % 2 != 0
      invariant index != -1 ==> arr[index] % 2 == 0 && (index == 0 || arr[index - 1] % 2 != 0)
    {
      var mid: int := low + (high - low) / 2;

      if arr[mid] % 2 == 0 {
        // Found an even element, but need to check if it's the first one
        index := mid;

        // Continue searching in the left half to find the first even
        high := mid - 1;
      } else {
        // Current element is odd, so all elements to the left must also be odd
        // (because array is sorted and odds come before evens in sorted order)
        low := mid + 1;
      }
    }
  }

  // Helper method to test the binary search
  method TestBinarySearch()

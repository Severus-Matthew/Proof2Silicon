  }

  // More efficient version using early termination
  method BinarySearchFirstEvenOptimized(arr: array<int>) returns (index: int)
    requires arr.Length > 0
    requires forall i, j :: 0 <= i < j < arr.Length ==> arr[i] <= arr[j]  // Array is sorted
    ensures -1 <= index < arr.Length
    ensures index != -1 ==> arr[index] % 2 == 0
    ensures index == -1 ==> forall j :: 0 <= j < arr.Length ==> arr[j] % 2 != 0
    ensures index != -1 ==> (index == 0 || arr[index - 1] % 2 != 0)
  {

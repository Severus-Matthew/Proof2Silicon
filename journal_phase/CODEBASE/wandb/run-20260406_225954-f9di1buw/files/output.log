    } else {
      // Convert to reverse indexing (0 = highest index)
      foundIndex := arr.Length - 1 - forwardIndex;

      // Verify that this is indeed the first match in reverse order
      var i: int := 0;
      ghost var reverseIndex := foundIndex;

      while i < reverseIndex
        invariant 0 <= i <= reverseIndex
        invariant forall j :: 0 <= j < i ==>

  // LinearSearch0 - improved version
  method LinearSearch0(arr: IntArray) returns (foundIndex: int)
    requires arr != null
    requires arr.Length > 0
    ensures foundIndex == -1 || (0 <= foundIndex < arr.Length && P(arr[foundIndex]))
    ensures foundIndex == -1 ==> forall i :: 0 <= i < arr.Length ==> !P(arr[i])
    ensures foundIndex != -1 ==> forall i :: 0 <= i < foundIndex ==> !P(arr[i])
    decreases arr.Length
  {
    foundIndex := -1;
    var i: int := 0;

    while i < arr.Length

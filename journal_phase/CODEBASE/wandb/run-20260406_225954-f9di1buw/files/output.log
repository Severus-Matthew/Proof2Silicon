        foundIndex := i;
        return;
      }
      i := i + 1;
    }
  }

  // LinearSearch1 - with reverse indexing (0 = highest index)
  method LinearSearch1(arr: IntArray) returns (foundIndex: int)
    requires arr != null
    requires arr.Length > 0
    ensures foundIndex == -1 || (0 <= foundIndex < arr.Length && P(arr[foundIndex]))
    ensures foundIndex == -1 ==> forall i :: 0 <= i < arr.Length ==> !P(arr[i])
    ensures foundIndex != -1 ==>

  requires 0 <= left <= right <= |a|
  requires forall i, j :: 0 <= i < j < |a| ==> a[i] >= a[j]
  ensures 0 <= SearchRecursiveHelper(a, x, left, right) <= |a|
  ensures forall i :: 0 <= i <= SearchRecursiveHelper(a, x, left, right) ==> a[i] >= x
  ensures forall i :: SearchRecursiveHelper(a, x, left, right) < i < |a| ==> a[i] <= x
{

            var name := stack[|stack| - 2];
            stack := stack[..|stack| - 2];
            // Store assignment (simplified)
            result := result + [name + "=" + value];
          }
        case "dynamic" =>
          // Dynamic operation - rotate stack
          if |stack| > 0 {
            var first := stack[0];
            stack := stack[1..] + [first];
          }
        case ":" =>
          // Separator - push to result
          if |stack| > 0 {
            result := result + stack;
            stack := [];
          }
        case "#" =>
          // Comment or special marker
          i := i + 1;
          continue;
        case "<?", "?>" =>
          // Block markers - skip processing
          i := i + 1;
          continue;
        case _ =>
          // Push literal to stack
          stack := stack + [token];
      }

      i := i + 1;
    }

    // Add remaining stack to result
    result := result + stack;
  }

  // Helper function to reverse a string
  function ReverseString(s: string): string
    ensures |ReverseString(s)| == |s|
  {
    if s == "" then "" else ReverseString(s[1..]) + s[0].ToString()
  }


    // This can't happen because:
    // k >= i and d >= i implies k*d >= i*i > n
    // But k*d = n (since n % k == 0 and d = n/k)
    // Contradiction
    assert false;
  }
}

method OptimizedIsPrime(n: nat) returns (isPrime: bool)
  ensures isPrime == (n >= 2 && forall k: nat :: 2 <= k < n ==> n % k != 0)

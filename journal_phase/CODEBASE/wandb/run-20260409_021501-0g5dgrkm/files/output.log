        case ("Crimson", "Dive", "Premature") => valid := true;

        case ("Sterling", "Plunge", "Youthful") => valid := true;
        case ("Sterling", "Catalyze", "Inert") => valid := true;
        case ("Sterling", "Rebound", "Crimson") => valid := true;
        case ("Sterling", "Dive", "Premature") => valid := true;

        case _ => valid := false;
      }
    }
  }

  // Test method to verify the state machine
  method TestStateMachine()
  {
    var system := new StateSystem();
    var success: bool;

    // Start in Premature state
    var stateType := system.GetCurrentStateType();
    print "Initial state: ", stateType, "\n";

    // Test some transitions
    success := system.Transition(0); // Plunge
    if success {
      stateType := system.GetCurrentStateType();
      print "After Plunge: ", stateType, "\n";
    }

    success := system.Transition(1); // Catalyze
    if success {

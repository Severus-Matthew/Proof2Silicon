```dafny
// Dafny program demonstrating various features from the fragments

// Predicate to check if a sequence is sorted (distLowAlignCheap-like concept)
predicate Sorted(s: seq<int>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
}

// Function to compute sum of squares (squared concept)
function SumOfSquares(s: seq<int>): int
{
  if |s| == 0 then 0
  else s[0] * s[0] + SumOfSquares(s[1..])
}

// Linear algebra: Vector operations
type Vector = seq<real>

function DotProduct(v1: Vector, v2: Vector): real
  requires |v1| == |v2|
{
  if |v1| == 0 then 0.0
  else v1[0] * v2[0] + DotProduct(v1[1..], v2[1..])
}

// Method with verification for array manipulation
method ProcessArray(arr: array<int>) returns (sum: int, sorted: bool)
  requires arr != null
  ensures sum == SumOfSquares(arr[..])
  ensures sorted == Sorted(arr[..])
{
  sum := 0;
  sorted := true;

  var i := 0;
  while i < arr.Length
    invariant 0 <= i <= arr.Length
    invariant sum == SumOfSquares(arr[..i])
    invariant sorted == Sorted(arr[..i])
  {
    sum := sum + arr[i] * arr[i];

    if i > 0 && arr[i] < arr[i-1] {
      sorted := false;
    }

    i := i + 1;
  }
}

// Test method with assertions
method TestFeatures()
{
  // Test Sorted predicate
  var s1 := [1, 2, 3, 4, 5];
  assert Sorted(s1);

  var s2 := [5, 3, 1];
  assert !Sorted(s2);

  // Test SumOfSquares function
  assert SumOfSquares([1, 2, 3]) == 1 + 4 + 9;
  assert SumOfSquares([]) == 0;

  // Test vector operations
  var v1 := [1.0, 2.0, 3.0];
  var v2 := [4.0, 5.0, 6.0];
  assert DotProduct(v1, v2) == 1.0*4.0 + 2.0*5.0 + 3.0*6.0;

  // Test ProcessArray method
  var arr := new int[3];
  arr[0] := 1; arr[1] := 2; arr[2] := 3;
  var sum, sorted := ProcessArray(arr);
  assert sum == 14;  // 1² + 2² + 3² = 1 + 4 + 9 = 14
  assert sorted == true;

  print "All tests passed!\n";
}

// Main method to run the tests
method Main()
{
  TestFeatures();
}
```


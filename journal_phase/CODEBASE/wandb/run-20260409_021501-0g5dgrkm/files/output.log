      LOAD(4),            // Load computed result (x^x)
      LOAD(0),            // Load counter
      LOAD(50),           // Load base address for output (50)
      ADD,                // accumulator = counter + 50
      STORE(6),           // Store output address at address 6
      // Store result at the computed address
      LOAD(4),
      STORE(6),           // Store result at address stored in address 6

      // Increment counter
      LOAD(0),            // Load counter
      LOAD(1),            // Load 1
      ADD,                // counter = counter + 1
      STORE(0),           // Store updated counter

      JUMP(2),            // Jump back to main loop start

      // End (address 40)
      HALT
    ];


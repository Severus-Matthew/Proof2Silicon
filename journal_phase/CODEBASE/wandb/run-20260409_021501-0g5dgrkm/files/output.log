```dafny
method VerifyLoopBoundsAndAssertions(n: int) returns (sum: int)
  requires n >= 0
  ensures sum == n * (n + 1) / 2  // Sum of first n natural numbers
{
  var i := 0;
  sum := 0;

  while i <= n
    invariant 0 <= i <= n + 1
    invariant sum == i * (i - 1) / 2
    decreases n - i
  {
    // Local variable with scope limited to loop body
    var localTemp := i;
    assert localTemp == i;  // Assertion about local variable

    sum := sum + i;

    // Assertion checking the invariant property
    assert sum == (i * (i + 1)) / 2;

    i := i + 1;

    // Post-increment assertion
    assert i == old(i) + 1;
  }

  // Final assertion after loop
  assert i == n + 1;
  assert sum == n * (n + 1) / 2;
}

method CompareAndSwap(a: array<int>)
  requires a != null
  requires a.Length >= 2
  ensures a[0] <= a[1]  // After method, first element <= second element
{
  if (a[1] < a[0]) {
    // Swap the elements
    var temp := a[0];
    a[0] := a[1];
    a[1] := temp;

    // Assertions about the swap
    assert a[0] == old(a[1]);
    assert a[1] == old(a[0]);
  }

  // Final assertion
  assert a[0] <= a[1];
}

method VerifyInductiveProperty(n: int) returns (result: int)
  requires n >= 0
  ensures result == n  // Simple identity for demonstration
{
  result := 0;
  var counter := 0;

  while counter < n
    invariant 0 <= counter <= n
    invariant result == counter
    decreases n - counter
  {
    // Local scope demonstration
    {
      var localScopeVar := counter;
      assert localScopeVar == counter;
    }
    // localScopeVar is out of scope here

    result := result + 1;
    counter := counter + 1;

    // Inductive step assertion
    assert result == counter;
  }

  assert counter == n;
  assert result == n;
}

method VerifyArrayBounds(arr: array<int>)
  requires arr != null
  requires arr.Length > 0
{
  var i := 0;

  while i < arr.Length
    invariant 0 <= i <= arr.Length
    decreases arr.Length - i
  {
    // Safe array access within bounds
    var element := arr[i];
    assert 0 <= i < arr.Length;  // Bounds check

    // Local assertion about the element
    assert element == arr[i];

    i := i + 1;
  }

  assert i == arr.Length;
}

method Main()
{
  // Test the methods
  var sum1 := VerifyLoopBoundsAndAssertions(5);
  assert sum1 == 15;  // 0+1+2+3+4+5 = 15

  var arr := new int[2];
  arr[0] := 5;
  arr[1] := 3;
  CompareAndSwap(arr);
  assert arr[0] == 3 && arr[1] == 5;

  var result := VerifyInductiveProperty(10);
  assert result == 10;

  var testArr := new int[3];
  testArr[0] := 1;
  testArr[1] := 2;
  testArr[2] := 3;
  VerifyArrayBounds(testArr);
}
```


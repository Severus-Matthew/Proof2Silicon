  else CumulativeSumHelper(a, i, 0, [])
}

// Helper function that builds the cumulative sum sequence recursively
function CumulativeSumHelper(a: array<int>, i: int, idx: int, acc: seq<int>): seq<int>
  requires a != null
  requires 0 <= i < a.Length
  requires 0 <= idx <= a.Length
  requires |acc| == idx
  requires forall k :: 0 <= k < idx ==> acc[k] == sum(a[..k+1])

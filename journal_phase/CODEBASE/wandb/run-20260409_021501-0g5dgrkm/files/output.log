  // Define a predicate to check if a state is reachable from another state
  predicate Reachable(from: State, to: State)
    decreases *
  {
    to in Transition(from) ||
    exists intermediate: State ::
      intermediate in Transition(from) && Reachable(intermediate, to)
  }

  // Main verification: Check that GRAND can reach various important states
  method VerifyReachability()
  {
    // Verify some key reachability properties
    assert Reachable(GRAND, CRIB);
    assert Reachable(CRIB, OPAQUE);
    assert Reachable(OPAQUE, CHARGED);
    assert Reachable(CHARGED, TALLY);
    assert Reachable(TALLY, CUMMATE);

    // Verify that the system can cycle back to GRAND
    assert Reachable(GRAND, APTEN);
    assert Reachable(APTEN, GRAND);
  }

  // Method to demonstrate a path through the state machine
  method FindPath(start: State, end: State) returns (path: seq<State>)
    requires Reachable(start, end)
    ensures |path| > 0 && path[0] == start && path[|path|-1] == end
  {
    // This would be implemented with a search algorithm
    // For now, return a simple path
    path := [start, end];
  }

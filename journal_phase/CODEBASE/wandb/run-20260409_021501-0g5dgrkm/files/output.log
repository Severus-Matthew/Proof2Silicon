lemma DivisibleImpliesSmallerDivisor(n: nat, i: nat, k: nat)
  requires n >= 2
  requires i >= 2
  requires i * i > n
  requires 2 <= k < n
  requires n % k == 0
  ensures exists d: nat :: 2 <= d < i && n % d == 0
{

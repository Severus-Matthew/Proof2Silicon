      invariant forall k {:trigger arr[k]} :: 0 <= k < j ==> arr[k] >= arr[j]  // Elements before j are >= arr[j]
      invariant forall k :: j <= k < n - i - 1 ==> arr[j] >= arr[k + 1]  // arr[j] is >= all elements from j to n-i-1

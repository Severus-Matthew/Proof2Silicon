I understand you're asking about best practices for handling arrays in Dafny, particularly regarding scope, state changes, and verification. Let me provide a comprehensive example that demonstrates these concepts clearly.

```dafny
method ArrayExample(n: int) returns (result: int)
  requires n > 0
  ensures result == n * (n - 1) / 2  // Sum of 0..(n-1)
{
  // 1. Array declaration with initial state
  var arr := new int[n];

  // 2. Initial state invariant
  ghost var initialValues := arr[..];
  assert |arr| == n;
  assert forall i | 0 <= i < n :: arr[i] == 0;

  var sum := 0;
  var i := 0;

  // 3. Loop with array modifications
  while i < n
    invariant 0 <= i <= n
    invariant sum == (i - 1) * i / 2  // Sum of 0..(i-1)
    invariant forall j | 0 <= j < i :: arr[j] == j
    invariant forall j | i <= j < n :: arr[j] == 0
    decreases n - i
  {
    // 4. Single array modification per iteration
    arr[i] := i;
    sum := sum + i;
    i := i + 1;

    // 5. Intermediate state verification
    assert i <= n ==> (forall j | 0 <= j < i :: arr[j] == j);
  }

  // 6. Final state assertions
  assert i == n;
  assert forall j | 0 <= j < n :: arr[j] == j;
  assert sum == n * (n - 1) / 2;

  result := sum;

  // 7. Post-condition verification
  assert result == n * (n - 1) / 2;
}

// Alternative: Method with array parameter
method ProcessArray(a: array<int>) returns (modified: array<int>)
  requires a != null
  ensures |modified| == |a|
  ensures forall i | 0 <= i < |a| :: modified[i] == a[i] * 2
{
  modified := new int[|a|];
  var i := 0;

  while i < |a|
    invariant 0 <= i <= |a|
    invariant forall j | 0 <= j < i :: modified[j] == a[j] * 2
    invariant forall j | i <= j < |a| :: modified[j] == 0
    decreases |a| - i
  {
    modified[i] := a[i] * 2;
    i := i + 1;
  }
}

// Example with nested scope
method NestedScopeExample() {
  var outerArray := new int[10];

  // Outer scope
  {
    var i := 0;
    while i < 5
      invariant 0 <= i <= 5
      invariant forall j | 0 <= j < i :: outerArray[j] == 1
    {
      outerArray[i] := 1;
      i := i + 1;
    }
  }

  // Inner scope with local array
  {
    var localArray := new int[5];
    var j := 0;
    while j < 5
      invariant 0 <= j <= 5
      invariant forall k | 0 <= k < j :: localArray[k] == 2
    {
      localArray[j] := 2;
      j := j + 1;
    }

    // localArray goes out of scope here
  }

  // outerArray still accessible
  assert outerArray[0] == 1;
}

// Helper lemma for array properties
lemma ArrayProperties(a: array<int>)
  requires a != null
  ensures |a[..]| == |a|
  ensures forall i | 0 <= i < |a| :: a[..][i] == a[i]
{
}

// Method demonstrating array slicing
method ArraySliceExample(a: array<int>) returns (slice: array<int>)
  requires a != null && |a| >= 3
  ensures |slice| == 3
  ensures slice[0] == a[1] && slice[1] == a[2] && slice[2] == a[3]
{
  slice := new int[3];
  slice[0] := a[1];
  slice[1] := a[2];
  slice[2] := a[3];
}
```

Key principles demonstrated:

1. **Initial State Check**: Use `assert` statements after array creation to verify initial conditions
2. **Single Modification Per Loop**: Each iteration modifies only one array element
3. **Loop Invariants**: Capture array state at each iteration boundary
4. **Final State Assertion**: Verify the post-condition matches the intended result
5. **Scope Management**:
   - Variables declared inside blocks have limited scope
   - Arrays follow the same scoping rules as other variables
   - Use ghost variables to track historical states if needed
6. **Array Slicing**: Use `a[..]` to create immutable sequences for verification
7. **Quantifiers**: Use `forall` expressions to specify array-wide properties

The most important practice is to maintain clear loop invariants that describe the partial progress and preserve the array state throughout the computation.

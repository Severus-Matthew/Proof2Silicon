            }
          }
        case "mirror" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            var mirrored := top + ReverseString(top);
            stack := stack + [mirrored];
          }
        case "assign" =>
          if |stack| >= 2 {

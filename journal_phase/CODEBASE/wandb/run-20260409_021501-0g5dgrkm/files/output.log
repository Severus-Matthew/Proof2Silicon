```dafny
module Main {
  // Helper function to check if a number is prime (simplified version)
  function isPrime(n: int): bool
    requires n > 1
  {
    if n == 2 then true
    else if n % 2 == 0 then false
    else
      // Check odd divisors up to sqrt(n)
      forall k: int | 3 <= k <= n && k * k <= n && k % 2 == 1 :: n % k != 0
  }

  // Function to compute modular exponentiation
  function modExp(base: int, exp: int, mod: int): (result: int)
    requires mod > 0
    ensures 0 <= result < mod
  {
    if exp == 0 then 1
    else if exp % 2 == 0 then
      var half := modExp(base, exp / 2, mod);
      (half * half) % mod
    else
      (base * modExp(base, exp - 1, mod)) % mod
  }

  // Function to compute the greatest common divisor
  function gcd(a: int, b: int): int
    requires a >= 0 && b >= 0
    decreases if a > b then a else b
  {
    if b == 0 then a
    else gcd(b, a % b)
  }

  // Function to check if two numbers are coprime
  function areCoprime(a: int, b: int): bool
  {
    gcd(a, b) == 1
  }

  // Extended Euclidean algorithm
  function extendedGcd(a: int, b: int): (g: int, x: int, y: int)
    requires a >= 0 && b >= 0
    ensures g == gcd(a, b)
    ensures a * x + b * y == g
  {
    if b == 0 then (a, 1, 0)
    else {
      var (g1, x1, y1) := extendedGcd(b, a % b);
      (g1, y1, x1 - (a / b) * y1)
    }
  }

  // Function to find modular inverse using extended Euclidean algorithm
  function modInverse(a: int, m: int): (result: int)
    requires m > 0 && areCoprime(a, m)
    ensures 0 <= result < m
    ensures (a * result) % m == 1
  {
    var (g, x, _) := extendedGcd(a, m);
    // Since a and m are coprime, g should be 1
    var r := (x % m + m) % m;
    r
  }

  // Function to compute modular inverse modulo a prime
  // For prime modulus, we can use Fermat's Little Theorem
  function modInversePrime(a: int, p: int): (result: int)
    requires p > 1 && isPrime(p)
    requires a % p != 0  // a is not divisible by p
    ensures 0 <= result < p
    ensures (a * result) % p == 1
  {
    // Using Fermat's Little Theorem: a^(p-1) ≡ 1 (mod p)
    // Therefore, a^(p-2) ≡ a^(-1) (mod p)
    modExp(a, p-2, p)
  }

  // Method to verify modular inverse properties for prime modulus
  method verifyModularInversePrime(a: int, p: int) returns (valid: bool, inverse: int)
    requires p > 1 && isPrime(p)
    requires a > 0 && a < p
    ensures valid ==> (a * inverse) % p == 1
    ensures valid ==> 0 <= inverse < p
  {
    valid := false;
    inverse := 0;

    if a % p != 0 {
      // Compute inverse using Fermat's Little Theorem
      inverse := modInversePrime(a, p);

      // Verify the result
      if (a * inverse) % p == 1 {
        valid := true;
      }
    }
  }

  // Method to demonstrate modular inverse computation
  method demonstrateModularInverse() {
    // Test with a known prime
    var prime := 17;

    print "Testing modular inverses modulo prime ", prime, ":\n";

    // Test several values
    var a1 := 3;
    var (valid1, inv1) := verifyModularInversePrime(a1, prime);
    if valid1 {
      print "  Inverse of ", a1, " mod ", prime, " is ", inv1, "\n";
      print "  Verification: ", a1, " * ", inv1, " mod ", prime, " = ", (a1 * inv1) % prime, "\n";
    }

    var a2 := 5;
    var (valid2, inv2) := verifyModularInversePrime(a2, prime);
    if valid2 {
      print "  Inverse of ", a2, " mod ", prime, " is ", inv2, "\n";
      print "  Verification: ", a2, " * ", inv2, " mod ", prime, " = ", (a2 * inv2) % prime, "\n";
    }

    var a3 := 7;
    var (valid3, inv3) := verifyModularInversePrime(a3, prime);
    if valid3 {
      print "  Inverse of ", a3, " mod ", prime, " is ", inv3, "\n";
      print "  Verification: ", a3, " * ", inv3, " mod ", prime, " = ", (a3 * inv3) % prime, "\n";
    }

    // Test Fermat's Little Theorem
    print "\nTesting Fermat's Little Theorem:\n";
    var base := 3;
    var result := modExp(base, prime-1, prime);
    print "  ", base, "^(", prime, "-1) mod ", prime, " = ", result, "\n";

    if result == 1 {
      print "  Fermat's Little Theorem holds!\n";
    }
  }

  // Main method to run the demonstration
  method Main() {
    demonstrateModularInverse();
  }
}

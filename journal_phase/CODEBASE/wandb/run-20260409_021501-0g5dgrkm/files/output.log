            stack := stack[..|stack| - 1];
            // Remove first character
            if top.Length > 0 {
              stack := stack + [top[1..]];
            }
          }
        case "shr" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            // Take first half

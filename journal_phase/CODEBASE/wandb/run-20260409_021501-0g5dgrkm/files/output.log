  // Parse the input string into tokens
  function ParseTokens(input: string): seq<string>
    ensures |ParseTokens(input)| >= 0
  {
    var tokens: seq<string> := [];
    var current := "";
    var i := 0;

    while i < input.Length
      invariant 0 <= i <= input.Length
      invariant |tokens| >= 0
    {
      var ch := input[i];

      if ch == ':' || ch == '#' || ch == ';' || ch == '~' || ch == '*' ||
         ch == ',' || ch == '.' || ch == '=' || ch == '%' || ch == '!' ||
         ch == '&' || ch == '$' || ch == '@' || ch == '?' || ch == '<' ||
         ch == '>' || ch == '{' || ch == '}' || ch == '[' || ch == ']' ||
         ch == '(' || ch == ')' || ch == '"' || ch == '\'' {
        if current != "" {
          tokens := tokens + [current];
          current := "";
        }
        tokens := tokens + [ch.ToString()];
      } else if ch == ' ' || ch == '\t' || ch == '\n' {
        if current != "" {
          tokens := tokens + [current];
          current := "";
        }
      } else {
        current := current + ch.ToString();
      }

      i := i + 1;
    }

    if current != "" {
      tokens := tokens + [current];
    }

    tokens
  }

  // Process tokens according to the rules
  method ProcessTokens(tokens: seq<string>) returns (result: seq<string>)
    ensures |result| >= 0
  {
    result := [];
    var i := 0;
    var stack: seq<string> := [];

    while i < |tokens|
      invariant 0 <= i <= |tokens|
      invariant |result| >= 0
      invariant |stack| >= 0
    {
      var token := tokens[i];

      match token {
        case "dup" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack + [top];
          }
        case "squ" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            result := result + [top + top];

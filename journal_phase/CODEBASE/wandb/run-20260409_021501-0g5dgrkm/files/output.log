  else if x > 0 then
    VerificationHelper(x - 1, y) + 1
  else
    VerificationHelper(x, y - 1) + 1
}

method ComplexAssertionExample(n: nat) returns (sum: nat)
  requires n >= 0
  ensures sum == n * (n + 1) / 2
  decreases n

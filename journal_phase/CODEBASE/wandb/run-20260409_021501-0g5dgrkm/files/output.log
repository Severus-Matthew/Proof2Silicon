      STORE(0),     // Store accumulator at address 0
      LOAD(2),      // Load 2 into accumulator
      ADD,          // Add memory[1] (which is 0) to accumulator
      STORE(1),     // Store result at address 1
      HALT
    ];

    ExecuteProgram(machine, program);
    result := machine.memory[1];
  }


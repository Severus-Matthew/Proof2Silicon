    i := i + 1;
  }

  assert sum == 6;
}

// Helper function to calculate sum of first n elements
function Sum(arr: array<int>, n: int): int
  requires 0 <= n <= arr.Length
  reads arr
{
  if n == 0 then 0
  else Sum(arr, n-1) + arr[n-1]
}
```


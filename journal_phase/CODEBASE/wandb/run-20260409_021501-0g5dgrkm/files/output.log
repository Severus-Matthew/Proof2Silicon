            stack := stack[..|stack| - 1];
            // Move first char to end
            if top.Length > 0 {
              stack := stack + [top[1..] + top[0].ToString()];
            }
          }
        case "litt" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            // Convert to lowercase
            stack := stack + [top.ToLower()];
          }
        case "gold" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            // Convert to uppercase
            stack := stack + [top.ToUpper()];
          }
        case "pred" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            // Get predecessor character for each char
            var newStr := "";
            for j := 0 to top.Length
              invariant newStr.Length == j
            {
              if j < top.Length {
                var ch := top[j];
                if ch > 'a' && ch <= 'z' {
                  newStr := newStr + ((ch as int - 1) as char).ToString();
                } else if ch > 'A' && ch <= 'Z' {
                  newStr := newStr + ((ch as int - 1) as char).ToString();
                } else {
                  newStr := newStr + ch.ToString();
                }
              }
            }
            stack := stack + [newStr];
          }
        case "sc" =>
          if |stack| > 0 {
            var top := stack[|stack| - 1];
            stack := stack[..|stack| - 1];
            // Get successor character for each char
            var newStr := "";
            for j := 0 to top.Length
              invariant newStr.Length == j
            {
              if j < top.Length {
                var ch := top[j];
                if ch >= 'a' && ch < 'z' {
                  newStr := newStr + ((ch as int + 1) as char).ToString();
                } else if ch >= 'A' && ch < 'Z' {
                  newStr := newStr + ((ch as int + 1) as char).ToString();
                } else {
                  newStr := newStr + ch.ToString();
                }
              }
            }
            stack := stack + [newStr];
          }
        case "fuse" =>
          if |stack| >= 2 {
            var a := stack[|stack| - 2];
            var b := stack[|stack| - 1];
            stack := stack[..|stack| - 2];
            // Interleave characters
            var fused := "";
            var maxLen := if a.Length > b.Length then a.Length else b.Length;
            for j := 0 to maxLen
              invariant fused.Length == 2 * j
            {
              if j < a.Length {
                fused := fused + a[j].ToString();
              }
              if j < b.Length {
                fused := fused + b[j].ToString();
              }
            }
            stack := stack + [fused];
          }
        case "cross" =>
          if |stack| >= 2 {
            var a := stack[|stack| - 2];
            var b := stack[|stack| - 1];
            stack := stack[..|stack| - 2];
            // Swap first characters
            if a.Length > 0 && b.Length > 0 {
              var newA := b[0].ToString() + a[1..];
              var newB := a[0].ToString() + b[1..];
              stack := stack + [newA, newB];
            } else {

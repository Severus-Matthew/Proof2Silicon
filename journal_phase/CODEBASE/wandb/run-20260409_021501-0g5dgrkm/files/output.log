        if 0 <= address < |program| {
          machine.programCounter := address;
        } else {
          machine.programCounter := machine.programCounter + 1;
        }

      case JUMP_IF_ZERO(address) =>
        if machine.accumulator == 0 && 0 <= address < |program| {
          machine.programCounter := address;
        } else {
          machine.programCounter := machine.programCounter + 1;
        }
    }
  }


```dafny
module TextAnalyzer {
  // Main method to analyze the text
  method AnalyzeText(text: string) returns (wordCount: nat, atomicCount: nat, neonCount: nat, inertCount: nat, silverCount: nat, anomalCount: nat)
    ensures wordCount >= 0
    ensures atomicCount >= 0
    ensures neonCount >= 0
    ensures inertCount >= 0
    ensures silverCount >= 0
    ensures anomalCount >= 0
  {
    // Initialize counters
    wordCount := 0;
    atomicCount := 0;
    neonCount := 0;
    inertCount := 0;
    silverCount := 0;
    anomalCount := 0;

    var i := 0;
    var currentWord := "";

    // Process each character in the text
    while i < |text|
      invariant 0 <= i <= |text|
      invariant wordCount >= 0
      invariant atomicCount >= 0
      invariant neonCount >= 0
      invariant inertCount >= 0
      invariant silverCount >= 0
      invariant anomalCount >= 0
    {
      var ch := text[i];

      if ch == ' ' || ch == '\n' || ch == '\t' || ch == '~' {
        // End of word
        if |currentWord| > 0 {
          wordCount := wordCount + 1;

          // Check for specific keywords
          if currentWord == "Atomic" || currentWord == "atomic" {
            atomicCount := atomicCount + 1;
          }
          if currentWord == "Neon" || currentWord == "neon" {
            neonCount := neonCount + 1;
          }
          if currentWord == "inert" {
            inertCount := inertCount + 1;
          }
          if currentWord == "silver" {
            silverCount := silverCount + 1;
          }
          if currentWord == "anom" || currentWord == "anomal" {
            anomalCount := anomalCount + 1;
          }

          currentWord := "";
        }
      } else {
        // Add character to current word
        currentWord := currentWord + [ch];
      }

      i := i + 1;
    }

    // Check last word if text doesn't end with whitespace
    if |currentWord| > 0 {
      wordCount := wordCount + 1;

      if currentWord == "Atomic" || currentWord == "atomic" {
        atomicCount := atomicCount + 1;
      }
      if currentWord == "Neon" || currentWord == "neon" {
        neonCount := neonCount + 1;
      }
      if currentWord == "inert" {
        inertCount := inertCount + 1;
      }
      if currentWord == "silver" {
        silverCount := silverCount + 1;
      }
      if currentWord == "anom" || currentWord == "anomal" {
        anomalCount := anomalCount + 1;
      }
    }
  }

  // Helper method to find patterns in the text
  method FindPatterns(text: string) returns (hasAtomicNeon: bool, hasSilverInert: bool, patternCount: nat)
    ensures patternCount >= 0
  {
    hasAtomicNeon := false;
    hasSilverInert := false;
    patternCount := 0;

    var i := 0;
    while i < |text| - 6  // Need at least 6 characters for "Atomic"
      invariant 0 <= i <= |text|
      invariant patternCount >= 0
    {
      // Check for "Atomic" followed by "Neon"
      if i + 11 < |text| && text[i..i+6] == "Atomic" {
        // Look for "Neon" after "Atomic"
        var j := i + 6;
        while j < |text| - 3 && j < i + 50  // Search within 50 chars
          invariant i + 6 <= j <= |text|
        {
          if j + 3 < |text| && text[j..j+4] == "Neon" {
            hasAtomicNeon := true;
            patternCount := patternCount + 1;
            break;
          }
          j := j + 1;
        }
      }

      // Check for "silver" followed by "inert"
      if i + 10 < |text| && text[i..i+6] == "silver" {
        // Look for "inert" after "silver"
        var j := i + 6;
        while j < |text| - 4 && j < i + 50  // Search within 50 chars
          invariant i + 6 <= j <= |text|
        {

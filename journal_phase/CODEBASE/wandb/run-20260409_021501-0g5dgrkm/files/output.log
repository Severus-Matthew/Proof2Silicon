    IsRing() &&
    (forall S :: (forall x :: x in S ==> IsElement(x)) && S != {} ==>
        exists m :: m in S &&
        (forall x :: x in S ==>
            exists p :: IsElement(p) && p != Zero() &&
            (Multiply(p, x) == m || x == m)))
  }
}


      reads this
    {
      programCounter >= 0 &&
      (halted || programCounter < |memory|)
    }

    constructor Init(memSize: int)
      ensures Valid()
    {
      memory := seq(memSize, _ => 0);
      accumulator := 0;
      programCounter := 0;
      halted := false;
    }

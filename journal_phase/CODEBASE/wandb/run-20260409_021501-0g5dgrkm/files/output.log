```dafny
method BinarySearch(arr: array<int>, key: int) returns (index: int)
  requires arr != null
  requires forall i, j :: 0 <= i < j < arr.Length ==> arr[i] <= arr[j]
  ensures -1 <= index < arr.Length
  ensures index >= 0 ==> arr[index] == key
  ensures index == -1 ==> forall i :: 0 <= i < arr.Length ==> arr[i] != key
{
  var low := 0;
  var high := arr.Length;
  index := -1;

  while low < high
    invariant 0 <= low <= high <= arr.Length
    invariant index == -1 || (0 <= index < arr.Length && arr[index] == key)
    invariant forall i :: 0 <= i < low ==> arr[i] < key
    invariant forall i :: high <= i < arr.Length ==> arr[i] > key
    decreases high - low
  {
    var mid := low + (high - low) / 2;

    if arr[mid] == key {
      index := mid;
      return;

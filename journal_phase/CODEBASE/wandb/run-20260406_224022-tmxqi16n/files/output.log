method Main() {
  // Example boarding pass: row = 11, column = 83
  var rowBinary: seq<int> := [1, 0, 0, 0, 1, 1];  // Binary for 11: 001011
  var colBinary: seq<int> := [1, 0, 1, 0, 0, 1, 1]; // Binary for 83: 1010011 (7-bit, needs adjustment)

  // For 6-bit representation, we need exactly 6 bits
  // Let's use proper 6-bit representations
  var row6bit: seq<int> := [0, 0, 1, 0, 1, 1];  // 001011 = 11
  var col6bit: seq<int> := [1, 0, 1, 0, 0, 1];   // 101001 = 41 (not 83, since 83 needs 7 bits)

  // Actually, 83 in 6-bit would be truncated, so let's use a valid 6-bit example
  var validCol6bit: seq<int> := [1, 0, 1, 0, 1, 1]; // 101011 = 43

  print "Row binary: ", row6bit, "\n";
  print "Column binary: ", validCol6bit, "\n";

  var rowDecimal := BinaryToDecimal(row6bit);
  var colDecimal := BinaryToDecimal(validCol6bit);

  print "Row decimal: ", rowDecimal, "\n";
  print "Column decimal: ", colDecimal, "\n";

  // Check if values are valid (0-63 for 6-bit)
  if rowDecimal >= 0 && rowDecimal < 64 && colDecimal >= 0 && colDecimal < 64 {
    print "Valid boarding pass\n";

    // Calculate seat position using zigzag pattern
    var seatNumber := CalculateZigzagSeat(rowDecimal, colDecimal);
    print "Zigzag seat number: ", seatNumber, "\n";
  } else {
    print "Invalid boarding pass - values out of range\n";
  }
}

// Convert binary sequence to decimal
function BinaryToDecimal(binary: seq<int>): int
  requires |binary| > 0
  ensures BinaryToDecimal(binary) >= 0
{
  if |binary| == 0 then
    0
  else
    BinaryToDecimal(binary[1..]) * 2 + binary[0]
}

// Calculate seat number using zigzag pattern
// Assuming zigzag means: even rows go left to right, odd rows go right to left
function CalculateZigzagSeat(row: int, col: int): int
  requires row >= 0 && row < 64
  requires col >= 0 && col < 64
{
  if row % 2 == 0 then
    // Even row: left to right
    row * 64 + col
  else
    // Odd row: right to left
    row * 64 + (63 - col)
}

// Alternative: If zigzag refers to a different pattern, here's another interpretation
// Zigzag through the entire grid
function CalculateZigzagSeatAlt(row: int, col: int): int
  requires row >= 0 && row < 64
  requires col >= 0 && col < 64
{
  var n := 64; // Grid size
  if (row % 2 == 0) {
    // Even rows go left to right
    row * n + col
  } else {
    // Odd rows go right to left
    row * n + (n - 1 - col)
  }
}

// Validate binary sequence (must contain only 0s and 1s)
predicate IsValidBinary(binary: seq<int>)
{
  forall i :: 0 <= i < |binary| ==> (binary[i] == 0 || binary[i] == 1)
}

// Test the binary conversion
method TestBinaryConversion() {
  var test1: seq<int> := [1, 0, 1, 0]; // 1010 binary = 10 decimal
  var result1 := BinaryToDecimal(test1);
  print "Binary [1,0,1,0] = ", result1, " (expected: 10)\n";
  assert result1 == 10;

  var test2: seq<int> := [1, 1, 1, 1]; // 1111 binary = 15 decimal
  var result2 := BinaryToDecimal(test2);
  print "Binary [1,1,1,1] = ", result2, " (expected: 15)\n";
  assert result2 == 15;

  var test3: seq<int> := [0, 0, 1, 0, 1, 1]; // 001011 binary = 11 decimal
  var result3 := BinaryToDecimal(test3);
  print "Binary [0,0,1,0,1,1] = ", result3, " (expected: 11)\n";
  assert result3 == 11;
}

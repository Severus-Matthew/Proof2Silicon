    if arr[i] == target {
      index := i;
      return;
    }
    i := i + 1;
  }
  index := -1;
}

method TestLinearSearch()
{
  var arr := new int[5][1, 2, 3, 4, 5];
  var index: int;

  // Test case 1: element exists
  index := LinearSearch(arr, 0, 4, 3);
  assert index == 2;

  // Test case 2: element doesn't exist
  index := LinearSearch(arr, 0, 4, 6);
  assert index == -1;

  // Test case 3: search in subrange
  index := LinearSearch(arr, 1, 3, 1);
  assert index == -1;  // 1 is at index 0, outside range [1,3]

  index := LinearSearch(arr, 1, 3, 3);
  assert index == 2;
}
```

Key fixes made:
1. **Fixed array length access**: Changed `arr.length` to `arr.Length` (Dafny uses capital L)
2. **Fixed quantifier syntax**: Changed `forall i: int: left <= i <= right` to `forall i: int :: left <= i <= right`
3. **Added proper loop invariants**:
   - `left <= i <= right + 1` tracks the loop counter
   - `forall j: int :: left <= j < i ==> arr[j] != target` ensures all elements before `i` don't match
   - `index == -1` ensures we haven't found the target yet (until we do)
4. **Fixed postconditions**:
   - When `index == -1`, all elements in range don't match
   - When `index != -1`, it's within bounds and points to the target
5. **Added test method** to verify the implementation works correctly
6. **Fixed return logic**: When target is found, we return immediately with `index = i`

The implementation now correctly searches for `target` in the subarray `arr[left..right]` and returns either the index where it's found or -1 if not found.

```dafny
method LinearSearch(arr: array<int>, left: int, right: int, target: int) returns (index: int)
  requires arr != null
  requires 0 <= left <= right < arr.Length
  ensures -1 <= index < arr.Length
  ensures index == -1 ==> (forall i: int :: left <= i <= right ==> arr[i] != target)
  ensures index != -1 ==> (left <= index <= right && arr[index] == target)
{
  var i: int := left;
  index := -1;

  while i <= right
    invariant left <= i <= right + 1
    invariant forall j: int :: left <= j < i ==> arr[j] != target
    invariant index == -1

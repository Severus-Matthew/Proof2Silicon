    invariant 0 <= i <= |sequence|
    invariant index == -1 ==> forall j :: 0 <= j < i ==> sequence[j] != target
    invariant index != -1 ==> (0 <= index < i && sequence[index] == target)
  {
    if sequence[i] == target && index == -1 {
      index := i;
    }
    i := i + 1;
  }
}

```dafny
method SearchRecursive(sequence: seq<int>, target: int) returns (index: int)
  requires |sequence| > 0
  requires forall i, j :: 0 <= i < j < |sequence| ==> sequence[i] <= sequence[j]
  requires exists k :: 0 <= k < |sequence| && sequence[k] == target
  ensures 0 <= index < |sequence|
  ensures sequence[index] == target
{
  index := SearchRecursiveHelper(sequence, target, 0, |sequence| - 1);
}

method SearchRecursiveHelper(sequence: seq<int>, target: int, low: int, high: int) returns (index: int)
  requires 0 <= low <= high < |sequence|
  requires forall i, j :: 0 <= i < j < |sequence| ==> sequence[i] <= sequence[j]
  requires exists k :: low <= k <= high && sequence[k] == target
  ensures low <= index <= high
  ensures sequence[index] == target
{
  if low == high {
    index := low;
    return;
  }

  var mid := low + (high - low) / 2;

  if sequence[mid] == target {
    index := mid;
  } else if sequence[mid] < target {
    index := SearchRecursiveHelper(sequence, target, mid + 1, high);
  } else {
    index := SearchRecursiveHelper(sequence, target, low, mid - 1);
  }
}

method SearchLoop(sequence: seq<int>, target: int) returns (index: int)
  requires |sequence| > 0
  requires forall i, j :: 0 <= i < j < |sequence| ==> sequence[i] <= sequence[j]
  requires exists k :: 0 <= k < |sequence| && sequence[k] == target
  ensures 0 <= index < |sequence|
  ensures sequence[index] == target
{
  var low := 0;
  var high := |sequence| - 1;

  while low <= high
    invariant 0 <= low <= high + 1 <= |sequence|
    invariant forall i :: 0 <= i < low ==> sequence[i] < target
    invariant forall i :: high < i < |sequence| ==> sequence[i] > target
    invariant exists k :: low <= k <= high && sequence[k] == target
  {
    var mid := low + (high - low) / 2;

    if sequence[mid] == target {
      index := mid;
      return;
    } else if sequence[mid] < target {
      low := mid + 1;
    } else {
      high := mid - 1;
    }
  }

  // This point should never be reached due to the precondition
  // that the target exists in the sequence
  index := -1;
}
```

This implementation includes:

1. **SearchRecursive**: The main recursive method that calls the helper with the full sequence range.

2. **SearchRecursiveHelper**: The actual recursive binary search implementation that:
   - Checks the base case (low == high)
   - Calculates the midpoint
   - Recursively searches either the left or right half based on comparison

3. **SearchLoop**: An iterative binary search implementation using a while loop with proper invariants.

Key features:
- Both methods require the sequence to be non-empty and sorted
- Both require that the target exists in the sequence (unique per problem statement)
- Both ensure they return a valid index where the target is found
- The loop version includes loop invariants to help Dafny verify correctness
- Uses integer division for midpoint calculation to avoid overflow

The invariants in the loop version ensure that:
1. The search bounds remain valid
2. All elements before 'low' are less than the target
3. All elements after 'high' are greater than the target
4. The target must exist within the current search bounds

This implementation should satisfy the requirements for binary search on a sorted sequence with a unique target value.

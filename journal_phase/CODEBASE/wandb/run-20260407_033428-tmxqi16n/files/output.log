```dafny
method CountNonNegative(arr: array<int>) returns (count: int)
  requires arr.Length >= 1
  ensures 0 <= count <= arr.Length
  ensures forall i :: 0 <= i < arr.Length && arr[i] >= 0 ==>
          (exists j :: 0 <= j < arr.Length && j < count && /* j tracks position of non-negative */)
  ensures count == |{i | 0 <= i < arr.Length && arr[i] >= 0}|
{
  count := 0;
  var i: int := 0;

  while i < arr.Length
    invariant 0 <= i <= arr.Length
    invariant 0 <= count <= i
    invariant count == |{j | 0 <= j < i && arr[j] >= 0}|
    decreases arr.Length - i
  {
    if arr[i] >= 0 {
      count := count + 1;
    }
    i := i + 1;
  }
}

method FindOccurrences(arr: array<int>) returns (numTracks: int)
  requires arr.Length >= 1
  requires forall i :: 0 <= i < arr.Length ==> arr[i] >= 0  // All elements are non-negative
  ensures numTracks == arr.Length  // Since all are non-negative
{
  // With the precondition that all elements are non-negative,
  // we can simply return the array length
  numTracks := arr.Length;
}

method ProcessArray(arr: array<int>) returns (nonNegativeCount: int, hasZero: bool)
  requires arr.Length >= 1
  ensures 0 <= nonNegativeCount <= arr.Length
  ensures nonNegativeCount == |{i | 0 <= i < arr.Length && arr[i] >= 0}|
  ensures hasZero == (exists i :: 0 <= i < arr.Length && arr[i] == 0)
{
  nonNegativeCount := 0;
  hasZero := false;
  var i: int := 0;

  while i < arr.Length
    invariant 0 <= i <= arr.Length
    invariant 0 <= nonNegativeCount <= i
    invariant nonNegativeCount == |{j | 0 <= j < i && arr[j] >= 0}|
    invariant hasZero == (exists j :: 0 <= j < i && arr[j] == 0)
    decreases arr.Length - i
  {
    if arr[i] >= 0 {
      nonNegativeCount := nonNegativeCount + 1;
    }
    if arr[i] == 0 {
      hasZero := true;
    }
    i := i + 1;
  }
}
```


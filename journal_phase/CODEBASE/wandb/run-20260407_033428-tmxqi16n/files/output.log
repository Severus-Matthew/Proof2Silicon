method LinearSearch(arr: array<int>, key: int) returns (index: int)
  requires arr != null
  ensures -1 <= index && index < arr.Length
  ensures index >= 0 ==> arr[index] == key
  ensures index == -1 ==> (forall i :: 0 <= i < arr.Length ==> arr[i] != key)
{
  index := 0;

  while index < arr.Length
    invariant 0 <= index <= arr.Length
    invariant forall i :: 0 <= i < index ==> arr[i] != key
  {
    if arr[index] == key {
      return;
    }
    index := index + 1;
  }

  index := -1;
}
```


Looking at this problem, I need to implement two search methods in Dafny: one recursive and one iterative. Both should search for a target value in a sequence and return its index, or -1 if not found. The key requirements are:

1. **Preconditions**: Ensure sequence is not empty
2. **Loop/Recursion Invariants**: Maintain proper invariants for verification
3. **Postconditions**: Ensure correct return value
4. **Readability**: Clear, elegant code with optimal complexity

Here's my solution:

```dafny
method SearchRecursive(sequence: seq<int>, target: int) returns (index: int)
  requires |sequence| > 0  // Precondition: sequence is not empty
  ensures index == -1 || (0 <= index < |sequence| && sequence[index] == target)
  ensures index == -1 ==> forall i :: 0 <= i < |sequence| ==> sequence[i] != target
  ensures index != -1 ==> sequence[index] == target
{
  // Helper recursive method with proper invariants
  index := SearchRecursiveHelper(sequence, target, 0, |sequence| - 1);
}

method SearchRecursiveHelper(sequence: seq<int>, target: int, low: int, high: int) returns (index: int)
  requires 0 <= low <= high < |sequence|
  ensures index == -1 || (low <= index <= high && sequence[index] == target)
  ensures index == -1 ==> forall i :: low <= i <= high ==> sequence[i] != target
  decreases high - low  // Termination metric
{
  if low == high {
    // Base case: single element
    if sequence[low] == target {
      index := low;
    } else {
      index := -1;
    }
  } else {
    var mid := low + (high - low) / 2;

    // Recursively search left half
    var leftResult := SearchRecursiveHelper(sequence, target, low, mid);

    if leftResult != -1 {
      index := leftResult;
    } else {
      // Recursively search right half
      index := SearchRecursiveHelper(sequence, target, mid + 1, high);
    }
  }
}

method SearchLoop(target: int, sequence: seq<int>) returns (index: int)
  requires |sequence| > 0  // Precondition: sequence is not empty
  ensures index == -1 || (0 <= index < |sequence| && sequence[index] == target)
  ensures index == -1 ==> forall i :: 0 <= i < |sequence| ==> sequence[i] != target
{

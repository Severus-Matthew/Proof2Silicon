// LinearSearch0: Returns the index of the first element in arr that satisfies predicate F
// Returns -1 if no such element exists
method LinearSearch0(arr: array<int>, key: int, F: (int, int) -> bool) returns (index: int)
  requires arr != null
  ensures index == -1 ==> (forall i :: 0 <= i < arr.Length ==> !F(arr[i], key))
  ensures 0 <= index < arr.Length ==> F(arr[index], key) && (forall j :: 0 <= j < index ==> !F(arr[j], key))
  decreases arr.Length
{
  index := 0;
  while index < arr.Length
    invariant 0 <= index <= arr.Length
    invariant forall j :: 0 <= j < index ==> !F(arr[j], key)
    decreases arr.Length - index
  {
    if F(arr[index], key) {
      return;
    }
    index := index + 1;
  }
  index := -1;
}

// LinearSearch1: Returns the index of the first element in arr that satisfies predicate F
// Uses a different search pattern (from both ends) but maintains same specification
method LinearSearch1(arr: array<int>, key: int, F: (int, int) -> bool) returns (index: int)
  requires arr != null
  ensures index == -1 ==> (forall i :: 0 <= i < arr.Length ==> !F(arr[i], key))
  ensures 0 <= index < arr.Length ==> F(arr[index], key) && (forall j :: 0 <= j < index ==> !F(arr[j], key))
  decreases arr.Length
{
  var left: int := 0;
  var right: int := arr.Length - 1;
  index := -1;

  while left <= right
    invariant 0 <= left <= arr.Length
    invariant -1 <= right < arr.Length
    invariant left <= right + 1
    invariant index == -1 ==> (forall j :: 0 <= j < left ==> !F(arr[j], key))
    invariant index != -1 ==> (0 <= index < arr.Length && F(arr[index], key) && (forall j :: 0 <= j < index ==> !F(arr[j], key)))
    decreases right - left
  {
    if F(arr[left], key) {
      index := left;
      return;
    }
    if left != right && F(arr[right], key) {
      // Check if this is the first occurrence by scanning from left
      var temp: int := left + 1;
      while temp < right
        invariant left < temp <= right
        invariant forall j :: 0 <= j < temp ==> !F(arr[j], key)
        decreases right - temp
      {
        if F(arr[temp], key) {
          index := temp;
          return;
        }
        temp := temp + 1;
      }
      index := right;
      return;
    }
    left := left + 1;
    right := right - 1;
  }
}

// Helper predicate function examples for testing
function GreaterThanOrEqual(x: int, y: int): bool
{
  x >= y
}

function EqualTo(x: int, y: int): bool
{
  x == y
}

// Test method to verify both implementations behave identically
method TestLinearSearch()
{
  var arr1 := new int[5][1, 3, 5, 7, 9];
  var arr2 := new int[4][2, 4, 6, 8];
  var arr3 := new int[0];

  var idx0, idx1: int;

  // Test 1: Search for element >= 5
  idx0 := LinearSearch0(arr1, 5, GreaterThanOrEqual);
  idx1 := LinearSearch1(arr1, 5, GreaterThanOrEqual);
  assert idx0 == 2 && idx1 == 2;

  // Test 2: Search for element == 4
  idx0 := LinearSearch0(arr1, 4, EqualTo);
  idx1 := LinearSearch1(arr1, 4, EqualTo);
  assert idx0 == -1 && idx1 == -1;

  // Test 3: Search in empty array
  idx0 := LinearSearch0(arr3, 1, GreaterThanOrEqual);
  idx1 := LinearSearch1(arr3, 1, GreaterThanOrEqual);
  assert idx0 == -1 && idx1 == -1;

  // Test 4: Search for first even number >= 3
  function IsEvenAndGE(x: int, y: int): bool {
    x % 2 == 0 && x >= y
  }
  idx0 := LinearSearch0(arr2, 3, IsEvenAndGE);
  idx1 := LinearSearch1(arr2, 3, IsEvenAndGE);
  assert idx0 == 1 && idx1 == 1; // First element >= 3 and even is 4 at index 1
}

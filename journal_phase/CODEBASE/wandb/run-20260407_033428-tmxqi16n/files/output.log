method CalculateAvailableDesserts(arr: array<int>, startIndex: int, endIndex: int) returns (numAvailableDesserts: int)
  requires arr != null
  requires 0 <= startIndex <= endIndex <= arr.Length
  requires forall i :: startIndex <= i < endIndex ==> arr[i] >= 0
  ensures numAvailableDesserts >= 0
{
  var remainingSum: int := 0;
  var count: int := 0;

  // Calculate initial sum of non-negative integers
  var i: int := startIndex;
  while i < endIndex
    invariant startIndex <= i <= endIndex
    invariant remainingSum >= 0
    invariant count >= 0
  {
    remainingSum := remainingSum + arr[i];
    i := i + 1;
  }

  // Step through array, subtracting non-negative integers
  i := startIndex;
  while i < endIndex && remainingSum > 0
    invariant startIndex <= i <= endIndex
    invariant remainingSum >= 0
    invariant count >= 0
  {
    if arr[i] > 0 {
      remainingSum := remainingSum - arr[i];
      count := count + 1;

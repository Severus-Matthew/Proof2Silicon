method SearchLastOccurrence<T(==)>(seq: seq<T>, target: T) returns (index: int)
  requires sorted(seq)  // Precondition: The sequence must be sorted
  ensures index >= -1 && index < |seq|
  ensures index >= 0 ==> seq[index] == target
  ensures index >= 0 ==> (forall i :: index < i < |seq| ==> seq[i] != target)
  ensures index == -1 ==> (forall i :: 0 <= i < |seq| ==> seq[i] != target)

// Define a Pokemon type
class Pokemon {
  var name: string

  constructor(n: string) {
    name := n;
  }
}

// Method to find a Pokemon by name in the pokedex
method FindPokemon(pokedex: seq<Pokemon>, nameToFind: string) returns (found: Pokemon?)
  // Precondition: pokedex is not null
  requires pokedex != null
  // Postcondition: if found is not null, its name matches nameToFind
  ensures found != null ==> found.name == nameToFind
  // Postcondition: if found is null, no Pokemon with nameToFind exists in pokedex
  ensures found == null ==> forall i | 0 <= i < |pokedex| :: pokedex[i].name != nameToFind
{
  var index_to_visit := 0;

  // Loop through the pokedex
  while index_to_visit < |pokedex|
    invariant 0 <= index_to_visit <= |pokedex|
    invariant forall i | 0 <= i < index_to_visit :: pokedex[i].name != nameToFind
  {
    if pokedex[index_to_visit].name == nameToFind {
      // Found the Pokemon
      found := pokedex[index_to_visit];
      return;
    }
    index_to_visit := index_to_visit + 1;
  }

  // Pokemon not found
  found := null;
}

// Method to compute the sum of integers from 1 to n using iteration
method SumIntsLoop(n: int) returns (sum: int)
  // Precondition: n is a non-negative integer
  requires n >= 0
  // Postcondition: sum equals the sum of integers from 1 to n
  ensures sum == n * (n + 1) / 2
{
  sum := 0;
  var i := 1;

  while i <= n
    invariant 0 <= i <= n + 1
    invariant sum == (i - 1) * i / 2
    decreases n - i
  {
    sum := sum + i;
    i := i + 1;
  }
}

// Method to verify that the sum of integers from 1 to n computes correctly
method CompareSumInts(n: int) returns (equal: bool)
  // Precondition: n is non-negative
  requires n >= 0
  // Postcondition: returns true if both methods give the same result
  ensures equal == (old(SumIntsLoop(n)) == n * (n + 1) / 2)
{
  var sumUsingSumIntsLoop := SumIntsLoop(n);
  var sumUsingFormula := n * (n + 1) / 2;
  equal := sumUsingSumIntsLoop == sumUsingFormula;
}

// Method to combine the sum using the iteration methods and compare against the formula
method SumIntsComparisonTest(n: int) returns (equal: bool)
  // Precondition: n is non-negative
  requires n >= 0
  // Postcondition: returns true if the iterative sum matches the formula
  ensures equal == (old(SumIntsLoop(n)) == n * (n + 1) / 2)
{
  equal := CompareSumInts(n);
}

// Main method to test the methods
method Main()
{

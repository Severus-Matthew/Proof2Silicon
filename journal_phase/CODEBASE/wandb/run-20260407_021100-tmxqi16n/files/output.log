Here's my implementation:

```dafny
method LinearSearch<T>(array: array<T>, P: (T) -> bool) returns (index: int, index2: int)
  requires array != null
  ensures index == -1 ==> index2 == -1
  ensures index != -1 ==> 0 <= index <= index2 < array.Length
  ensures index != -1 ==> P(array[index]) && P(array[index2])
  ensures index != -1 ==> (forall j | 0 <= j < index :: !P(array[j]))
  ensures index != -1 ==> (forall j | index2 < j < array.Length :: !P(array[j]))
{
  index := -1;
  index2 := -1;
  var i := 0;

  while i < array.Length

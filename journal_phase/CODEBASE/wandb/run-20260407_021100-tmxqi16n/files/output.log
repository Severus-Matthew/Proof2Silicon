method FindPokemonByName(pokedex: Pokedex, nameToFind: string) returns (foundPokemon: Pokemon?, index: int)
  // Preconditions
  requires |pokedex| > 0
  // Termination measure - decreases with each recursive call
  decreases |pokedex|
  // Postconditions
  ensures index >= -1 && index < |pokedex|
  ensures foundPokemon == null || foundPokemon.name == nameToFind

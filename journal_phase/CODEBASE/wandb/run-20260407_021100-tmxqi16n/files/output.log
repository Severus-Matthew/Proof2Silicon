module Test {
  method LinearSearch<T>(array: seq<T>, P: (T) -> bool) returns (index: int)
    requires |array| > 0
    ensures 0 <= index < |array| ==> P(array[index])
    ensures index == -1 ==> forall i | 0 <= i < |array| :: !P(array[i])
    ensures index != -1 ==> forall i | 0 <= i < index :: !P(array[i])
  {
    index := -1;
    var i := 0;

    while i < |array|
      invariant 0 <= i <= |array|
      invariant index == -1 ==> forall j | 0 <= j < i :: !P(array[j])
      invariant index != -1 ==> (0 <= index < i && P(array[index]) &&
                                forall j | 0 <= j < index :: !P(array[j]))
    {
      if P(array[i]) && index == -1 {
        index := i;
      }
      i := i + 1;
    }
  }

  predicate P1(x: int) {
    x % 2 == 0 && x / 2 == 4
  }

  predicate P2(x: int) {
    x % 2 == 0
  }

  predicate P3(x: int) {
    x % 2 == 0 && x / 2 == 4
  }

  method TestLinearSearch() {
    var array1 := [1, 3, 4, 7, 8];
    var index1 := LinearSearch(array1, P1); // Should return -1 since no element satisfies P1

    // Verify that index1 is -1 (no element satisfies P1)
    assert index1 == -1;

    var array2 := [2, 4, 6, 8];
    var index2 := LinearSearch(array2, P2); // Should succeed and return 0 (first even number)

    // Verify that the found element is even
    assert 0 <= index2 < |array2|;
    assert array2[index2] % 2 == 0;
    assert array2[index2] == 2; // First even number in array2

    var index3 := LinearSearch(array2, P3); // Should return -1 since no element satisfies P3

    // Verify that index3 is -1
    assert index3 == -1;

    // Additional test: search for number 8 specifically
    predicate P4(x: int) {
      x == 8
    }

    var index4 := LinearSearch(array2, P4);
    assert 0 <= index4 < |array2|;
    assert array2[index4] == 8;
  }

  method Helper(array: seq<int>, P: (int) -> bool) returns (index: int)
    requires |array| > 0
    ensures 0 <= index < |array| ==> P(array[index])
    ensures index == -1 ==> forall i | 0 <= i < |array| :: !P(array[i])
  {
    index := LinearSearch(array, P);
  }
}
```


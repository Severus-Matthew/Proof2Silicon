method BinarySearchLastOccurrence(seq: seq<int>, target: int) returns (index: int)
  requires sorted(seq)
  requires |seq| > 0
  ensures 0 <= index <= |seq|
  ensures index < |seq| ==> seq[index] == target
  ensures forall i :: index < i < |seq| ==> seq[i] != target
  ensures index == |seq| ==> forall i :: 0 <= i < |seq| ==> seq[i] != target
{
  // Initialize search bounds
  var low := 0;
  var high := |seq| - 1;
  index := |seq|; // Default: target not found

  // Predicate to check if sequence is sorted
  predicate sorted(s: seq<int>) {
    forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
  }

  while low <= high
    invariant 0 <= low <= high + 1 <= |seq|
    invariant forall i :: 0 <= i < low ==> seq[i] != target
    invariant forall i :: high < i < |seq| ==> seq[i] != target
    invariant index == |seq| || (0 <= index <= high && seq[index] == target)
    decreases high - low
  {
    var mid := low + (high - low) / 2;

    if seq[mid] <= target {
      // Target might be at mid or to the right
      if seq[mid] == target {
        index := mid; // Found target, but continue searching right
      }
      low := mid + 1;
    } else {
      // Target must be to the left
      high := mid - 1;
    }
  }

  // Post-loop: if we found the target, find its last occurrence
  if index < |seq| {
    // Search forward from index to find last occurrence
    var i := index;
    while i < |seq| && seq[i] == target
      invariant index <= i <= |seq|
      invariant forall j :: index <= j < i ==> seq[j] == target
      decreases |seq| - i
    {
      i := i + 1;
    }
    index := i - 1;
  }
}

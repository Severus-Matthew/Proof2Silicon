function CrossProduct(v1: Vector3, v2: Vector3): Vector3
  (v1.y * v2.z - v1.z * v2.y,
   v1.z * v2.x - v1.x * v2.z,
   v1.x * v2.y - v1.y * v2.x)

function ScalarTripleProduct(a: Vector3, b: Vector3, c: Vector3): real
  DotProduct(a, CrossProduct(b, c))


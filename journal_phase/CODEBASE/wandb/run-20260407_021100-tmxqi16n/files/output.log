```dafny
method SearchRecursive(a: seq<real>, x: real) returns (k: int)
  requires |a| > 0
  requires forall i, j :: 0 <= i < j < |a| ==> a[i] >= a[j]  // non-increasing
  ensures 0 <= k <= |a|
  ensures forall i :: 0 <= i < k ==> a[i] >= x
  ensures forall i :: k <= i < |a| ==> a[i] < x
  decreases |a|
{
  if |a| == 1 {
    if a[0] >= x {
      k := 1;
    } else {
      k := 0;
    }
  } else {
    var mid := |a| / 2;
    var left := a[..mid];
    var right := a[mid..];

    if a[mid] >= x {
      // x belongs in right half or after mid
      var kRight := SearchRecursive(right, x);
      k := mid + kRight;
    } else {
      // x belongs in left half
      k := SearchRecursive(left, x);
    }
  }
}

method SearchLoop(a: seq<real>, x: real) returns (k: int)
  requires |a| > 0
  requires forall i, j :: 0 <= i < j < |a| ==> a[i] >= a[j]  // non-increasing
  ensures 0 <= k <= |a|
  ensures forall i :: 0 <= i < k ==> a[i] >= x
  ensures forall i :: k <= i < |a| ==> a[i] < x
{
  var left := 0;
  var right := |a|;
  k := 0;

  while left < right
    invariant 0 <= left <= right <= |a|
    invariant forall i :: 0 <= i < left ==> a[i] >= x
    invariant forall i :: right <= i < |a| ==> a[i] < x
  {
    var mid := left + (right - left) / 2;

    if a[mid] >= x {
      left := mid + 1;
    } else {
      right := mid;
    }
  }

  k := left;
}


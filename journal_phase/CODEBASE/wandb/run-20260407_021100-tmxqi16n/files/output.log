module SumInts {
  // Recursive function to compute sum of integers from 1 to n
  function sumInts(n: int): int
    requires n >= 0
    decreases n
  {
    if n == 0 then 0 else n + sumInts(n-1)
  }

  // Mathematical formula for sum of integers from 1 to n
  function formulaSum(n: int): int
    requires n >= 0
  {
    n * (n + 1) / 2
  }

  // Lemma proving the recursive function matches the formula
  lemma sumIntsFormula(n: int)
    requires n >= 0
    ensures sumInts(n) == formulaSum(n)
    decreases n
  {
    if n == 0 {
      // Base case
    } else {
      sumIntsFormula(n-1);
      // Inductive step
      calc {
        sumInts(n);
        n + sumInts(n-1);
        n + formulaSum(n-1);
        n + ((n-1) * n / 2);
        (2*n + (n-1)*n) / 2;
        (2*n + n*n - n) / 2;
        (n*n + n) / 2;
        n*(n+1)/2;
        formulaSum(n);
      }
    }
  }

  // Method that computes sum using a loop and verifies it matches both
  method SumIntsLoop(n: int) returns (sum: int)
    requires n >= 0
    ensures sum == sumInts(n)
    ensures sum == formulaSum(n)
  {
    sum := 0;
    var i := 0;

    while i <= n
      invariant 0 <= i <= n+1
      invariant sum == sumInts(i-1)
      decreases n - i
    {
      if i < n {
        sum := sum + i;
      }
      i := i + 1;
    }

    // Apply the lemma to prove the postconditions
    sumIntsFormula(n);
  }

  // Main method to test with n = 100
  method Main() {
    var n := 100;
    var result := SumIntsLoop(n);
    print "Sum of integers from 1 to ", n, " is: ", result, "\n";

    // Verify the result matches the formula
    assert result == n * (n + 1) / 2;
    print "Verified: ", n, " * (", n, " + 1) / 2 = ", result, "\n";
  }
}
```


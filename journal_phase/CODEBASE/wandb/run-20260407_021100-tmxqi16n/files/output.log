  var n_iter := s.Length;
  zeroLoc := s.Length; // Initialize to "not found"

  while start < n_iter
    invariant 0 <= start <= n_iter
    invariant n_iter == s.Length
    invariant 0 <= zeroLoc <= s.Length
    invariant zeroLoc < s.Length ==> s[zeroLoc] == 0
    invariant forall i :: 0 <= i < start ==> s[i] != 0
  {
    if s[start] == 0 {
      zeroLoc := start;
      break;
    }
    start := start + 1;
  }

  // If we found a zero, look for the next one with stepSize
  if zeroLoc < s.Length {
    var nextStart := zeroLoc + stepSize;
    while nextStart < s.Length
      invariant zeroLoc < s.Length ==> s[zeroLoc] == 0
      invariant nextStart >= zeroLoc + stepSize
      invariant forall i :: zeroLoc < i < nextStart ==> i >= s.Length || s[i] != 0
    {
      if s[nextStart] == 0 {
        // Found another zero at stepSize distance
        // You could process this as needed
        break;
      }
      nextStart := nextStart + 1;
    }
  }
}


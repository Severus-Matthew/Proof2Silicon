  foundPokemon := null;
  index := -1;

  // Iterate through the pokedex (avoiding recursion as requested)
  var i := 0;
  while i < |pokedex|
    // Loop invariant and termination measure
    invariant 0 <= i <= |pokedex|
    invariant index == -1 || (index >= 0 && index < i && pokedex[index].name == nameToFind)
    decreases |pokedex| - i
  {
    if pokedex[i].name == nameToFind {
      foundPokemon := pokedex[i];
      index := i;
      return;
    }
    i := i + 1;
  }
}


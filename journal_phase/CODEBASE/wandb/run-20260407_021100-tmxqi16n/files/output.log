method LinearSearch<T>(array: array<T>, P: (T) -> bool) returns (index: int)
  requires array.Length > 0
  ensures index == -1 <==> (forall j | 0 <= j < array.Length :: !P(array[j]))
  ensures index != -1 ==> (0 <= index < array.Length && P(array[index]))
  ensures index != -1 ==> (forall j | 0 <= j < index :: !P(array[j]))
{
  index := -1;
  var i := 0;

  while i < array.Length
    invariant 0 <= i <= array.Length
    invariant index == -1 ==> (forall j | 0 <= j < i :: !P(array[j]))
    invariant index != -1 ==> (index < i && forall j | index < j < i :: !P(array[j]))
    invariant index != -1 ==> (0 <= index < array.Length && P(array[index]))

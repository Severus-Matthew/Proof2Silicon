    requires exists i :: 0 <= i < |array| && P(array[i])
    requires forall x :: P(x) ==> x % 2 == 0  // P implies evenness
    ensures 0 <= index < |array|
    ensures P(array[index])
    ensures array[index] % 2 == 0  // Redundant but explicit
    ensures forall j :: 0 <= j < index ==> !P(array[j])
{
    var i: int := 0;

    while i < |array|
        invariant 0 <= i <= |array|
        invariant forall j :: 0 <= j < i ==> !P(array[j])
    {
        if P(array[i]) {
            index := i;
            return;
        }
        i := i + 1;
    }

    // This point should never be reached due to the precondition
    assume false;
    index := -1;
}
```


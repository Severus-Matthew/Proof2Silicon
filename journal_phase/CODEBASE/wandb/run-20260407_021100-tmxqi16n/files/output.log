// Vector3 type definition
datatype Vector3 = Vector3(x: real, y: real, z: real)

// Vector operations
function DotProduct(a: Vector3, b: Vector3): real
  a.x * b.x + a.y * b.y + a.z * b.z

function CrossProduct(a: Vector3, b: Vector3): Vector3
  Vector3(
    a.y * b.z - a.z * b.y,
    a.z * b.x - a.x * b.z,
    a.x * b.y - a.y * b.x
  )

function ScalarTripleProduct(a: Vector3, b: Vector3, c: Vector3): real
  DotProduct(a, CrossProduct(b, c))

// Helper lemma for volume calculation
lemma VolumeLemma(a: Vector3, b: Vector3, c: Vector3)
  ensures |ScalarTripleProduct(a, b, c)| >= 0.0
{
  // The absolute value of scalar triple product is always non-negative
}

// Main function to check if three vectors are coplanar (intersect at origin)
method CheckVectorsIntersection(ta: Vector3, tb: Vector3, tc: Vector3) returns (intersects: bool)
  // Three vectors intersect at origin if they are coplanar (scalar triple product = 0)
  ensures intersects == (ScalarTripleProduct(ta, tb, tc) == 0.0)
{
  var volume := ScalarTripleProduct(ta, tb, tc);

  // Use epsilon for floating point comparison
  var epsilon: real := 0.000001;

  if |volume| < epsilon {
    intersects := true;
  } else {
    intersects := false;
  }

  // Apply the volume lemma
  VolumeLemma(ta, tb, tc);
}

// Test method with the given vectors
method Main() returns (result: bool)
{
  var ta := Vector3(14.0, 31.0, 42.0);
  var tb := Vector3(10.0, 22.0, 15.0);
  var tc := Vector3(5.0, 10.0, 15.0);

  result := CheckVectorsIntersection(ta, tb, tc);

  // Calculate and print the scalar triple product for verification
  var volume := ScalarTripleProduct(ta, tb, tc);
  print "Scalar triple product (volume): ", volume, "\n";
  print "Vectors intersect (are coplanar): ", result, "\n";

  // Additional test with clearly coplanar vectors
  var test1 := Vector3(1.0, 0.0, 0.0);
  var test2 := Vector3(0.0, 1.0, 0.0);
  var test3 := Vector3(1.0, 1.0, 0.0);

  var testResult := CheckVectorsIntersection(test1, test2, test3);
  print "Test with coplanar vectors (should be true): ", testResult, "\n";
}

// Helper method with loop for processing multiple vector sets
method ProcessVectorSets(vectors: seq<seq<Vector3>>) returns (results: seq<bool>)
  requires |vectors| > 0
  requires forall i :: 0 <= i < |vectors| ==> |vectors[i]| == 3
  ensures |results| == |vectors|
{
  results := [];
  var i: int := 0;

  while i < |vectors|
    invariant 0 <= i <= |vectors|
    invariant |results| == i
    decreases |vectors| - i
  {
    var ta := vectors[i][0];
    var tb := vectors[i][1];
    var tc := vectors[i][2];

    var intersects := CheckVectorsIntersection(ta, tb, tc);
    results := results + [intersects];

    i := i + 1;
  }
}

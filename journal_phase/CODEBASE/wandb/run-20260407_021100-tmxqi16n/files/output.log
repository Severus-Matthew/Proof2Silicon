```dafny
/**
 * Optimized search method using binary search to find the last occurrence of a target
 * in a sorted sequence. The sequence is immutable within the ghost scope, ensuring
 * no unintended modifications during the search.
 * This implementation uses an iterative binary search for efficiency.
 */
method SearchLastOccurrence<T(==)>(seq: seq<T>, target: T) returns (index: int)
  requires sorted(seq)  // Precondition: sequence must be sorted
  ensures index >= -1 && index < |seq|
  ensures index >= 0 ==> seq[index] == target
  ensures index >= 0 ==> (forall i :: index < i < |seq| ==> seq[i] != target)
  ensures index == -1 ==> (forall i :: 0 <= i < |seq| ==> seq[i] != target)
{
  ghost var ghostSeq := seq;  // Immutable ghost copy for verification

  var low := 0;
  var high := |seq| - 1;
  index := -1;

  while low <= high
    invariant 0 <= low <= high + 1 <= |seq|
    invariant high >= -1 && high < |seq|
    invariant (forall i :: 0 <= i < low ==> seq[i] != target)
    invariant (forall i :: high < i < |seq| ==> seq[i] != target)
    invariant index == -1 || (index >= 0 && seq[index] == target &&
           (forall i :: index < i < |seq| ==> seq[i] != target))
    decreases high - low
  {
    var mid := low + (high - low) / 2;

    if seq[mid] == target {
      // Found target, but continue searching to the right for last occurrence
      index := if index == -1 then mid else max(index, mid);
      low := mid + 1;  // Search right half for later occurrences
    } else if seq[mid] < target {
      low := mid + 1;  // Search right half
    } else {
      high := mid - 1;  // Search left half
    }
  }
}

/**
 * Helper predicate to check if a sequence is sorted in non-decreasing order
 */
predicate sorted<T(==)>(s: seq<T>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
}

/**
 * Helper function to find maximum of two integers
 */
function max(a: int, b: int): int
{
  if a > b then a else b
}
```

### Explanation:

1. **Immutability**: The `ghost var ghostSeq := seq` creates an immutable ghost copy that ensures the original sequence isn't modified during verification.

2. **Loop Invariants**:
   - Maintains bounds on `low` and `high`
   - Ensures elements before `low` and after `high` don't contain the target
   - Tracks the current found index and ensures it's the rightmost found so far

3. **Binary Search Logic**:
   - Standard binary search adapted to find the last occurrence
   - When target is found at `mid`, we continue searching to the right (`low := mid + 1`)
   - `index` tracks the rightmost found position

4. **Postconditions**:
   - `index` is between -1 and sequence length
   - If `index >= 0`, then `seq[index] == target` and it's the last occurrence
   - If `index == -1`, the target is not in the sequence

5. **Efficiency**: O(log n) time complexity using iterative binary search.

The method efficiently searches for the last occurrence of a target in a sorted sequence while maintaining verification guarantees through proper invariants and postconditions.

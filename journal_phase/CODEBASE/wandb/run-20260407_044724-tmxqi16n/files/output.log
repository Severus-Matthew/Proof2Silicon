    var det := 0;
    // Expand along first row
    for j := 0 to n - 1
      invariant 0 <= j <= n
      invariant det == CalculateDeterminantPartial(X, n, j)
    {
      // Create ghost submatrix
      ghost var submatrix := GhostSubmatrix(X, n, 0, j);
      var sub_det := CalculateDeterminant(submatrix, n - 1);
      det := det + sign * X[0, j] * sub_det;
      sign := -sign;
    }
    det
}

function CalculateDeterminantPartial(X: array2<int>, n: int, col: int): int
  requires X != null
  requires n > 0
  requires X.Length0 == n && X.Length1 == n
  requires 0 <= col <= n
{
  if col == 0 then
    0
  else
    var sign := 1;
    var det := 0;
    for j := 0 to col - 1
      invariant 0 <= j <= col
      invariant det == CalculateDeterminantPartialHelper(X, n, j)
    {
      ghost var submatrix := GhostSubmatrix(X, n, 0, j);
      var sub_det := CalculateDeterminant(submatrix, n - 1);
      det := det + sign * X[0, j] * sub_det;
      sign := -sign;
    }
    det
}

function CalculateDeterminantPartialHelper(X: array2<int>, n: int, col: int): int
  requires X != null
  requires n > 0
  requires X.Length0 == n && X.Length1 == n
  requires 0 <= col <= n
{
  if col == 0 then
    0
  else
    var sign := 1;
    var det := 0;
    for j := 0 to col - 1
      invariant 0 <= j <= col
    {
      if j < col {
        ghost var submatrix := GhostSubmatrix(X, n, 0, j);
        var sub_det := CalculateDeterminant(submatrix, n - 1);
        det := det + sign * X[0, j] * sub_det;
        sign := -sign;
      }
    }
    det
}


method InsertPosition(a: array<real>, x: real) returns (k: int)
  requires a != null
  requires forall i, j :: 0 <= i < j < a.Length ==> a[i] >= a[j]  // Non-increasing sequence
  ensures 0 <= k <= a.Length
  ensures forall i :: 0 <= i < k ==> a[i] >= x  // Elements to the left are >= x
  ensures forall i :: k <= i < a.Length ==> a[i] <= x  // Elements to the right are <= x
{
  k := 0;
  while k < a.Length && a[k] >= x
    invariant 0 <= k <= a.Length
    invariant forall i :: 0 <= i < k ==> a[i] >= x
  {
    k := k + 1;
  }

      var factor := M[k, i] / M[i, i];
      for j := i to n - 1
        invariant i <= j <= n
      {
        M[k, j] := M[k, j] - factor * M[i, j];
      }
    }
  }

  // Compute determinant as product of diagonal elements
  det := M[0, 0];
  for i := 1 to n - 1
    invariant 1 <= i <= n
    invariant det == product of M[0..i-1, 0..i-1] diagonal elements
  {
    det := det * M[i, i];
  }

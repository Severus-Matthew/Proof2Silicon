    invariant DistinctSeq(remaining)
    // Loop invariant: All elements in derangement are from the original sequence
    invariant forall x :: x in derangement ==> x in s
    // Loop invariant: The remaining sequence has the correct length
    invariant |remaining| == |s| - i
    // Termination: The loop decreases the number of elements remaining.
    decreases |s| - i
  {

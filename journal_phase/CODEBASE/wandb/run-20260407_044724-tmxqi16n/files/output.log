  import opened Library.Int.IntPow
  import opened Library.Info.KnownValue

  function even(n: int): bool
  {
    n % 2 == 0
  }

  method is_even(n: int) returns (result: bool)
    ensures result == even(n)
  {
    result := n % 2 == 0;
  }

  // Factorial function
  function factorial(n: int): int
    requires n >= 0
    decreases n
  {
    if n == 0 then 1 else n * factorial(n - 1)
  }

  // Iterative method to compute factorial
  method compute_factorial(n: int) returns (result: int)
    requires n >= 0
    ensures result == factorial(n)
  {
    result := 1;
    var i := n;

    while i > 0
      invariant result * factorial(i) == factorial(n)
      invariant i >= 0
      decreases i
    {
      result := result * i;
      i := i - 1;
    }
  }

  // Test method with corrected assertions
  method test_factorial()
  {
    // Test factorial computation
    var f0 := compute_factorial(0);
    assert f0 == 1;
    assert f0 == factorial(0);

    var f1 := compute_factorial(1);
    assert f1 == 1;
    assert f1 == factorial(1);

    var f2 := compute_factorial(2);
    assert f2 == 2;
    assert f2 == factorial(2);


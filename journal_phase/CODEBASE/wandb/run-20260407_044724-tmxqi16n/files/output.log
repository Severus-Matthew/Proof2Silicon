        if j < M.Length1 - 1 {
          row := row + ", ";
        }
        j := j + 1;
      }
      row := row + "]";
      print row, "\n";
      i := i + 1;
    }
  }

  // Flip/Transpose a square matrix
  method Flip(M: matT) returns (flipped: matT)
    requires M.Length0 > 0 && M.Length1 > 0
    requires M.Length0 == M.Length1  // Must be square matrix
    ensures flipped.Length0 == M.Length1
    ensures flipped.Length1 == M.Length0
    ensures forall i, j :: 0 <= i < M.Length0 && 0 <= j < M.Length1 ==>
             flipped[j, i] == M[i, j]
  {

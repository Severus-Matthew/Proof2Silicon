method DeterminantOptimized(X: array2<int>, n: int) returns (det: int)
  requires n > 0
  requires X.Length0 == n && X.Length1 == n
{
  det := 1;

  // Handle 1x1 matrix case
  if n == 1 {
    det := X[0, 0];
    return;
  }

  // Create a mutable copy of the matrix
  var M := new int[n, n];
  for i := 0 to n - 1
    invariant 0 <= i <= n
  {
    for j := 0 to n - 1
      invariant 0 <= j <= n
    {
      M[i, j] := X[i, j];
    }
  }

  // Perform Gaussian elimination
  for i := 0 to n - 1
    invariant 0 <= i <= n
  {
    // Find pivot
    var pivot := i;
    for k := i + 1 to n - 1
      invariant i + 1 <= k <= n
    {
      if abs(M[k, i]) > abs(M[pivot, i]) {
        pivot := k;
      }
    }

    // Swap rows if necessary
    if pivot != i {
      for j := 0 to n - 1
        invariant 0 <= j <= n
      {
        var temp := M[i, j];
        M[i, j] := M[pivot, j];
        M[pivot, j] := temp;

  ensures 2.pow(n) <= 1000 && (n+1 < 0 || 2.pow(n+1) > 1000)
{
  n := 0;
  var power := 1;

  while (power * 2 <= 1000)
    invariant 0 <= n
    invariant power == pow2(n)
    invariant power <= 1000
  {
    n := n + 1;
    power := power * 2;
  }
}

function pow2(n: int): int
  requires n >= 0
  decreases n
{

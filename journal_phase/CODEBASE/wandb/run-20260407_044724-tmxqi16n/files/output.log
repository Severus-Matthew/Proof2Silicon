```dafny
method segMaxSum(v: array<int>) returns (maxSum: int, seg: (int, int))
  requires v != null && v.Length > 0
  ensures 0 <= seg.0 && seg.0 <= seg.1 && seg.1 < v.Length
  ensures SumMaxToRight(v, seg.0, seg.1, maxSum)
  ensures forall i, j :: 0 <= i <= j < v.Length ==> segSumNaive(v, i, j) <= maxSum
{
  var n := v.Length;
  maxSum := v[0];
  seg := (0, 0);

  var currentSum := 0;
  var start := 0;

  for i := 0 to n
    invariant 0 <= start <= i <= n
    invariant currentSum == segSumNaive(v, start, i-1)
    invariant forall j :: 0 <= j < i ==> segSumNaive(v, start, j) >= 0
    invariant maxSum == segSumNaive(v, seg.0, seg.1)
    invariant forall p, q :: 0 <= p <= q < i ==> segSumNaive(v, p, q) <= maxSum
  {
    if i < n {
      currentSum := currentSum + v[i];
    }

    if currentSum > maxSum {
      maxSum := currentSum;
      seg := (start, i);
    }

    if i < n && currentSum < 0 {
      currentSum := 0;
      start := i + 1;
    }
  }
}

method segSumaMaxima2(v: array<int>) returns (maxSum: int, seg: (int, int))
  requires v != null && v.Length > 0
  ensures 0 <= seg.0 && seg.1 < v.Length
  ensures SumMaxToRight2(v, seg.0, seg.1, maxSum)
  ensures forall i, j :: 0 <= i <= j < v.Length ==>
    let altSum = segSumNaive(v, i, j) + (if i == j then 0 else 1) in
    altSum <= maxSum
{
  var n := v.Length;
  maxSum := v[0] + (if n > 1 then 1 else 0);
  seg := (0, 0);

  var currentSum := 0;
  var start := 0;
  var hasMultiple := false;

  for i := 0 to n
    invariant 0 <= start <= i <= n
    invariant currentSum == segSumNaive(v, start, i-1)
    invariant hasMultiple == (start < i-1)
    invariant maxSum == segSumNaive(v, seg.0, seg.1) + (if seg.0 < seg.1 then 1 else 0)
    invariant forall p, q :: 0 <= p <= q < i ==>
      segSumNaive(v, p, q) + (if p < q then 1 else 0) <= maxSum
  {
    if i < n {
      currentSum := currentSum + v[i];
    }

    var currentAltSum := currentSum + (if start < i-1 then 1 else 0);

    if currentAltSum > maxSum {
      maxSum := currentAltSum;
      seg := (start, i);
    }

    if i < n && currentSum < 0 {
      currentSum := 0;
      start := i + 1;
      hasMultiple := false;
    } else if i < n && start < i {
      hasMultiple := true;
    }
  }
}

function segSumNaive(v: array<int>, i: int, j: int): int
  requires v != null
  requires 0 <= i <= j < v.Length
{
  var sum := 0;
  for k := i to j
    invariant sum == segSumNaivePartial(v, i, k-1)
  {
    sum := sum + v[k];
  }
  sum
}

function segSumNaivePartial(v: array<int>, i: int, j: int): int
  requires v != null
  requires 0 <= i
  requires j < i-1 || (0 <= j < v.Length)
  decreases if j < i-1 then 0 else j - i + 1
{
  if j < i then 0
  else segSumNaivePartial(v, i, j-1) + v[j]
}

predicate SumMaxToRight(v: array<int>, i: int, j: int, maxSum: int)
  requires v != null
  requires 0 <= i <= j < v.Length
{
  segSumNaive(v, i, j) == maxSum &&
  forall k, l :: i <= k <= l <= j ==> segSumNaive(v, k, l) <= maxSum
}

predicate SumMaxToRight2(v: array<int>, i: int, j: int, maxSum: int)
  requires v != null
  requires 0 <= i <= j < v.Length
{
  var baseSum := segSumNaive(v, i, j);
  var altSum := baseSum + (if i < j then 1 else 0);
  altSum == maxSum &&
  forall k, l :: i <= k <= l <= j ==>
    segSumNaive(v, k, l) + (if k < l then 1 else 0) <= maxSum
}

method showSegas_maxSum(v: array<int>) returns (result: array<int>)
  requires v != null && v.Length > 0
  ensures result != null && result.Length == 3
{
  var max1, seg1 := segMaxSum(v);
  var max2, seg2 := segSumaMaxima2(v);

  result := new int[3];
  result[0] := max1;
  result[1] := max2;
  result[2] := if max1 > max2 then 0 else 1;
}

module Search {
  method Search(SEQ: seq<int>, INT: int) returns (index: int)
    requires INT in SEQ
    ensures 0 <= index < |SEQ|
    ensures SEQ[index] == INT
    ensures forall i :: 0 <= i < index ==> SEQ[i] != INT
  {
    var i := 0;
    while i < |SEQ|
      invariant 0 <= i <= |SEQ|
      invariant forall j :: 0 <= j < i ==> SEQ[j] != INT
    {
      if SEQ[i] == INT {
        index := i;
        return;
      }
      i := i + 1;
    }

    // This line should never be reached due to the precondition
    // but we need to return something to satisfy Dafny
    index := -1;
  }
}
```


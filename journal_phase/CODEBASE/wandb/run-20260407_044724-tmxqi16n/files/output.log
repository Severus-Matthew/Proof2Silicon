```dafny
method MaxSubarraySum(a: array<int>) returns (maxSum: int)
  requires a != null
  ensures maxSum >= 0 || exists i :: 0 <= i < a.Length && a[i] < 0
  ensures forall segmentStart, segmentEnd ::
    0 <= segmentStart <= segmentEnd < a.Length ==>
    (var sum := 0; for i := segmentStart to segmentEnd
      invariant sum == sum(a[segmentStart..i])
      { sum := sum + a[i]; } sum) <= maxSum
{
  if a.Length == 0 {
    maxSum := 0;
    return;
  }

  var currentMax := a[0];
  var globalMax := a[0];

  var i: int := 1;
  while i < a.Length
    invariant 1 <= i <= a.Length
    invariant currentMax == max(a[i-1], sumContiguousEndingAt(i-1))
    invariant globalMax == maxSumUpTo(i-1)
    invariant forall j :: 0 <= j < i ==> maxSumUpTo(j) >= sumContiguousEndingAt(j)
  {
    // Update current maximum ending at position i
    if a[i] > currentMax + a[i] {
      currentMax := a[i];
    } else {
      currentMax := currentMax + a[i];
    }

    // Update global maximum
    if currentMax > globalMax {
      globalMax := currentMax;
    }

    i := i + 1;
  }

  maxSum := globalMax;
}

// Helper function to calculate maximum sum of contiguous subarray ending at position k
function sumContiguousEndingAt(k: int): int
  requires 0 <= k < a.Length
  reads a
{
  var maxEndingHere := a[k];
  var currentSum := a[k];

  var i := k - 1;
  while i >= 0
    invariant -1 <= i < k
    invariant currentSum == sum(a[i+1..k+1])
    invariant maxEndingHere >= currentSum
  {
    currentSum := currentSum + a[i];
    if currentSum > maxEndingHere {
      maxEndingHere := currentSum;
    }
    i := i - 1;
  }
  maxEndingHere
}

// Helper function to calculate maximum subarray sum up to position k
function maxSumUpTo(k: int): int
  requires 0 <= k < a.Length
  reads a
{
  var maxSoFar := a[0];
  var currentMax := a[0];

  var i: int := 1;
  while i <= k
    invariant 1 <= i <= k+1
    invariant currentMax == max(a[i-1], sumContiguousEndingAt(i-1))
    invariant maxSoFar == maxSumUpToHelper(i-1)
  {
    if a[i] > currentMax + a[i] {
      currentMax := a[i];
    } else {
      currentMax := currentMax + a[i];
    }

    if currentMax > maxSoFar {
      maxSoFar := currentMax;
    }

    i := i + 1;
  }
  maxSoFar
}

// Helper function for maxSumUpTo
function maxSumUpToHelper(k: int): int
  requires 0 <= k < a.Length
  reads a
  decreases k
{
  if k == 0 then a[0]
  else max(maxSumUpToHelper(k-1), sumContiguousEndingAt(k))
}

// Helper function to calculate sum of array slice
function sum(slice: seq<int>): int {
  if |slice| == 0 then 0
  else slice[0] + sum(slice[1..])
}

// Helper max function
function max(x: int, y: int): int {
  if x > y then x else y
}
```


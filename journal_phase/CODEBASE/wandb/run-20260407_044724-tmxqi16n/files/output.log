  // Second pass: Verify the candidate
  var verifyCount: int := 0;
  for i := 0 to |A| - 1
    invariant verifyCount <= i
    invariant verifyCount == count(A[0..i], candidate)
  {
    if A[i] == candidate {
      verifyCount := verifyCount + 1;
    }
  }

  if verifyCount > |A| / 2 {
    majority := candidate;
  } else {

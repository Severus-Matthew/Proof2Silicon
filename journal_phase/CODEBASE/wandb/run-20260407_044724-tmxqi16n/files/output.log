  assert evenIndex1 == 3;

  print "All tests passed!\n";
}

// Helper method to search with a predicate
method LinearSearchWithPredicate<T(==)>(a: array<T>, predicate: (T) -> bool) returns (index: int)
  ensures index == -1 || (0 <= index < a.Length && predicate(a[index]))
  ensures index == -1 ==> forall i | 0 <= i < a.Length :: !predicate(a[i])
  decreases a.Length - index
{
  index := 0;
  while index < a.Length
    decreases a.Length - index
  {
    if predicate(a[index]) {
      return;
    }
    index := index + 1;
  }
  index := -1;
}
```


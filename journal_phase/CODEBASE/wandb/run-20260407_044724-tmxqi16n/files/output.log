```dafny
method CumulativeSum(a: array<int>, b: array<int>)
  requires a != null && b != null
  requires a.Length == b.Length
  requires a.Length > 0
  modifies b
  ensures forall i :: 0 <= i < a.Length ==> b[i] == sum(a[..i+1])
  ensures old(a[..]) == a[..]
{
  var sum := 0;
  for i := 0 to a.Length - 1
    invariant 0 <= i <= a.Length
    invariant forall j :: 0 <= j < i ==> b[j] == sum(a[..j+1])
    invariant sum == (if i > 0 then b[i-1] else 0)
  {
    sum := sum + a[i];
    b[i] := sum;
  }
}

// Helper function to calculate sum of a sequence
function sum(seq: seq<int>): int
  decreases |seq|
{
  if |seq| == 0 then 0
  else seq[0] + sum(seq[1..])
}

// Test the implementation
method TestCumulativeSum() {
  var a := new int[5];
  a[0], a[1], a[2], a[3], a[4] := 1, 2, 3, 4, 5;

  var b := new int[a.Length];

  CumulativeSum(a, b);

  // Verify the result
  assert b[0] == 1;
  assert b[1] == 3;
  assert b[2] == 6;
  assert b[3] == 10;
  assert b[4] == 15;
}
```


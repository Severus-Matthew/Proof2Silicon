  // Copy the array
  b := new int[a.Length];
  var i := 0;
  while i < b.Length
    invariant 0 <= i <= b.Length
    invariant b.Length == a.Length
    invariant forall k :: 0 <= k < i ==> b[k] == a[k]
    invariant multiset(a[..]) == multiset(b[..])
  {
    b[i] := a[i];
    i := i + 1;
  }

  // Selection sort
  i := 0;
  while i < b.Length
    invariant 0 <= i <= b.Length
    invariant b.Length == a.Length
    invariant sorted_seg(b, 0, i)
    invariant multiset(a[..]) == multiset(b[..])
    invariant forall p, q :: 0 <= p < i <= q < b.Length ==> b[p] <= b[q]
  {
    // Find minimum element in unsorted part
    var minIndex := i;
    var j := i + 1;

    while j < b.Length
      invariant i <= minIndex < b.Length
      invariant i < j <= b.Length
      invariant forall k :: i <= k < j ==> b[minIndex] <= b[k]
      invariant forall k :: i <= k < minIndex ==> b[k] >= b[minIndex]
    {
      if b[j] < b[minIndex] {
        minIndex := j;
      }
      j := j + 1;
    }

    // Swap b[i] and b[minIndex] if they're different
    if i != minIndex {
      var temp := b[i];
      b[i] := b[minIndex];
      b[minIndex] := temp;
    }

    i := i + 1;
  }
}

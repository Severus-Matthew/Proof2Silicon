```dafny
method BinarySearch(sorted_array: array<int>, x: int) returns (index: int)
  requires sorted_array != null
  requires forall i, j :: 0 <= i < j < sorted_array.Length ==> sorted_array[i] <= sorted_array[j]
  ensures -1 <= index < sorted_array.Length
  ensures index >= 0 ==> sorted_array[index] == x
  ensures index == -1 ==> forall i :: 0 <= i < sorted_array.Length ==> sorted_array[i] != x
{
  var low := 0;
  var high := sorted_array.Length - 1;
  index := -1;

  while low <= high
    invariant 0 <= low <= high + 1
    invariant high < sorted_array.Length
    invariant forall i :: 0 <= i < low ==> sorted_array[i] < x
    invariant forall i :: high < i < sorted_array.Length ==> sorted_array[i] > x
    invariant index == -1 || (0 <= index < sorted_array.Length && sorted_array[index] == x)
    decreases high - low
  {
    var mid := (low + high) / 2;

    if sorted_array[mid] == x {
      index := mid;
      return;
    } else if sorted_array[mid] < x {
      low := mid + 1;
    } else {
      high := mid - 1;
    }
  }
}
```


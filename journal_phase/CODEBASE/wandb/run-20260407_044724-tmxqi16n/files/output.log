  while i < |workingSet|
    invariant 0 <= i <= |workingSet|
    invariant forall j :: 0 <= j < i ==>
      (workingSet[j].key == 0 ==> workingSet[j].value == 0)
    invariant forall j :: 0 <= j < |workingSet| ==> workingSet[j].key == colonyData[j].key
  {
    if workingSet[i].key == 0 {
      workingSet := workingSet[i := KV(workingSet[i].key, 0)];
    }
    i := i + 1;
  }

  // Process each day
  while day < |workingSet|
    invariant 0 <= day <= |workingSet|
    invariant forall j :: 0 <= j < day ==>
      minValue <= workingSet[j].value <= 15
    invariant totalAmount == sumValues(workingSet[0..day])
    invariant totalAmount <= 15 * day
    invariant forall j :: 0 <= j < |workingSet| ==> workingSet[j].key == colonyData[j].key
    decreases |workingSet| - day
  {
    var current := workingSet[day];

    // Ensure value is between minValue and 15
    if current.value > 15 {
      workingSet := workingSet[day := KV(current.key, 15)];
    } else if current.value < minValue {
      workingSet := workingSet[day := KV(current.key, minValue)];
    }

    // Recalculate totalAmount since we may have changed a value
    totalAmount := 0;
    var recalcDay := 0;
    while recalcDay <= day
      invariant 0 <= recalcDay <= day + 1
      invariant totalAmount == sumValues(workingSet[0..recalcDay])
    {
      totalAmount := totalAmount + workingSet[recalcDay].value;
      recalcDay := recalcDay + 1;
    }

    // Verify we haven't exceeded the daily limit
    assert totalAmount <= 15 * (day + 1);

    day := day + 1;
  }

  result := workingSet;

  // Final verification
  assert sumValues(result) <= 15 * |result|;
  assert forall i :: 0 <= i < |result| ==> result[i].key == colonyData[i].key;
  assert forall i :: 0 <= i < |result| ==> findMinValue(colonyData) <= result[i].value <= 15;
}


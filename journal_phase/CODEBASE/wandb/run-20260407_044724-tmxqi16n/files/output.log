Here's my implementation:

```dafny
module SeqGuide {
  // Helper lemma to maintain sorting invariant
  lemma RangeSet(a: seq<int>, low: int, high: int)
    requires 0 <= low <= high <= |a|
    requires forall i, j :: low <= i < j < high ==> a[i] <= a[j]
    ensures forall i, j :: low <= i < j < high ==> a[i] <= a[j]
  {
    // This lemma ensures the sorting invariant is maintained
    // No body needed as it's just stating the invariant holds
  }

  // Helper method to find insertion position in sorted sequence
  method SortInsertionPosition(a: seq<int>, x: int) returns (k: int)
    requires forall i, j :: 0 <= i < j < |a| ==> a[i] <= a[j]  // a is sorted
    ensures 0 <= k <= |a|
    ensures forall i :: 0 <= i < k ==> a[i] <= x
    ensures forall i :: k <= i < |a| ==> x <= a[i]
  {
    var low := 0;
    var high := |a|;

    while low < high
      invariant 0 <= low <= high <= |a|
      invariant forall i :: 0 <= i < low ==> a[i] <= x
      invariant forall i :: high <= i < |a| ==> x <= a[i]
    {
      var mid := (low + high) / 2;
      if a[mid] <= x {
        low := mid + 1;
      } else {
        high := mid;
      }
    }

    k := low;
  }
}

module MainModule {
  import opened SeqGuide

  // Modified SearchRecursive using SortInsertionPosition
  method SearchRecursive(a: seq<int>, x: int) returns (k: int)
    requires forall i, j :: 0 <= i < j < |a| ==> a[i] <= a[j]  // a is sorted
    ensures 0 <= k <= |a|
    ensures forall i :: 0 <= i < k ==> a[i] < x
    ensures forall i :: k <= i < |a| ==> x <= a[i]
  {
    // Use SortInsertionPosition to find where x would be inserted
    // but adjust for strict inequality on left side
    k := SortInsertionPosition(a, x - 1);

    // Apply RangeSet lemma to maintain sorting invariant
    RangeSet(a, 0, |a|);
  }

  // Modified SearchLoop using SortInsertionPosition
  method SearchLoop(a: seq<int>, x: int) returns (k: int)
    requires forall i, j :: 0 <= i < j < |a| ==> a[i] <= a[j]  // a is sorted
    ensures 0 <= k <= |a|
    ensures forall i :: 0 <= i < k ==> a[i] <= x
    ensures forall i :: k <= i < |a| ==> x < a[i]
  {
    // Use SortInsertionPosition to find where x would be inserted
    // but adjust for strict inequality on right side
    k := SortInsertionPosition(a, x);

    // Need to adjust if we found an exact match
    var i := k;
    while i < |a| && a[i] == x
      invariant k <= i <= |a|
      invariant forall j :: 0 <= j < k ==> a[j] <= x
      invariant forall j :: i <= j < |a| ==> x < a[j]
    {
      i := i + 1;
    }
    k := i;

    // Apply RangeSet lemma to maintain sorting invariant
    RangeSet(a, 0, |a|);
  }

  // Test method to verify correctness
  method Test()
  {
    var sortedSeq := [1, 3, 5, 7, 9];

    // Test SearchRecursive
    var k1 := SearchRecursive(sortedSeq, 5);
    assert k1 == 2; // First index where elements are >= 5

    var k2 := SearchRecursive(sortedSeq, 6);
    assert k2 == 3; // First index where elements are >= 6

    // Test SearchLoop
    var k3 := SearchLoop(sortedSeq, 5);
    assert k3 == 3; // First index where elements are > 5

    var k4 := SearchLoop(sortedSeq, 6);
    assert k4 == 3; // First index where elements are > 6

    // Verify sequence remains sorted
    assert forall i, j :: 0 <= i < j < |sortedSeq| ==> sortedSeq[i] <= sortedSeq[j];
  }
}
```

This implementation:

1. **SortInsertionPosition**: Uses binary search to find the insertion position in O(log n) time without recursion
2. **SearchRecursive**: Modified to use SortInsertionPosition with `x-1` to get the correct boundary for `< x` on left side
3. **SearchLoop**: Modified to use SortInsertionPosition and then adjust for exact matches to get `< x` on right side
4. **RangeSet lemma**: Applied in both methods to maintain the sorting invariant
5. **Test method**: Verifies the correctness with assertions

The key insights:
- `SortInsertionPosition` finds the first position where `x` should be inserted to maintain sorted order
- `SearchRecursive` needs elements `< x` on left, so we search for `x-1`
- `SearchLoop` needs elements `> x` on right, so we search for `x` and then skip exact matches
- The `RangeSet` lemma ensures the sorting invariant is preserved throughout

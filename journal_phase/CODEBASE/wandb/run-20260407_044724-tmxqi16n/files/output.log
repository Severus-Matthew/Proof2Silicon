        var laplacian := solver.LaplacianAt(i, j);
        var residual := laplacian - solver.f[i, j];
        // Residual should be small (but not exactly zero due to iterative method)
        assert residual * residual < 1e-4; // Allow some tolerance
      }
    }
  }
}

// Binary Search Tree implementation in Dafny
// Supports insertion, validation, and in-order traversal

// Define the tree structure
datatype Tree = Empty | Node(value: int, left: Tree, right: Tree)

// Predicate to check if a tree is a valid BST
predicate IsBST(tree: Tree, min: int, max: int)
  decreases tree
{
  match tree
  case Empty => true
  case Node(v, l, r) =>
    min <= v < max &&
    IsBST(l, min, v) &&
    IsBST(r, v, max)
}

// Function to check if a tree is a valid BST (public wrapper)
function IsValidBST(tree: Tree): bool
{
  IsBST(tree, -2147483648, 2147483647)  // Using int min/max bounds
}

// Predicate to check if a value exists in the tree
predicate Contains(tree: Tree, x: int)
  decreases tree
{
  match tree
  case Empty => false
  case Node(v, l, r) =>
    x == v || (x < v && Contains(l, x)) || (x > v && Contains(r, x))
}

// Function to insert a value into a BST
function Insert(tree: Tree, x: int): (t: Tree)
  requires IsValidBST(tree)
  ensures IsValidBST(t)
  ensures Contains(t, x)
  ensures forall y :: Contains(tree, y) ==> Contains(t, y)
  ensures forall y :: Contains(t, y) ==> (Contains(tree, y) || y == x)
  decreases tree
{
  match tree
  case Empty => Node(x, Empty, Empty)
  case Node(v, l, r) =>
    if x < v then
      Node(v, Insert(l, x), r)
    else if x > v then
      Node(v, l, Insert(r, x))
    else
      tree  // No duplicates
}

// Helper lemma for in-order traversal properties
lemma InOrderLemma(tree: Tree, min: int, max: int)
  requires IsBST(tree, min, max)
  ensures forall x :: Contains(tree, x) ==> min <= x < max
  decreases tree
{
  match tree
  case Empty =>
  case Node(v, l, r) =>
    // Recursively apply the lemma to subtrees
    InOrderLemma(l, min, v);
    InOrderLemma(r, v, max);
}

// Function to collect elements in in-order traversal
function InOrder(tree: Tree): seq<int>
  decreases tree
{
  match tree
  case Empty => []
  case Node(v, l, r) => InOrder(l) + [v] + InOrder(r)
}

// Lemma to prove in-order traversal produces sorted sequence
lemma InOrderSorted(tree: Tree, min: int, max: int)
  requires IsBST(tree, min, max)
  ensures sorted(InOrder(tree))
  ensures forall x :: x in InOrder(tree) ==> min <= x < max
  decreases tree
{
  match tree
  case Empty =>
    // Base case: empty sequence is sorted
  case Node(v, l, r) =>
    // Apply lemma recursively to subtrees
    InOrderSorted(l, min, v);
    InOrderSorted(r, v, max);

    // Prove concatenation of sorted sequences with pivot maintains sortedness
    assert sorted(InOrder(l));
    assert sorted(InOrder(r));
    assert forall x :: x in InOrder(l) ==> x < v;
    assert forall x :: x in InOrder(r) ==> v < x;
}

// Helper predicate to check if a sequence is sorted
predicate sorted(s: seq<int>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
}

// Method to insert a value into a BST (imperative version)
method InsertMethod(tree: Tree, x: int) returns (t: Tree)
  requires IsValidBST(tree)
  ensures IsValidBST(t)
  ensures Contains(t, x)
  ensures forall y :: Contains(tree, y) ==> Contains(t, y)
  ensures forall y :: Contains(t, y) ==> (Contains(tree, y) || y == x)
{
  t := Insert(tree, x);
}

// Method to perform in-order traversal and print values
method InOrderTraversal(tree: Tree) returns (result: seq<int>)
  requires IsValidBST(tree)
  ensures result == InOrder(tree)
  ensures sorted(result)
{
  result := InOrder(tree);

  // Prove the result is sorted using the lemma
  InOrderSorted(tree, -2147483648, 2147483647);
}

// Test method to demonstrate functionality
method TestBST()
{
  var t: Tree := Empty;

  // Build a BST by inserting values
  t := Insert(t, 5);
  t := Insert(t, 3);
  t := Insert(t, 7);
  t := Insert(t, 2);
  t := Insert(t, 4);
  t := Insert(t, 6);
  t := Insert(t, 8);

  // Verify the tree is a valid BST
  assert IsValidBST(t);

  // Perform in-order traversal
  var traversal: seq<int>;
  traversal := InOrderTraversal(t);

  // Verify the traversal result
  assert traversal == [2, 3, 4, 5, 6, 7, 8];
  assert sorted(traversal);

  // Test that duplicates are not inserted
  var t2: Tree := Insert(t, 5);  // Try to insert duplicate
  assert t2 == t;  // Should be the same tree

  // Verify all inserted values are present
  assert Contains(t, 5);
  assert Contains(t, 3);
  assert Contains(t, 7);
  assert Contains(t, 2);
  assert Contains(t, 4);
  assert Contains(t, 6);
  assert Contains(t, 8);
  assert !Contains(t, 1);  // Not inserted
  assert !Contains(t, 9);  // Not inserted

  print "All tests passed!\n";
}

// Main method to run the test
method Main()
{
  TestBST();
}
```


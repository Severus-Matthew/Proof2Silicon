// Simple distinctness predicates for small groups of elements
predicate distinctness_2<T(==)>(a: T, b: T) { a != b }
predicate distinctness_3<T(==)>(a: T, b: T, c: T) { a != b && a != c && b != c }
predicate distinctness_4<T(==)>(a: T, b: T, c: T, d: T) {
  a != b && a != c && a != d && b != c && b != d && c != d
}

// A permutation contains exactly the same elements as the original sequence
predicate IsPermutation<T(==)>(s: seq<T>, p: seq<T>)
  requires DistinctSeq(s) && DistinctSeq(p)
{
  multiset(s) == multiset(p)
}

// A derangement is a permutation with no element in its original position

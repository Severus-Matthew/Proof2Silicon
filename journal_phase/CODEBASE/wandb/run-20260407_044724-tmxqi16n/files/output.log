```dafny
method BinarySearch<T(==,<)>(a: array<T>, key: T) returns (index: int)
  requires forall i, j | 0 <= i < j < a.Length :: a[i] <= a[j]
  ensures index == -1 || (0 <= index < a.Length && a[index] == key)
  ensures index == -1 ==> forall i | 0 <= i < a.Length :: a[i] != key
  decreases if index == -1 then a.Length else a.Length - index
{
  var left := 0;
  var right := a.Length - 1;
  index := -1;

  while left <= right
    decreases right - left + 1
  {
    var mid := left + (right - left) / 2;

    if a[mid] == key {
      index := mid;
      return;
    } else if a[mid] < key {
      left := mid + 1;
    } else {
      right := mid - 1;
    }
  }
}


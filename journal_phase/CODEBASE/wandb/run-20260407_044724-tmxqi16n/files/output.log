            var diff := u_new[i, j] - u[i, j];
            if diff < 0.0 then diff := -diff;
            if diff > error then error := diff;
          }
        }

        // Check convergence
        if error < tolerance then {
          break;
        }

        // Swap arrays for next iteration
        var temp := u;
        u := u_new;
        u_new := temp;

        iterations := iterations + 1;
      }

      // Clean up
      u_new := null;
    }
  }


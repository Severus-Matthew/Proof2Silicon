```dafny
method FindMax(arr: array<int>) returns (max: int)
  requires arr.Length > 0
  ensures forall i :: 0 <= i < arr.Length ==> arr[i] <= max
  ensures exists i :: 0 <= i < arr.Length && arr[i] == max
{
  max := arr[0];
  var index: int := 1;

  while index < arr.Length
    invariant 1 <= index <= arr.Length
    invariant forall j :: 0 <= j < index ==> arr[j] <= max
    invariant exists j :: 0 <= j < index && arr[j] == max
  {
    if arr[index] > max {
      max := arr[index];
    }
    index := index + 1;
  }
}

method Main() {
  var myArray: array<int> := new int[5];
  myArray[0] := 1;
  myArray[1] := 2;
  myArray[2] := 3;
  myArray[3] := 4;
  myArray[4] := 5;

  var maxValue: int := FindMax(myArray);
  print "Maximum value in array: ", maxValue, "\n";
}
```

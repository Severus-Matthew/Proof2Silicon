  var i := 0;
  while i < n - 1
    invariant 0 <= i <= n - 1
  {
    var j := 0;
    while j < n - 1
      invariant 0 <= j <= n - 1
    {
      var orig_i := if i < row then i else i + 1;
      var orig_j := if j < col then j else j + 1;
      result[i, j] := X[orig_i, orig_j];
      j := j + 1;
    }
    i := i + 1;
  }
}

// Helper function to calculate determinant for verification
function CalculateDeterminant(X: array2<int>, n: int): int
  requires X != null
  requires n > 0
  requires X.Length0 == n && X.Length1 == n
  decreases n
{
  if n == 1 then
    X[0, 0]
  else if n == 2 then
    X[0, 0] * X[1, 1] - X[0, 1] * X[1, 0]

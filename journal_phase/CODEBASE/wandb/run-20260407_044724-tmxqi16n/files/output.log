// Dafny program to calculate the sum of integers from 1 to n
// This demonstrates multiple approaches with full verification

method Main()
{
    var n := 100; // Example input
    var sum := SumIntsFormula(n);
    print "The sum of integers from 1 to ", n, " is: ", sum, "\n";

    // Verify both methods give the same result
    var sumLoop := SumIntsLoop(n);
    var sumRecursive := SumIntsRecursive(n);
    assert sum == sumLoop && sum == sumRecursive;
}

// Method 1: Using the mathematical formula (most efficient)
method SumIntsFormula(n: int) returns (sum: int)
    requires n >= 0  // Precondition: n must be non-negative
    ensures sum == n * (n + 1) / 2  // Postcondition: formula correctness
    ensures sum >= 0  // Postcondition: sum is non-negative
{
    sum := n * (n + 1) / 2;
}

// Method 2: Iterative approach (loop)
method SumIntsLoop(n: int) returns (sum: int)
    requires n >= 0  // Precondition: n must be non-negative
    ensures sum == n * (n + 1) / 2  // Postcondition: matches formula
    ensures sum >= 0  // Postcondition: sum is non-negative
{
    sum := 0;
    var i := 0;

    while i <= n
        invariant 0 <= i <= n + 1
        invariant sum == i * (i - 1) / 2  // Loop invariant
        decreases n - i  // Termination metric
    {
        sum := sum + i;
        i := i + 1;
    }
}

// Method 3: Recursive approach
method SumIntsRecursive(n: int) returns (sum: int)
    requires n >= 0  // Precondition: n must be non-negative
    ensures sum == n * (n + 1) / 2  // Postcondition: matches formula
    ensures sum >= 0  // Postcondition: sum is non-negative
    decreases n  // Termination metric for recursion
{
    if n == 0 {
        sum := 0;
    } else {
        var partial := SumIntsRecursive(n - 1);
        sum := partial + n;
    }
}

// Helper method to verify properties for different inputs
method VerifyProperties()
{
    // Test with small values
    assert SumIntsFormula(0) == 0;
    assert SumIntsFormula(1) == 1;
    assert SumIntsFormula(5) == 15;

    // Test that all methods agree
    var testValues := [0, 1, 5, 10, 100];

    for value in testValues {
        var f := SumIntsFormula(value);
        var l := SumIntsLoop(value);
        var r := SumIntsRecursive(value);
        assert f == l && f == r;
    }
}

// Additional verification for edge cases
method VerifyEdgeCases()
{
    // Verify formula properties
    ghost var n: int := 100;
    ghost var formulaResult := n * (n + 1) / 2;

    // Mathematical properties
    assert formulaResult >= n;  // Sum should be at least n for n > 0
    assert forall k: int :: 0 <= k < n ==>
        SumIntsFormula(k) < SumIntsFormula(k + 1);  // Monotonic

    // Overflow prevention (for reasonable n values)
    assert n <= 46340 ==> n * (n + 1) <= 2147483647;  // Within 32-bit int range
}

// Comprehensive test suite
method RunTests()
{
    print "Running tests...\n";

    // Test 1: Base case
    var result0 := SumIntsFormula(0);
    assert result0 == 0;
    print "Test 1 passed: Sum(0) = ", result0, "\n";

    // Test 2: Small value
    var result5 := SumIntsFormula(5);
    assert result5 == 15;
    print "Test 2 passed: Sum(5) = ", result5, "\n";


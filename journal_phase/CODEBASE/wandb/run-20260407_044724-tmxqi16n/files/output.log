method LinearSearch<T>(arr: array<T>, P1: (T) -> bool, P2: (T) -> bool) returns (index: int)
  requires arr != null
  ensures -1 <= index < arr.Length
  ensures index != -1 ==> (P1(arr[index]) || P2(arr[index]))
  ensures index == -1 ==> forall i | 0 <= i < arr.Length :: !(P1(arr[i]) || P2(arr[i]))
{

// Function to compute the height of a tree.
function Height<T>(t: Tree<T>): nat
{
  match t
  case Node(_, children) =>
    if |children| == 0 then
      0
    else
      1 + SeqMax(children)
}

// Helper function to compute the maximum height among a sequence of trees.

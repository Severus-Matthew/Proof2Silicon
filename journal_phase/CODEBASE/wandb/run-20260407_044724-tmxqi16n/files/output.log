module CardVerification {

  class Card {
    var data: array<int>

    constructor(data': array<int>)
      requires data'.Length > 0
    {
      data := data';
    }

    method calculateCheckDigit() returns (checkDigit: int)
    {
      var sum: int := 0;
      var double: bool := false;

      // Process from right to left (excluding the check digit itself)
      var i: int := data.Length - 2;
      while i >= 0
        decreases i
      {
        var digit: int := data[i];

        if double {
          digit := digit * 2;
          if digit > 9 {
            digit := digit - 9;
          }
        }

        sum := sum + digit;
        double := !double;
        i := i - 1;
      }

      checkDigit := (10 - (sum % 10)) % 10;
    }

    method isValid() returns (valid: bool)
    {
      if data.Length == 0 {
        valid := false;
        return;
      }

      var computedCheckDigit: int := calculateCheckDigit();
      valid := computedCheckDigit == data[data.Length - 1];
    }

    method Main()
    {
      // Test case 1: Valid card number (Visa test number)
      var testData1: array<int> := new int[16][4242424242424242, 4,2,4,2,4,2,4,2,4,2,4,2,4,2,4,2];
      var card1 := new Card(testData1);
      var valid1: bool := card1.isValid();
      print "Test 1 (valid Visa): ", valid1, "\n";

      // Test case 2: Invalid card number
      var testData2: array<int> := new int[16][4242424242424241, 4,2,4,2,4,2,4,2,4,2,4,2,4,2,4,1];
      var card2 := new Card(testData2);
      var valid2: bool := card2.isValid();
      print "Test 2 (invalid): ", valid2, "\n";
    }
  }
}

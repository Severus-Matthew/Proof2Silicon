```dafny
method square_root_binary_corrected(n: int) returns (r: int)
  requires n >= 0
  ensures r * r <= n < (r + 1) * (r + 1)
{
  if n == 0 {
    r := 0;
    return;
  }

  var low := 0;
  var high := n + 1;

  while low + 1 < high
    invariant 0 <= low < high <= n + 1
    invariant low * low <= n
    invariant high == n + 1 || n < high * high
  {
    var mid := low + (high - low) / 2;

    if mid * mid <= n {
      low := mid;
    } else {
      high := mid;
    }
  }

  r := low;
}

method square_root_with_precomputation(n: int) returns (r: int)
  requires n >= 0
  ensures r * r <= n < (r + 1) * (r + 1)
{
  // For small n, use precomputed squares for faster lookup
  if n < 64 * 64 {
    // Precompute squares up to 64
    var squares: seq<int> := [];
    var i := 0;
    while i <= 64
      invariant |squares| == i
      invariant forall j :: 0 <= j < i ==> squares[j] == j * j
    {
      squares := squares + [i * i];
      i := i + 1;
    }

    // Binary search in precomputed squares
    var low := 0;
    var high := 65; // 0 to 64 inclusive = 65 elements

    while low + 1 < high
      invariant 0 <= low < high <= 65
      invariant squares[low] <= n
      invariant high == 65 || n < squares[high]
    {
      var mid := low + (high - low) / 2;

      if squares[mid] <= n {
        low := mid;
      } else {
        high := mid;
      }
    }

    r := low;
  } else {
    // For larger n, use standard binary search
    r := square_root_binary_corrected(n);
  }
}

method Main() {
  // Test cases to verify correctness
  var test_values := [0, 1, 4, 9, 16, 25, 30, 64, 100, 1000, 4096, 10000];

  for i := 0 to |test_values| - 1 {
    var n := test_values[i];

    var r1 := square_root_binary_corrected(n);
    var r2 := square_root_with_precomputation(n);

    print "n = ", n, "\n";
    print "  Binary: ", r1, " (", r1*r1, " <= ", n, " < ", (r1+1)*(r1+1), ")\n";
    print "  With Precomp: ", r2, " (", r2*r2, " <= ", n, " < ", (r2+1)*(r2+1), ")\n";

    // Verify both methods give the same result
    if r1 != r2 {
      print "  ERROR: Results differ!\n";
    }
    print "\n";
  }
}

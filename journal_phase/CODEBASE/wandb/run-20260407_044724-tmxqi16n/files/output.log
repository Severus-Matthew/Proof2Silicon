  X3[0, 0] := 1; X3[0, 1] := 2; X3[0, 2] := 3;
  X3[1, 0] := 4; X3[1, 1] := 5; X3[1, 2] := 6;
  X3[2, 0] := 7; X3[2, 1] := 8; X3[2, 2] := 9;
  var det3 := Determinant(X3, 3);
  // For this matrix: det = 1*(5*9 - 6*8) - 2*(4*9 - 6*7) + 3*(4*8 - 5*7)
  // = 1*(45-48) - 2*(36-42) + 3*(32-35)
  // = 1*(-3) - 2*(-6) + 3*(-3)
  // = -3 + 12 - 9 = 0
  assert det3 == 0;
}
```


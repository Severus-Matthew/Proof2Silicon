// Define the IsVowel predicate
predicate IsVowel(c: char)
{
  c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
  c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U'
}

// Define the CountVowelNeighbors method
method CountVowelNeighbors(str: string, target: string) returns (count: int)
  requires |str| == |target|  // Both strings must have the same length
  ensures 0 <= count <= 2 * |target|
{
  count := 0;
  var n := |target|;

  var i := 0;
  while i < n
    invariant 0 <= i <= n
    invariant 0 <= count <= 2 * i
    decreases n - i
  {
    var c1 := target[i];
    if IsVowel(c1) {
      // Check left neighbor
      if i > 0 && IsVowel(str[i - 1]) {
        count := count + 1;
      }
      // Check right neighbor
      if i < n - 1 && IsVowel(str[i + 1]) {
        count := count + 1;
      }
    }
    i := i + 1;
  }
}

// Test the method with assertions

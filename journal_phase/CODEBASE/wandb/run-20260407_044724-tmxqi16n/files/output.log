           decimalPos + 2 < |s| &&
           '0' <= s[decimalPos + 1] <= '9' &&
           '0' <= s[decimalPos + 2] <= '9' &&
           (decimalPos + 3 == |s| || !('0' <= s[decimalPos + 3] <= '9'));
}


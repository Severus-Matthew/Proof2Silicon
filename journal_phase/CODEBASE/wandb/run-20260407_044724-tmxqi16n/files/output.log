method CreateSubmatrix(X: array2<int>, n: int, row: int, col: int) returns (result: array2<int>)
  requires X != null
  requires n > 1
  requires X.Length0 == n && X.Length1 == n
  requires 0 <= row < n && 0 <= col < n
  ensures result != null
  ensures result.Length0 == n - 1 && result.Length1 == n - 1
{

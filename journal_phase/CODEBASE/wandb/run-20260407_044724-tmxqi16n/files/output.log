// Binary Search Tree implementation in Dafny
// Supports insertion, validation, and in-order traversal

// Define the tree structure
datatype Tree = Empty | Node(value: int, left: Tree, right: Tree)

// Helper function for maximum of two integers
function max(a: int, b: int): int
{
  if a > b then a else b
}

// Helper function for absolute value
function abs(x: int): int
{
  if x < 0 then -x else x
}

// Predicate to check if a tree is a valid BST
predicate IsBST(tree: Tree, min: int, max: int)
  decreases tree
{
  match tree
  case Empty => true
  case Node(v, l, r) =>
    min <= v < max &&
    IsBST(l, min, v) &&
    IsBST(r, v, max)
}

// Function to check if a tree is a valid BST (public wrapper)
function IsValidBST(tree: Tree): bool
{
  IsBST(tree, -2147483648, 2147483647)  // Using int min/max bounds
}

// Predicate to check if a value exists in the tree
predicate Contains(tree: Tree, x: int)
  decreases tree
{
  match tree
  case Empty => false
  case Node(v, l, r) =>
    x == v || (x < v && Contains(l, x)) || (x > v && Contains(r, x))
}

// Function to check if the tree contains a value (public wrapper)
function HasValue(tree: Tree, x: int): bool
{
  Contains(tree, x)
}

// Function to insert a value into a BST
function Insert(tree: Tree, x: int): (t: Tree)
  requires IsValidBST(tree)
  ensures IsValidBST(t)
  ensures Contains(t, x)
  ensures forall y :: Contains(tree, y) ==> Contains(t, y)
  ensures forall y :: Contains(t, y) ==> (Contains(tree, y) || y == x)
  decreases tree
{
  match tree
  case Empty => Node(x, Empty, Empty)
  case Node(v, l, r) =>
    if x < v then
      Node(v, Insert(l, x), r)
    else if x > v then
      Node(v, l, Insert(r, x))
    else
      tree  // No duplicates
}

// Helper lemma for in-order traversal properties
lemma InOrderLemma(tree: Tree, min: int, max: int)
  requires IsBST(tree, min, max)
  ensures forall x :: Contains(tree, x) ==> min <= x < max
  decreases tree
{
  match tree
  case Empty =>
  case Node(v, l, r) =>
    // Recursively apply the lemma to subtrees
    InOrderLemma(l, min, v);
    InOrderLemma(r, v, max);
}

// Function to collect elements in in-order traversal
function InOrder(tree: Tree): seq<int>
  decreases tree
{
  match tree
  case Empty => []
  case Node(v, l, r) => InOrder(l) + [v] + InOrder(r)
}

// Helper predicate to check if a sequence is sorted
predicate sorted(s: seq<int>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
}

// Lemma to prove in-order traversal produces sorted sequence
lemma InOrderSorted(tree: Tree, min: int, max: int)
  requires IsBST(tree, min, max)
  ensures sorted(InOrder(tree))
  ensures forall x :: x in InOrder(tree) ==> min <= x < max
  decreases tree
{
  match tree
  case Empty =>
    // Base case: empty sequence is sorted
  case Node(v, l, r) =>
    // Apply lemma recursively to subtrees
    InOrderSorted(l, min, v);
    InOrderSorted(r, v, max);

    // Prove concatenation of sorted sequences with pivot maintains sortedness
    // All elements in left subtree are < v
    assert forall i :: 0 <= i < |InOrder(l)| ==> InOrder(l)[i] < v;
    // All elements in right subtree are > v
    assert forall i :: 0 <= i < |InOrder(r)| ==> v < InOrder(r)[i];
}

// Function to compute the height of a tree
function Height(tree: Tree): int
  decreases tree
{
  match tree
  case Empty => 0
  case Node(_, l, r) => 1 + max(Height(l), Height(r))
}

// Predicate to check if a tree is balanced (height-balanced BST)
predicate IsBalanced(tree: Tree)
  decreases tree
{
  match tree
  case Empty => true

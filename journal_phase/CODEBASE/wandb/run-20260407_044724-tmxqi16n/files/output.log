```dafny
method removeElement<T(==)>(arr: array<T>, val: T) returns (newLength: int)
  modifies arr
  ensures newLength <= arr.Length
  ensures forall i :: 0 <= i < newLength ==> arr[i] != val
  ensures forall i :: 0 <= i < newLength ==> old(arr[i]) == arr[i]
  ensures forall i :: newLength <= i < arr.Length ==> arr[i] == old(arr[i])
{
  var writeIndex := 0;
  var readIndex := 0;

  while readIndex < arr.Length
    invariant 0 <= writeIndex <= readIndex <= arr.Length
    invariant forall i :: 0 <= i < writeIndex ==> arr[i] != val
    invariant forall i :: 0 <= i < writeIndex ==> old(arr[i]) == arr[i]
    invariant forall i :: writeIndex <= i < arr.Length ==> arr[i] == old(arr[i])
  {
    if arr[readIndex] != val {
      if writeIndex != readIndex {
        arr[writeIndex] := arr[readIndex];
      }
      writeIndex := writeIndex + 1;
    }
    readIndex := readIndex + 1;
  }

  newLength := writeIndex;
}

// Test method to verify the implementation
method TestRemoveElement() {
  var arr := new int[5][1, 2, 3, 2, 4];
  var length := removeElement(arr, 2);

  assert length == 3;
  assert arr[0] == 1;
  assert arr[1] == 3;
  assert arr[2] == 4;
  // Elements at indices 3 and 4 remain unchanged
  assert arr[3] == 2;
  assert arr[4] == 4;
}
```

This Dafny implementation:

1. **Minimizes writes**: Only performs a write when necessary (when `writeIndex != readIndex`)
2. **Maintains correctness**: The postconditions ensure:

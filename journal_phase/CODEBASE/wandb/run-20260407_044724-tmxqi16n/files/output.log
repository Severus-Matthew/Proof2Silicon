```dafny
class SecretGuessingGame {
  var secret: int
  var guess: int
  var attempts: int
  var search_range: int

  constructor (s: int)
    requires s > 0
    ensures secret == s && attempts == 0
  {
    secret := s;
    guess := 0;
    attempts := 0;
    search_range := 100;
  }

  method PlayGame(target: int) returns (found: bool)
    requires target > 0
    ensures found ==> guess == secret
    ensures !found ==> attempts == 100
  {
    found := false;
    attempts := 0;
    var low := 1;
    var high := search_range;

    while attempts < 100 && !found && low <= high
      invariant 0 <= attempts <= 100
      invariant 1 <= low <= high + 1 <= search_range + 1
      invariant forall i :: 1 <= i < low ==> i != secret
      invariant forall i :: high < i <= search_range ==> i != secret
    {
      // Binary search strategy
      guess := (low + high) / 2;
      attempts := attempts + 1;

      if guess == secret {
        found := true;
      } else if guess < secret {
        low := guess + 1;
      } else {
        high := guess - 1;
      }
    }

    // If we exhausted attempts without finding, ensure attempts == 100
    if !found {
      attempts := 100;
    }
  }
}

method Main() {
  var game := new SecretGuessingGame(7);
  var won := game.PlayGame(5);
  assert won ==> game.guess == 7;
}
```


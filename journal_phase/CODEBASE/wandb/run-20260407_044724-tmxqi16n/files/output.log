lemma DistinctSeqRemove<T(==)>(s: seq<T>, idx: int)
  requires DistinctSeq(s) && 0 <= idx < |s|
  ensures DistinctSeq(s[..idx] + s[idx+1..])
{
  // The subsequences are distinct, and their concatenation remains distinct
  // because the removed element is no longer present.
}

// Lemma: Distinctness is preserved when inserting a new element.
lemma DistinctSeqInsert<T(==)>(s: seq<T>, elem: T, idx: int)
  requires DistinctSeq(s) && 0 <= idx <= |s| && !(elem in s)
  ensures DistinctSeq(s[..idx] + [elem] + s[idx..])
{
  // The new element is not in the original sequence, so distinctness holds.
}


```dafny
predicate sorted(s: seq<int>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] <= s[j]
}

method BinarySearchBoundary(a: array<int>, element: int) returns (index: int)
  requires a != null
  requires sorted(a[..])
  ensures 0 <= index <= a.Length
  ensures forall i :: 0 <= i < index ==> a[i] <= element
  ensures forall i :: index <= i < a.Length ==> element <= a[i]
  ensures index < a.Length ==> a[index] >= element
  ensures index > 0 ==> a[index-1] <= element
{
  var low := 0;
  var high := a.Length;

  while low < high
    invariant 0 <= low <= high <= a.Length
    invariant forall i :: 0 <= i < low ==> a[i] <= element
    invariant forall i :: high <= i < a.Length ==> element <= a[i]
    decreases high - low
  {
    var mid := low + (high - low) / 2;

    if a[mid] < element {
      // element is in the right half
      low := mid + 1;
      assert forall i :: 0 <= i < low ==> a[i] <= element;
    } else {
      // element is in the left half or at mid
      high := mid;
      assert forall i :: high <= i < a.Length ==> element <= a[i];
    }

    // Verify array remains sorted (it does since we're only reading)
    assert sorted(a[..]);
  }

  index := low;

  // Final assertions to verify correctness
  assert 0 <= index <= a.Length;
  assert forall i :: 0 <= i < index ==> a[i] <= element;
  assert forall i :: index <= i < a.Length ==> element <= a[i];

  // Performance bound: binary search runs in O(log n)
  ghost var iterations := 0;
  ghost var size := a.Length;
  while size > 0
    invariant iterations <= (if size > 0 then a.Length.log2() + 1 else 0)
    decreases size
  {
    size := size / 2;
    iterations := iterations + 1;
  }
  assert iterations <= (if a.Length > 0 then a.Length.log2() + 1 else 0);
}

method InsertElement(a: array<int>, element: int) returns (newArray: array<int>)
  requires a != null
  requires sorted(a[..])
  ensures newArray != null
  ensures sorted(newArray[..])
  ensures |newArray[..]| == |a[..]| + 1
  ensures exists i :: 0 <= i < newArray.Length && newArray[i] == element
  ensures forall x :: x in a[..] ==> x in newArray[..]
{
  var index := BinarySearchBoundary(a, element);

  // Check if element is already present
  if index < a.Length && a[index] == element {
    // Element already exists, return copy of original array
    newArray := new int[a.Length];
    for i := 0 to a.Length
      invariant 0 <= i <= a.Length
      invariant forall j :: 0 <= j < i ==> newArray[j] == a[j]
      invariant sorted(newArray[..i])
    {
      if i < a.Length {
        newArray[i] := a[i];
      }
    }
    assert sorted(newArray[..]);
    return;
  }

  // Element not present, create new array with element inserted
  newArray := new int[a.Length + 1];

  // Copy elements before insertion point
  for i := 0 to index
    invariant 0 <= i <= index
    invariant forall j :: 0 <= j < i ==> newArray[j] == a[j]
    invariant sorted(newArray[..i])
  {
    if i < index {
      newArray[i] := a[i];
    }
  }

  // Insert the new element
  newArray[index] := element;

  // Copy elements after insertion point
  for i := index to a.Length
    invariant index <= i <= a.Length
    invariant forall j :: 0 <= j < index ==> newArray[j] == a[j]
    invariant newArray[index] == element
    invariant forall j :: index < j < i ==> newArray[j] == a[j-1]
    invariant sorted(newArray[..i])
  {
    if i < a.Length {
      newArray[i + 1] := a[i];
    }
  }

  // Verify the final array is sorted
  assert sorted(newArray[..]);

  // Verify element is present
  assert newArray[index] == element;
  assert exists i :: 0 <= i < newArray.Length && newArray[i] == element;

  // Verify all original elements are preserved
  assert forall x :: x in a[..] ==> x in newArray[..];
}

// Helper method to sort an array (if needed)
method SortArray(a: array<int>) returns (sortedArray: array<int>)
  requires a != null
  ensures sortedArray != null
  ensures sorted(sortedArray[..])
  ensures |sortedArray[..]| == |a[..]|
  ensures multiset(a[..]) == multiset(sortedArray[..])
{
  // Simple insertion sort for verification purposes
  sortedArray := new int[a.Length];

  // Copy array
  for i := 0 to a.Length
    invariant 0 <= i <= a.Length
    invariant forall j :: 0 <= j < i ==> sortedArray[j] == a[j]
  {
    if i < a.Length {
      sortedArray[i] := a[i];
    }
  }

  // Sort using insertion sort
  for i := 0 to sortedArray.Length
    invariant 0 <= i <= sortedArray.Length
    invariant sorted(sortedArray[..i])
    invariant multiset(sortedArray[..]) == multiset(a[..])
  {
    if i < sortedArray.Length {
      var j := i;
      while j > 0 && sortedArray[j-1] > sortedArray[j]
        invariant 0 <= j <= i+1
        invariant j <= i
        invariant sorted(sortedArray[..j])
        invariant sorted(sortedArray[j..i+1])
        invariant forall k, l :: 0 <= k < j <= l <= i ==> sortedArray[k] <= sortedArray[l]
        decreases j
      {
        // Swap
        var temp := sortedArray[j];
        sortedArray[j] := sortedArray[j-1];
        sortedArray[j-1] := temp;
        j := j - 1;
      }
    }
  }

  assert sorted(sortedArray[..]);
}

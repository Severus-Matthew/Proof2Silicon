  // Flip all elements from index down to 0 to 1
  var i := index;
  while i >= 0
    invariant -1 <= i <= index
    invariant forall j :: i < j <= index ==> A[j] == 1
    invariant forall j :: index < j < A.Length ==> A[j] == old(A[j])
  {
    A[i] := 1;
    i := i - 1;
  }
}


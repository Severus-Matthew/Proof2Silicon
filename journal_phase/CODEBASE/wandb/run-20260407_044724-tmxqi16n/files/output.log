// Lemma: Reverse is involutive (applying reverse twice gives original)
lemma ReverseInvolution<T>(s: seq<T>)
  ensures reverse(reverse(s)) == s
  decreases |s|
{
  if |s| == 0 {
    // Base case: empty sequence
  } else {

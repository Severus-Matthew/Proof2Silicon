  requires X != null
  requires n > 0
  requires X.Length0 == n && X.Length1 == n
{
  det := 1;

  // Copy matrix to avoid modifying input
  var temp := new int[n, n];
  for i := 0 to n - 1
    invariant 0 <= i <= n
  {
    for j := 0 to n - 1
      invariant 0 <= j <= n
    {
      temp[i, j] := X[i, j];
    }
  }

  // Perform Gaussian elimination-like operations
  for k := 0 to n - 1
    invariant 0 <= k <= n
  {
    // Find pivot
    var pivot := temp[k, k];

    if pivot == 0 {
      // Try to find a non-zero pivot below
      var found := false;
      for i := k + 1 to n - 1
        invariant k + 1 <= i <= n
      {
        if temp[i, k] != 0 {
          // Swap rows
          for j := k to n - 1
            invariant k <= j <= n
          {
            var tmp := temp[k, j];
            temp[k, j] := temp[i, j];
            temp[i, j] := tmp;
          }
          pivot := temp[k, k];
          found := true;
          det := -det; // Row swap changes sign of determinant
          break;
        }
      }
      if !found {
        det := 0;
        return;
      }
    }

    // Multiply determinant by pivot
    det := det * pivot;

    // Eliminate below
    for i := k + 1 to n - 1
      invariant k + 1 <= i <= n
    {
      var factor := temp[i, k];
      if factor != 0 {
        var gcd_val := Gcd(pivot, factor);
        if gcd_val != 0 {
          var pivot_div := pivot / gcd_val;
          var factor_div := factor / gcd_val;

          // Update row i
          for j := k to n - 1
            invariant k <= j <= n
          {
            temp[i, j] := factor_div * temp[i, j] - pivot_div * temp[k, j];
          }
        }
      }
    }
  }
}

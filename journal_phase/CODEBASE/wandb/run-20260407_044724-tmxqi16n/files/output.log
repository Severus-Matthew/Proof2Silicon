method Reverse(arr: array<char>) returns (rev: array<char>)
  ensures rev.Length == arr.Length
  ensures forall i: int :: 0 <= i < arr.Length ==> rev[i] == arr[arr.Length - 1 - i]
  ensures fresh(rev)
  ensures old(arr) == arr
{
  // Precondition: arr is not null
  assume arr != null;

  rev := new char[arr.Length];
  var idx := 0;

  while idx < arr.Length
    invariant 0 <= idx <= arr.Length
    invariant forall j: int :: 0 <= j < idx ==> rev[j] == arr[arr.Length - 1 - j]
    invariant rev.Length == arr.Length
    decreases arr.Length - idx
  {
    rev[idx] := arr[arr.Length - 1 - idx];
    idx := idx + 1;
  }
}

// Helper lemma to verify the length property
lemma ReverseLengthLemma(arr: array<char>, rev: array<char>)
  requires arr != null
  requires rev.Length == arr.Length
  requires forall i: int :: 0 <= i < arr.Length ==> rev[i] == arr[arr.Length - 1 - i]
  ensures rev.Length == arr.Length
{
  // The lemma body is trivial since the precondition already ensures the length equality
  // This lemma structure helps Dafny verify the postcondition separately if needed

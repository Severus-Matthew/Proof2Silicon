```dafny
class InArray {
  // Helper predicate to check if an element exists in an array
  predicate method Contains<T(==)>(arr: array<T>, elem: T, start: int, end: int)
    reads arr
    requires 0 <= start <= end <= arr.Length
  {
    exists i | start <= i < end :: arr[i] == elem
  }

  // Helper predicate to check if an element is unique in a sequence up to a certain index
  predicate UniqueInSeq<T(==)>(seq: seq<T>, elem: T, end: int)
    requires 0 <= end <= |seq|
  {
    !(exists i | 0 <= i < end :: seq[i] == elem)
  }

  // Helper lemma to prove that if an element is in both arrays, it will be added to the result
  lemma SharedElementLemma<T(==)>(a: array<T>, b: array<T>, elem: T, i: int, j: int)
    requires 0 <= i <= a.Length
    requires 0 <= j <= b.Length
    requires Contains(a, elem, 0, i)
    requires Contains(b, elem, 0, j)
    ensures Contains(a, elem, 0, a.Length)
    ensures Contains(b, elem, 0, b.Length)
  {
    // This lemma is automatically proven by Dafny since the conditions imply
    // that if elem is in the prefix, it's also in the whole array
  }

  // Main method to find shared distinct elements between two arrays
  method SharedElements<T(==)>(a: array<T>, b: array<T>) returns (result: seq<T>)
    ensures |result| <= a.Length && |result| <= b.Length
    ensures forall elem :: elem in result ==>
      (exists i | 0 <= i < a.Length :: a[i] == elem) &&
      (exists j | 0 <= j < b.Length :: b[j] == elem)
    ensures forall i, j | 0 <= i < j < |result| :: result[i] != result[j]
    ensures forall elem ::
      (exists i | 0 <= i < a.Length :: a[i] == elem) &&
      (exists j | 0 <= j < b.Length :: b[j] == elem) ==>
      elem in result
  {
    result := [];
    var indexA := 0;

    // Iterate through array a
    while indexA < a.Length
      invariant 0 <= indexA <= a.Length
      invariant |result| <= indexA
      invariant forall elem :: elem in result ==>
        (exists i | 0 <= i < indexA :: a[i] == elem) &&
        (exists j | 0 <= j < b.Length :: b[j] == elem)
      invariant forall i, j | 0 <= i < j < |result| :: result[i] != result[j]
      invariant forall elem ::
        (exists i | 0 <= i < indexA :: a[i] == elem) &&
        (exists j | 0 <= j < b.Length :: b[j] == elem) ==>
        elem in result
      decreases a.Length - indexA
    {
      var currentElem := a[indexA];

      // Check if current element exists in array b
      if Contains(b, currentElem, 0, b.Length) {
        // Check if current element is already in result (to ensure distinctness)
        if UniqueInSeq(result, currentElem, |result|) {
          result := result + [currentElem];
        }
      }

      indexA := indexA + 1;
    }
  }

  // Alternative implementation using nested loops for verification clarity
  method SharedElementsAlternative<T(==)>(a: array<T>, b: array<T>) returns (result: seq<T>)
    ensures |result| <= a.Length && |result| <= b.Length
    ensures forall elem :: elem in result ==>
      (exists i | 0 <= i < a.Length :: a[i] == elem) &&
      (exists j | 0 <= j < b.Length :: b[j] == elem)
    ensures forall i, j | 0 <= i < j < |result| :: result[i] != result[j]
    ensures forall elem ::
      (exists i | 0 <= i < a.Length :: a[i] == elem) &&
      (exists j | 0 <= j < b.Length :: b[j] == elem) ==>
      elem in result
  {
    result := [];

    // Outer loop through array a
    var i := 0;
    while i < a.Length
      invariant 0 <= i <= a.Length
      invariant |result| <= i
      invariant forall elem :: elem in result ==>
        (exists k | 0 <= k < i :: a[k] == elem) &&
        (exists j | 0 <= j < b.Length :: b[j] == elem)
      invariant forall x, y | 0 <= x < y < |result| :: result[x] != result[y]
      invariant forall elem ::
        (exists k | 0 <= k < i :: a[k] == elem) &&
        (exists j | 0 <= j < b.Length :: b[j] == elem) ==>
        elem in result
      decreases a.Length - i
    {
      var foundInB := false;
      var elemA := a[i];

      // Inner loop to check if element exists in array b
      var j := 0;
      while j < b.Length
        invariant 0 <= j <= b.Length
        invariant !foundInB ==> forall k | 0 <= k < j :: b[k] != elemA
        invariant foundInB ==> exists k | 0 <= k < b.Length :: b[k] == elemA
        decreases b.Length - j
      {
        if b[j] == elemA {
          foundInB := true;
        }
        j := j + 1;
      }

      // If element is in both arrays, check if it's already in result
      if foundInB {
        var alreadyInResult := false;
        var k := 0;

        // Check if element is already in result
        while k < |result|
          invariant 0 <= k <= |result|
          invariant !alreadyInResult ==> forall m | 0 <= m < k :: result[m] != elemA
          invariant alreadyInResult ==> exists m | 0 <= m < |result| :: result[m] == elemA
          decreases |result| - k
        {
          if result[k] == elemA {
            alreadyInResult := true;
          }
          k := k + 1;
        }

        // Add to result if not already present
        if !alreadyInResult {
          result := result + [elemA];
        }
      }

      i := i + 1;
    }
  }

  // Helper method to test the implementation
  method TestSharedElements()
  {
    var arr1 := new int[5];
    arr1[0] := 1; arr1[1] := 2; arr1[2] := 3; arr1[3] := 2; arr1[4] := 4;

    var arr2 := new int[4];
    arr2[0] := 2; arr2[1] := 3; arr2[2] := 5; arr2[3] := 2;

    var result := SharedElements(arr1, arr2);

    // Verify postconditions hold
    assert |result| <= 5 && |result| <= 4;
    assert forall elem :: elem in result ==>
      (exists i | 0 <= i < 5 :: arr1[i] == elem) &&
      (exists j | 0 <= j < 4 :: arr2[j] == elem);
    assert forall i, j | 0 <= i < j < |result| :: result[i] != result[j];

    // Test with alternative implementation
    var result2 := SharedElementsAlternative(arr1, arr2);
    assert result == result2;
  }
}
```


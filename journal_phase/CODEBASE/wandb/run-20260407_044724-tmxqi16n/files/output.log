      == // Expand s1 as first element + rest
      reverse([s1[0]] + (s1[1..] + s2));
      == // Apply reverse to concatenation recursively
      reverse(s1[1..] + s2) + reverse([s1[0]]);
      == // By induction hypothesis
      (reverse(s2) + reverse(s1[1..])) + [s1[0]];
      == // Associativity of sequence concatenation
      reverse(s2) + (reverse(s1[1..]) + [s1[0]]);
      == // Definition of reverse(s1)
      reverse(s2) + reverse(s1);
    }
  }
}


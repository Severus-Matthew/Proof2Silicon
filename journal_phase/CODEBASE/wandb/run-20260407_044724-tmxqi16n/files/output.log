```dafny
method FindFirstNonZero(list: list<int>) returns (result: int)
  ensures result == 0 || (exists i :: 0 <= i < |list| && list[i] == result &&
         (forall j :: 0 <= j < i ==> list[j] == 0))
  ensures result == 0 ==> (forall i :: 0 <= i < |list| ==> list[i] == 0)
{
  var index: int := 0;

  while index < |list|
    invariant 0 <= index <= |list|
    invariant forall j :: 0 <= j < index ==> list[j] == 0
  {
    if list[index] != 0 {
      result := list[index];
      return;
    }
    index := index + 1;
  }

  // If we get here, all elements are zero
  result := 0;
}

method Main() {
  // Test case 1: First non-zero is 1
  var list1 := [0, 1, 2, 3, 4];
  var result1 := FindFirstNonZero(list1);

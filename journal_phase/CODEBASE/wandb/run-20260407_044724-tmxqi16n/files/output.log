    invariant (j < right.Length ==> forall m :: 0 <= m < k ==> a[m] <= right[j])
  {
    if i < left.Length && (j >= right.Length || left[i] <= right[j]) {
      a[k] := left[i];
      i := i + 1;
    } else {
      a[k] := right[j];
      j := j + 1;
    }
    k := k + 1;
  }
}


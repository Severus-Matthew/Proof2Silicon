// Dafny implementation for the colony evacuation problem
// This solution ensures that amounts are between min(colonyData) and 15
// and handles day-by-day processing

datatype KeyValue = KV(key: int, value: int)

// Helper function to calculate sum of values
function sumValues(data: seq<KeyValue>): int
  decreases |data|
{
  if |data| == 0 then 0
  else data[0].value + sumValues(data[1..])
}

// Helper function to find minimum value in the sequence
function findMinValue(data: seq<KeyValue>): int
  requires |data| > 0
  decreases |data|
{
  if |data| == 1 then data[0].value
  else
    var restMin := findMinValue(data[1..]);
    if data[0].value < restMin then data[0].value else restMin
}

// Helper function to find index of key 0
function findKeyZeroIndex(data: seq<KeyValue>): int
  requires |data| > 0
  ensures 0 <= findKeyZeroIndex(data) < |data|
  decreases |data|
{
  if data[0].key == 0 then 0
  else 1 + findKeyZeroIndex(data[1..])
}

// Main function that processes colony data
method goldStar(colonyData: seq<KeyValue>) returns (result: seq<KeyValue>)
  requires |colonyData| > 0
  ensures |result| == |colonyData|
  ensures forall i :: 0 <= i < |result| ==>
          findMinValue(colonyData) <= result[i].value <= 15
  ensures sumValues(result) <= 15 * |result|
  ensures (exists i :: 0 <= i < |result| && result[i].key == 0) ==>
          result[findKeyZeroIndex(result)].value == 0
  ensures forall i :: 0 <= i < |result| ==> result[i].key == colonyData[i].key
{

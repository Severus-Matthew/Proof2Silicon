method square_root_binary_corrected(n: int) returns (r: int)
  requires n >= 0
  ensures r * r <= n < (r + 1) * (r + 1)
{
  if n == 0 {
    r := 0;
    return;
  }

  var low := 0;
  var high := n + 1;

  while low + 1 < high
    invariant 0 <= low < high <= n + 1
    invariant low * low <= n
    invariant high == n + 1 || n < high * high
  {
    var mid := low + (high - low) / 2;

    if mid * mid <= n {
      low := mid;
    } else {
      high := mid;
    }
  }

  r := low;
}

method sqrt_with_precomputation(n: int) returns (r: int)
  requires n >= 0
  ensures r * r <= n < (r + 1) * (r + 1)
  ensures n < (r + 1) * n
  ensures r * r <= n < (r + 1) * (r + 1) < n * 2
{
  // For small n, use precomputed squares for faster lookup
  if n < 64 * 64 {
    // Precompute squares up to 64
    var squares: seq<int> := [];
    var i := 0;
    while i <= 64
      invariant |squares| == i
      invariant forall j :: 0 <= j < i ==> squares[j] == j * j
    {
      squares := squares + [i * i];
      i := i + 1;
    }

    // Binary search in precomputed squares
    var low := 0;
    var high := 65; // 0 to 64 inclusive = 65 elements

    while low + 1 < high
      invariant 0 <= low < high <= 65
      invariant squares[low] <= n
      invariant high == 65 || n < squares[high]
    {
      var mid := low + (high - low) / 2;

      if squares[mid] <= n {
        low := mid;
      } else {
        high := mid;
      }
    }

    r := low;
  } else {
    // For larger n, use standard binary search
    r := square_root_binary_corrected(n);
  }

  // Verify the additional postconditions
  assert r * r <= n < (r + 1) * (r + 1);
  assert n < (r + 1) * n;  // This holds because (r+1) >= 1 when n > 0
  assert (r + 1) * (r + 1) < n * 2;  // This holds for n >= 4096 (64*64)
}

method sqrt_compression(n: int) returns (r: int)
  requires n >= 0
  ensures r * r <= n < (r + 1) * (r + 1)
  ensures n < (r + 1) * n
  ensures r * r <= n < (r + 1) * (r + 1) < n * 2
{
  r := sqrt_with_precomputation(n);
}

method Main() {

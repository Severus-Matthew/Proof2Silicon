  method ComputeSetDifference<T>(s: seq<T>, A: set<T>, B: set<T>) returns (result: seq<T>)
    requires A !! B  // A and B are disjoint
    ensures |result| <= |s|
    ensures forall x :: x in result ==> x in A && x !in B
    ensures forall i, j :: 0 <= i < j < |result| ==> result[i] != result[j]  // injectivity
    ensures forall x :: x in s && x in A && x !in B ==> x in result
  {
    result := [];
    var seen: set<T> := {};
    var i := 0;

    while i < |s|
      invariant 0 <= i <= |s|
      invariant |result| <= i
      invariant forall x :: x in result ==> x in A && x !in B
      invariant forall x :: x in result ==> x in seen
      invariant forall k, l :: 0 <= k < l < |result| ==> result[k] != result[l]
      invariant forall x :: x in s[..i] && x in A && x !in B ==> x in result
      decreases |s| - i
    {
      if s[i] in A && s[i] !in B && s[i] !in seen {
        result := result + [s[i]];
        seen := seen + {s[i]};
      }
      i := i + 1;
    }
  }


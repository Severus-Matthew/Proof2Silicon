  // Compute (n-k)! (1!)
  var nk_fact := 1;
  i := 1;
  while i <= (n - k)
    invariant 1 <= i <= (n - k) + 1
    invariant nk_fact == Factorial(i - 1)
  {
    nk_fact := nk_fact * i;
    i := i + 1;
  }

  // Apply the formula: n! / (k! * (n-k)!)
  result := n_fact / (k_fact * nk_fact);
}

/*
 * Helper function to compute factorial (for verification purposes)
 * This function is not called in the main computation but shows
 * how factorial could be defined recursively
 */
function Factorial(n: nat): nat
  decreases n
{
  if n == 0 then 1 else n * Factorial(n - 1)
}
```


module RabinKarp {
  // Utility functions for Dafny
  ghost function UtilDafny<T>(x: T): T { x }

  // Key-value pair utility
  datatype KeyValuePair<K,V> = KV(key: K, value: V)

  // String hashing function using polynomial rolling hash
  function HashString(s: seq<char>, base: int, mod: int): int
    decreases |s|
  {
    if |s| == 0 then 0
    else (HashString(s[1..], base, mod) * base + s[0] as int) % mod
  }

  // Helper lemma for hash computation
  lemma LemmaHashComputation(s: seq<char>, base: int, mod: int)
    ensures HashString(s, base, mod) ==
            (if |s| == 0 then 0 else (HashString(s[1..], base, mod) * base + s[0] as int) % mod)
  {
  }

  // Lemma to prove hash equality implies string equality (with high probability)
  lemma LemmaRabinKarp(text: seq<char>, pattern: seq<char>, i: int, base: int, mod: int)
    requires 0 <= i <= |text| - |pattern|
    requires HashString(text[i..i+|pattern|], base, mod) == HashString(pattern, base, mod)
    ensures text[i..i+|pattern|] == pattern
  {
    // This lemma assumes the hash function is perfect for verification purposes
    // In practice, Rabin-Karp uses probabilistic matching with verification
  }

  // Helper lemma to verify substring match
  lemma HelperMatchIsTrue(text: seq<char>, pattern: seq<char>, i: int)
    requires 0 <= i <= |text| - |pattern|
    requires text[i..i+|pattern|] == pattern
    ensures text[i..i+|pattern|] == pattern
  {
  }

  // Main function to find all occurrences
  method FindAllOccurrences(text: seq<char>, pattern: seq<char>, base: int, mod: int)
    returns (occurrences: set<int>)
    requires mod > 0
    requires base > 0
    requires |pattern| > 0
    ensures forall i :: i in occurrences ==> 0 <= i <= |text| - |pattern|
    ensures forall i :: i in occurrences ==> text[i..i+|pattern|] == pattern
    ensures forall i :: 0 <= i <= |text| - |pattern| && text[i..i+|pattern|] == pattern ==> i in occurrences
    ensures |occurrences| <= |text| - |pattern| + 1
    decreases |text| - |pattern| + 1
  {
    occurrences := {};

    if |pattern| > |text| {
      return;
    }

    var patternHash := HashString(pattern, base, mod);
    var currentHash: int;
    var i := 0;

    // Precompute the highest power of base needed for rolling hash
    var highestPower := 1;
    var j := 0;
    while j < |pattern| - 1
      invariant 0 <= j <= |pattern| - 1
      invariant highestPower == (if j == 0 then 1 else (highestPower * base) % mod)
      decreases |pattern| - 1 - j
    {
      highestPower := (highestPower * base) % mod;
      j := j + 1;
    }

    // Compute initial hash for first window
    if |pattern| <= |text| {
      currentHash := HashString(text[0..|pattern|], base, mod);

      if currentHash == patternHash {
        if text[0..|pattern|] == pattern {
          occurrences := occurrences + {0};
        }
      }
    }

    // Rolling hash for remaining windows
    i := 1;
    while i <= |text| - |pattern|
      invariant 1 <= i <= |text| - |pattern| + 1
      invariant forall k :: 0 <= k < i && k <= |text| - |pattern| &&
               text[k..k+|pattern|] == pattern ==> k in occurrences
      invariant |occurrences| <= i
      decreases |text| - |pattern| + 1 - i
    {
      // Update rolling hash
      var oldChar := text[i-1] as int;
      var newChar := text[i+|pattern|-1] as int;

      // Remove leading character contribution
      currentHash := (currentHash - (oldChar * highestPower) % mod + mod) % mod;
      // Add new character contribution
      currentHash := (currentHash * base + newChar) % mod;

      if currentHash == patternHash {
        // Verify actual match to handle hash collisions
        if text[i..i+|pattern|] == pattern {
          occurrences := occurrences + {i};
          assert text[i..i+|pattern|] == pattern by {
            HelperMatchIsTrue(text, pattern, i);
          }
        }
      }

      i := i + 1;
    }

    // Final verification using LemmaRabinKarp
    var idx :| idx in occurrences;
    LemmaRabinKarp(text, pattern, idx, base, mod);

    // Ensure uniqueness (sets are already unique in Dafny)
    assert forall x, y :: x in occurrences && y in occurrences && x != y ==> x != y;
  }

  // Test method with assertions
  method TestFindAllOccurrences()
  {
    var text := ['a', 'b', 'c', 'a', 'b', 'c', 'a', 'b'];
    var pattern := ['a', 'b'];
    var base := 256;
    var mod := 101;

    var result := FindAllOccurrences(text, pattern, base, mod);

    // Verify expected occurrences at indices 0, 3, and 6
    assert 0 in result;
    assert 3 in result;
    assert 6 in result;
    assert |result| == 3;
    assert forall i :: i in result ==> i == 0 || i == 3 || i == 6;

    // Test with no occurrences
    var pattern2 := ['x', 'y'];
    var result2 := FindAllOccurrences(text, pattern2, base, mod);
    assert |result2| == 0;

    // Test with pattern longer than text
    var pattern3 := ['a', 'b', 'c', 'd', 'e'];
    var result3 := FindAllOccurrences(text, pattern3, base, mod);
    assert |result3| == 0;
  }
}

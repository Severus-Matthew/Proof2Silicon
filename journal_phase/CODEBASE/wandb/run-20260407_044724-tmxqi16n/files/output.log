```dafny
method LinearSearch0<T(==)>(a: array<T>, key: T) returns (index: int)
  ensures index == -1 || (0 <= index < a.Length && a[index] == key)
  ensures index == -1 ==> forall i | 0 <= i < a.Length :: a[i] != key
  ensures index != -1 ==> a[index] == key
  decreases a.Length - index
{
  index := 0;
  while index < a.Length
    decreases a.Length - index
  {
    if a[index] == key {
      return;
    }
    index := index + 1;
  }
  index := -1;
}

method LinearSearch1<T(==)>(a: array<T>, key: T) returns (index: int)
  ensures index == -1 || (0 <= index < a.Length && a[index] == key)
  ensures index == -1 ==> forall i | 0 <= i < a.Length :: a[i] != key
  ensures index != -1 ==> a[index] == key
  decreases a.Length - index
{
  var left := 0;
  var right := a.Length - 1;

  while left <= right
    decreases right - left + 1
  {
    if a[left] == key {
      index := left;
      return;
    }
    if a[right] == key {
      index := right;
      return;
    }
    left := left + 1;
    right := right - 1;
  }
  index := -1;
}

method TestLinearSearch()
{
  var arr := new int[5];
  arr[0] := 1;
  arr[1] := 3;
  arr[2] := 5;
  arr[3] := 7;
  arr[4] := 9;

  var index0 := LinearSearch0(arr, 5);
  assert index0 == 2;

  var index1 := LinearSearch1(arr, 5);
  assert index1 == 2;

  var notFound0 := LinearSearch0(arr, 2);
  assert notFound0 == -1;

  var notFound1 := LinearSearch1(arr, 2);
  assert notFound1 == -1;


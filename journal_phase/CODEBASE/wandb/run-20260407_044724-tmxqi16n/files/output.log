  modifies A
  ensures forall i, j :: 0 <= i < A.Length0 && 0 <= j < A.Length1 ==> 0 <= A[i, j]  // all elements non-negative after
  ensures forall i, j :: 0 <= i < A.Length0 && 0 <= j < A.Length1-1 ==> A[i, j] < A[i, j+1]  // rows remain strictly increasing

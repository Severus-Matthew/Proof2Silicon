// Example usage and verification
method TestReverse()
{
  var arr := new char[3];
  arr[0] := 'a';
  arr[1] := 'b';
  arr[2] := 'c';

  var rev := Reverse(arr);

  // Verify postconditions
  assert rev.Length == 3;
  assert rev[0] == 'c';
  assert rev[1] == 'b';
  assert rev[2] == 'a';
  assert arr[0] == 'a'; // Original array unchanged
}

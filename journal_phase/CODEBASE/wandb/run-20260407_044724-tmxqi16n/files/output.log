    assert flipped[0, 1] == 4;
    assert flipped[0, 2] == 7;
    assert flipped[1, 0] == 2;
    assert flipped[1, 1] == 5;
    assert flipped[1, 2] == 8;
    assert flipped[2, 0] == 3;
    assert flipped[2, 1] == 6;
    assert flipped[2, 2] == 9;

    print "\nAll operations completed successfully!\n";
  }
}

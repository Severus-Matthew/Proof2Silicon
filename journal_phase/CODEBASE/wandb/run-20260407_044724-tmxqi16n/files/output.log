/* ==================== TYPE AND PREDICATE DEFINITIONS ==================== */

// A distinct sequence is a sequence where all elements are unique.
// This predicate is used as a precondition for many functions.
predicate DistinctSeq<T(==)>(s: seq<T>)
{
  forall i, j :: 0 <= i < j < |s| ==> s[i] != s[j]
}

// A permutation of a sequence s is a sequence that contains exactly the same
// elements as s, possibly in a different order.
predicate IsPermutation<T(==)>(s: seq<T>, p: seq<T>)
  requires DistinctSeq(s) && DistinctSeq(p)
{
  multiset(s) == multiset(p)
}

// A derangement is a permutation where no element appears in its original position.
predicate IsDerangement<T(==)>(s: seq<T>, d: seq<T>)
  requires DistinctSeq(s) && DistinctSeq(d) && IsPermutation(s, d)
{
  IsPermutation(s, d) &&
  forall i :: 0 <= i < |s| ==> s[i] != d[i]
}

// A sequence with duplicates mapped to new values
predicate SequenceDup<T(==)>(s: seq<T>, newmap: map<nat, T>)
  requires |s| > 0
{
  |newmap| == |s| &&
  forall i :: 0 <= i < |s| ==> i in newmap &&
  (forall i :: 0 <= i < |s| ==> newmap[i] != s[i])
}

/* ==================== HELPER LEMMAS FOR VERIFICATION ==================== */

// Lemma: If two sequences are permutations and one is distinct, so is the other.
lemma PermutationPreservesDistinct<T>(s: seq<T>, p: seq<T>)
  requires DistinctSeq(s) && IsPermutation(s, p)
  ensures DistinctSeq(p)

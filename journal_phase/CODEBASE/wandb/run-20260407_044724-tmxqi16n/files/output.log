  assert A1[3] == 1;   // Was flipped from 0 to 1
  assert A1[2] == 1;   // Was already 1
  assert A1[1] == 1;   // Was flipped from 0 to 1
  assert A1[0] == 1;   // Was flipped from 0 to 1

  // Test case 2: Array with no 1s
  var A2 := new int[3];
  A2[0] := 0;
  A2[1] := 0;
  A2[2] := 0;

  var result2 := FindLast(A2);
  assert result2 == -1; // No 1 found
  assert A2[0] == 1;    // All flipped to 1
  assert A2[1] == 1;
  assert A2[2] == 1;

  // Test case 3: Empty array
  var A3 := new int[0];

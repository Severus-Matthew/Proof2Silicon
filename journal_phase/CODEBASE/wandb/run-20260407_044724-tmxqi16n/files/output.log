      assert |remaining| == 1;
      // We need to ensure this element is not s[i]
      // This is guaranteed by the derangement property and the fact that
      // s[i] hasn't been placed yet (it would violate earlier positions if it had)
      assert remaining[0] != s[i] by {
        // Proof sketch: If remaining[0] == s[i], then s[i] would have been
        // the only element not yet placed, meaning it couldn't have been
        // placed earlier without violating the derangement condition
      }
    }

    // Find an element in remaining that's different from s[i]
    var found := false;
    var chosen := 0;

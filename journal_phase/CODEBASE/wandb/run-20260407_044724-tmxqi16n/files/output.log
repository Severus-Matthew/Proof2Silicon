```dafny
method cumsum(a: array<int>, i: int) returns (b: array<int>)
  requires a != null
  requires 0 <= i <= a.Length
  ensures b != null
  ensures b.Length == a.Length
  ensures forall k :: 0 <= k < i ==> b[k] == sum(a, k)
  ensures forall k :: i <= k < a.Length ==> b[k] == a[k]
{
  b := new int[a.Length];

  // Initialize all elements of b with a's values
  var idx: int := 0;
  while idx < a.Length
    invariant 0 <= idx <= a.Length
    invariant forall k :: 0 <= k < idx ==> b[k] == a[k]
  {
    b[idx] := a[idx];
    idx := idx + 1;
  }

  // If i == 0, we're done (no cumulative sum needed)
  if i == 0 {
    return;
  }

  // Compute cumulative sum for indices 0 to i-1
  var running_sum: int := 0;
  idx := 0;
  while idx < i
    invariant 0 <= idx <= i
    invariant running_sum == sum(a, idx)
    invariant forall k :: 0 <= k < idx ==> b[k] == sum(a, k)
    invariant forall k :: idx <= k < a.Length ==> b[k] == a[k]
  {
    running_sum := running_sum + a[idx];
    b[idx] := running_sum;
    idx := idx + 1;
  }
}


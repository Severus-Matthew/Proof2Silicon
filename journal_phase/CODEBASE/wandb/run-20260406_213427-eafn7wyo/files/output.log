```dafny
method LinearSearch(program: array<int>) returns (i: int, found: bool)
  requires program != null
  ensures found == (exists k :: 0 <= k < program.Length && program[k] == 0)
  ensures found ==> (0 <= i < program.Length && program[i] == 0)
  ensures !found ==> i == program.Length
{
  i := 0;
  found := false;

  while i < program.Length && !found
    invariant 0 <= i <= program.Length
    invariant !found ==> (forall k :: 0 <= k < i ==> program[k] != 0)
    invariant found ==> (0 <= i < program.Length && program[i] == 0)
  {
    if program[i] == 0 {
      found := true;
    } else {
      i := i + 1;
    }
  }

  if !found {
    i := program.Length;
  }
}

method LinearSearchEvenLength(program: array<int>) returns (i: int, found: bool)
  requires program != null
  ensures found == (exists k :: 0 <= k < program.Length && program[k] == 0 && program.Length % 2 == 0)
  ensures found ==> (0 <= i < program.Length && program[i] == 0 && program.Length % 2 == 0)

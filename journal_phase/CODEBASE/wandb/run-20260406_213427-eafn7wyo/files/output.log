```dafny
module Search {
  // Predicate to check if an index is within bounds of a sequence
  predicate inBounds(index: int, sequence: seq<int>) {
    0 <= index < |sequence|
  }

  // Helper function to define search bounds
  function searchBounds(sequence: seq<int>): (int, int)
    ensures 0 <= searchBounds(sequence).0 <= searchBounds(sequence).1 <= |sequence|
  {
    (0, |sequence|)
  }

  // Recursive search method
  method SearchRecursive(sequence: seq<int>, target: int) returns (foundIndex: int)
    requires |sequence| > 0
    ensures -1 <= foundIndex < |sequence|
    ensures foundIndex >= 0 ==> sequence[foundIndex] == target
    ensures foundIndex == -1 ==> forall i :: 0 <= i < |sequence| ==> sequence[i] != target
  {
    foundIndex := SearchRecursiveHelper(sequence, target, 0);
  }

  method SearchRecursiveHelper(sequence: seq<int>, target: int, currentIndex: int) returns (foundIndex: int)
    requires 0 <= currentIndex <= |sequence|
    ensures -1 <= foundIndex < |sequence|
    ensures foundIndex >= 0 ==> sequence[foundIndex] == target
    ensures foundIndex == -1 ==> forall i :: currentIndex <= i < |sequence| ==> sequence[i] != target
    decreases |sequence| - currentIndex
  {
    if currentIndex == |sequence| {
      // Reached end of sequence without finding target
      foundIndex := -1;
    } else if sequence[currentIndex] == target {
      // Found target at current index
      foundIndex := currentIndex;
    } else {
      // Continue searching from next index
      foundIndex := SearchRecursiveHelper(sequence, target, currentIndex + 1);
    }
  }

  // Iterative search method
  method SearchLoop(sequence: seq<int>, target: int) returns (foundIndex: int)
    requires |sequence| > 0
    ensures -1 <= foundIndex < |sequence|
    ensures foundIndex >= 0 ==> sequence[foundIndex] == target
    ensures foundIndex == -1 ==> forall i :: 0 <= i < |sequence| ==> sequence[i] != target
  {
    var index: int := 0;
    foundIndex := -1;

    while index < |sequence|
      invariant 0 <= index <= |sequence|
      invariant foundIndex == -1 ==> forall i :: 0 <= i < index ==> sequence[i] != target
      invariant foundIndex >= 0 ==> sequence[foundIndex] == target && foundIndex < index
    {
      if sequence[index] == target {
        foundIndex := index;
        return;
      }
      index := index + 1;
    }
  }

  // Test method to demonstrate usage
  method TestSearches() {
    var sequence := [5, 7, 5, 9, 2, 4, 1, 6];
    var target := 5;

    var recursiveResult := SearchRecursive(sequence, target);
    var loopResult := SearchLoop(sequence, target);

    // Both methods should find the first occurrence at index 0
    assert recursiveResult == 0;
    assert loopResult == 0;

    // Test with a value not in the sequence
    var notFoundRecursive := SearchRecursive(sequence, 10);
    var notFoundLoop := SearchLoop(sequence, 10);

    assert notFoundRecursive == -1;
    assert notFoundLoop == -1;
  }
}
```

This implementation defines:

1. **Search Bounds**: Both methods search from index 0 to `|sequence| - 1` (the last valid index). The `inBounds` predicate ensures indices stay within `0 <= index < |sequence|`.

2. **SearchRecursive**: Uses recursion to search through the sequence. The helper method decreases the search space with each recursive call (`|sequence| - currentIndex` ensures termination).

3. **SearchLoop**: Uses a while loop to iterate through indices. The loop invariant ensures proper bounds checking and maintains the search state.

4. **Bounds Enforcement**:
   - Both methods have preconditions requiring non-empty sequences
   - Both ensure the returned index is either -1 (not found) or a valid index
   - Loop invariants in `SearchLoop` ensure the index stays within bounds
   - Recursive decreases clause in `SearchRecursiveHelper` ensures termination

5. **Verification**: The code includes assertions in the test method to verify correctness, and all loop invariants and pre/postconditions help the Dafny verifier ensure bounds safety.

The search bounds are logically derived from the sequence length, starting at 0 and going up to (but not including) `|sequence|`. Both methods ensure they never exceed these bounds through proper index checking and loop/recursion termination conditions.

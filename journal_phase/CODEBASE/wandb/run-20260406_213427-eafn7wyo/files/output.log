    invariant 0 <= i <= program.Length
    invariant !found ==> (forall k :: 0 <= k < i ==> (program[k] != 0 || program.Length % 2 != 0))
    invariant found ==> (0 <= i < program.Length && program[i] == 0 && program.Length % 2 == 0)
  {
    if program[i] == 0 && program.Length % 2 == 0 {
      found := true;
    } else {
      i := i + 1;
    }
  }

  if !found {
